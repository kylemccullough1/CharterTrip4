  "games": [
    {
      "id": "jeopardy",
      "name": "Jeopardy",
      "host": "Everyone",
      "when": "Friday night",
      "icon": "microphone",
      "blurb": "The quiz show / game of memes. Five categories of KDPhi and Lambda lore.",
      "scoring": "board",
      "legs": [],
      "rules": [
        "Teams take turns picking a category and a dollar value.",
        "The board shows the answer - respond in the form of a question.",
        "Correct response: the team earns the value. Wrong: the team loses the value and the board opens to a steal.",
        "Values run $400 / $800 / $1200 / $1600 / $2000."
      ]
    },
    {
      "id": "sketch",
      "name": "Police Sketch",
      "host": "Em",
      "when": "Friday night (optional)",
      "icon": "palette",
      "blurb": "Hosts describe a character feature by feature. Each team member draws one piece.",
      "scoring": "rounds",
      "legs": [],
      "rules": [
        "Hosts pick a character and describe features one at a time - never the name.",
        "Each group member draws one piece of the character per description, then rotates the paper.",
        "Hosts each describe a single feature per rotation.",
        "First team to correctly guess the character wins the round."
      ]
    },
    {
      "id": "spelling",
      "name": "Spelling Bee",
      "host": "Kyle",
      "when": "Saturday, first game",
      "icon": "bee",
      "blurb": "One shuffled row, one word each, miss it and you are out. Optionally a drinking game.",
      "rules": [
        "Everyone who joins is shuffled into one row, and you spell in that order.",
        "Miss your word and you are eliminated for the rest of the game.",
        "Every word you spell correctly is 5 points for your team, banked as you go.",
        "The last person standing has to spell their word right to win it.",
        "If they miss, every other team gets its most recently eliminated member back in.",
        "No helping teammates."
      ],
      "scoring": "spelling",
      "legs": []
    },
    {
      "id": "noodlecup",
      "name": "Pool Noodle Cup Game",
      "host": "Jou",
      "when": "Saturday morning",
      "icon": "cup",
      "blurb": "Knock cups off the table with a pool noodle. Cups knocked = points.",
      "scoring": "cups",
      "legs": [],
      "rules": [
        "One person per group goes at a time - four players in play at once.",
        "No ganging up on one person.",
        "Teams of five have to send one person twice.",
        "However many cups you knock out is how many points you earn."
      ]
    },
    {
      "id": "beerrun",
      "name": "Beer Run",
      "host": "Ali",
      "when": "Saturday, before lunch",
      "icon": "beer",
      "blurb": "Collect the beers. Optionally a drinking game.",
      "scoring": "rounds",
      "legs": [],
      "rules": [
        "Teams form a large circle, equidistant from a stack of beers in the center.",
        "One player from each team per round.",
        "Players have to collect 3-4 beers back to their side.",
        "Most beers hauled home wins the round."
      ]
    },
    {
      "id": "relay",
      "name": "Relay Race",
      "host": "Team leads (swapped)",
      "when": "Saturday evening",
