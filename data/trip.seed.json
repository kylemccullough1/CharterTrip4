  "games": [
    {
      "id": "jeopardy",
      "name": "Jeopardy",
      "host": "Everyone",
      "when": "Friday night",
      "icon": "microphone",
      "blurb": "The quiz show / game of memes. Five categories of KDPhi and Lambda lore.",
      "scoring": "board",
      "legs": [],
      "rules": [
        "Teams take turns picking a category and a dollar value.",
        "The board shows the answer - respond in the form of a question.",
        "Correct response: the team earns the value. Wrong: the team loses the value and the board opens to a steal.",
        "Values run $400 / $800 / $1200 / $1600 / $2000."
      ]
    },
    {
      "id": "newlywed",
      "name": "Newlywed Game",
      "host": "Everyone",
      "when": "Friday night",
      "icon": "ring",
      "blurb": "Pairs answer questions about each other. Match = points.",
      "scoring": "newlywed",
      "legs": [],
      "rules": [
        "Split into pairs. One partner writes their answer down while the other is out of earshot.",
        "Bring the partner back, ask the same question out loud.",
        "A match is worth points for their team. Add your own bonus for a truly unhinged answer."
      ]
    },
    {
      "id": "sketch",
      "name": "Police Sketch",
      "host": "Em",
      "when": "Friday night (optional)",
      "icon": "palette",
      "blurb": "Hosts describe a character feature by feature. Each team member draws one piece.",
      "scoring": "rounds",
      "legs": [],
      "rules": [
        "Hosts pick a character and describe features one at a time - never the name.",
        "Each group member draws one piece of the character per description, then rotates the paper.",
        "Hosts each describe a single feature per rotation.",
        "First team to correctly guess the character wins the round."
      ]
    },
    {
      "id": "spelling",
      "name": "Spelling Bee",
      "host": "Kyle",
      "when": "Saturday, first game",
      "icon": "bee",
      "blurb": "Alternating elimination spelling. Optionally a drinking game.",
      "scoring": "spelling",
      "legs": [],
      "rules": [
        "Players spell one word at a time in alternating order across teams.",
        "Miss a word and you are out.",
        "The final person standing has to get their word right - otherwise the last eliminated member from each team hops back in.",
        "The last person standing wins the game for their team.",
        "No helping teammates."
      ]
    },
    {
      "id": "noodlecup",
      "name": "Pool Noodle Cup Game",
      "host": "Jou",
      "when": "Saturday morning",
      "icon": "cup",
      "blurb": "Knock cups off the table with a pool noodle. Cups knocked = points.",
      "scoring": "cups",
      "legs": [],
      "rules": [
        "One person per group goes at a time - four players in play at once.",
        "No ganging up on one person.",
        "Teams of five have to send one person twice.",
        "However many cups you knock out is how many points you earn."
      ]
    },
    {
      "id": "beerrun",
      "name": "Beer Run",
      "host": "Ali",
      "when": "Saturday, before lunch",
      "icon": "beer",
      "blurb": "Collect the beers. Optionally a drinking game.",
      "scoring": "rounds",
      "legs": [],
      "rules": [
        "Teams form a large circle, equidistant from a stack of beers in the center.",
        "One player from each team per round.",
        "Players have to collect 3-4 beers back to their side.",
        "Most beers hauled home wins the round."
      ]
    },
    {
      "id": "relay",
      "name": "Relay Race",
      "host": "Team leads (swapped)",
      "when": "Saturday evening",
      "icon": "flag",
      "blurb": "Outside, multi-leg relay. Each team leader facilitates a different team.",
      "scoring": "relay",
      "legs": [
        "Pool noodle jump rope race (three-person leg)",
        "Flip cup",
        "Food race (crackers / biscuits)",
        "Mini beer pong (1 cup - you make it, you drink it)",
        "High low",
        "Spin and carry an egg / golf ball with chopsticks"
      ],
      "rules": [
        "All outside. Each team leader runs a leg for a team that is not their own.",
        "Legs run back to back - finish yours before the next person starts.",
        "Points awarded by finishing position for each leg."
      ]
    },
    {
      "id": "superlatives",
