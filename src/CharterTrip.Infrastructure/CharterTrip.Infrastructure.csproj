<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CharterTrip.Core\CharterTrip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\trip.seed.json"
                      Link="Seed\trip.seed.json"
                      LogicalName="CharterTrip.Infrastructure.Seed.trip.seed.json" />
  </ItemGroup>

  <!-- The Braun Manor story, embedded for the same reason as the seed: if the app is running, the
       content is there. This is the starting point rather than the live copy — StoryLoader copies it
       into trip.json once, and from then on it is edited on the site. Listed one by one rather than by
       wildcard so a file dropped into data/braun-manor/ does not silently become a runtime dependency;
       the design documents beside these are for whoever is writing the story, not for the app. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\braun-manor\characters.json"
                      Link="Mystery\BraunManor\characters.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.characters.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\zones.json"
                      Link="Mystery\BraunManor\zones.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.zones.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\factions.json"
                      Link="Mystery\BraunManor\factions.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.factions.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\clues.json"
                      Link="Mystery\BraunManor\clues.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.clues.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\slides.json"
                      Link="Mystery\BraunManor\slides.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.slides.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\objectives.json"
                      Link="Mystery\BraunManor\objectives.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.objectives.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\beefs.json"
                      Link="Mystery\BraunManor\beefs.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.beefs.json" />
    <EmbeddedResource Include="..\..\data\braun-manor\beats.json"
                      Link="Mystery\BraunManor\beats.json"
                      LogicalName="CharterTrip.Infrastructure.Mystery.BraunManor.beats.json" />
  </ItemGroup>

</Project>
