@using CharterTrip.Core
@* The committee's view: every section, everything editable. In showcase mode it is still every
   section and still everything editable — the only difference is where the edits go. *@

<div class="shell shell-admin">
    <NavMenu Admin="true" />

    <main id="main" class="main">
        @ChildContent
    </main>

    <SiteFooter>
        <span class="chip tiny ok">Admin mode</span>
        @if (SiteMode.ReadOnly)
        {
            <span class="muted tiny">You can edit anything on the site. Nothing is saved.</span>
        }
        else
        {
            <span class="muted tiny">You can edit anything on the site.</span>
        }
        <a class="btn btn-ghost btn-xs" href="/logout">Sign out</a>
    </SiteFooter>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
