@inherits LayoutComponentBase
@inject ICurrentUser CurrentUser

@*
    Blazor's @layout attribute is fixed per page, so choosing a shell is done here instead:
    resolve who is looking, then render the chrome that suits them. Admin and member get
    genuinely different navigation and different affordances, not the same page with things
    greyed out.
*@

@* Nothing renders until we know who this is.

   The cascade is IsFixed, which is what makes it cheap — but a fixed value is captured on the
   first render and never looked at again. Rendering the shell before the identity resolves would
   pin "Guest" into every component on the page and quietly leave the committee read-only. One
   empty render is the price of that being impossible. *@
@if (_permissions is not null)
{
    <CascadingValue Value="_permissions" IsFixed="true">
        @if (_permissions.IsAdmin)
        {
            <AdminShell>@Body</AdminShell>
        }
        else
        {
            <MemberShell>@Body</MemberShell>
        }
        <ToastHost />
    </CascadingValue>
}

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private TripPermissions? _permissions;

    protected override async Task OnInitializedAsync() => _permissions = await CurrentUser.GetAsync();
}
