@* Everyone else's view: the parts of the weekend that concern them, read-only. *@

<div class="shell shell-member">
    <NavMenu Admin="false" />

    <main id="main" class="main">
        @ChildContent
    </main>

    <SiteFooter>
        <span class="muted tiny">Spotted something wrong? Tell Jou, Ali, Kyle or Em.</span>
        @* Small and last. The committee knows it is here; nobody else needs to wonder about it. *@
        <a class="btn btn-ghost btn-xs" href="/login">Committee sign in</a>
    </SiteFooter>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
