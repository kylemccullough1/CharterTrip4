@* Everyone else's view: the parts of the weekend that concern them, read-only. *@

<div class="shell shell-member">
    <NavMenu Admin="false" />

    <main id="main" class="main">
        @ChildContent
    </main>

    <SiteFooter>
        @* Small and last, and now on its own — .footer-status centres what it holds, so with
           nothing beside it the link sits in the middle of the footer. *@
        <a class="btn btn-ghost btn-xs" href="/login">Committee sign in</a>
    </SiteFooter>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
