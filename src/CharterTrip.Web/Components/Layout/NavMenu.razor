@implements IDisposable
@inject NavigationManager Nav

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 100 100">
                    <path d="M50 8 L78 50 L50 92 L22 50 Z" fill="none" stroke="currentColor" stroke-width="5" />
                    <path d="M50 28 L64 50 L50 72 L36 50 Z" fill="currentColor" />
                </svg>
            </span>
            <span class="brand-text">
                <b>Charter Trip</b>
                <i>4th Annual · 2026</i>
            </span>
        </a>

        <button class="nav-toggle"
                aria-expanded="@(_open ? "true" : "false")"
                aria-controls="mainnav"
                aria-label="Toggle navigation"
                @onclick="() => _open = !_open">
            <span></span><span></span><span></span>
        </button>

        <nav id="mainnav" class="mainnav @(_open ? "open" : null)" aria-label="Main">
            @foreach (var entry in _entries)
            {
                if (!entry.HasChildren)
                {
                    <a class="navlink @On(entry.Href)" href="@entry.LinkHref" @onclick="() => Close(entry.LinkHref)">
                        @entry.Label
                    </a>
                }
                else
                {
                    <div class="dropdown">
                        @* The parent is a link, not a bare label. Itinerary and Games are both
                           real pages, and a menu that lists their sections should not take away
                           the way in to the page itself. Being an anchor also keeps the menu
                           reachable by keyboard, which is what :focus-within opens on. *@
                        <a class="navlink has-kids @On(entry.Href)" href="@entry.LinkHref"
                           aria-haspopup="true" @onclick="() => Close(entry.LinkHref)">
                            @entry.Label<span class="caret">▾</span>
                        </a>
                        <div class="dropdown-menu">
                            @foreach (var child in entry.Children!)
                            {
                                <a class="dropdown-item @On(child.Href, exact: true)" href="@child.LinkHref" @onclick="() => Close(child.LinkHref)">
                                    @child.Label
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </nav>

        @if (Admin)
        {
            <span class="admin-band" title="You are signed in as a committee member">ADMIN</span>
        }
    </div>
</header>

@code {
    [CascadingParameter] private TripPermissions Permissions { get; set; } = new(false, "Guest");

    [Parameter] public bool Admin { get; set; }

    private bool _open;
    private IReadOnlyList<NavEntry> _entries = [];

    protected override void OnInitialized()
    {
        _entries = NavTree.For(Permissions);
        Nav.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// Where the last click in this menu is taking us, when the router will not say so itself.
    ///
    /// A move that only changes the fragment — #guide to #packing — is handled by Blazor as the
    /// browser's own business: it pushes the address and scrolls to the card, then returns
    /// without notifying .NET and without raising any DOM event either. So there is nothing to
    /// listen for, and <c>Nav.Uri</c> goes on reporting the address we were at before. The click
    /// knew the answer all along, so it is kept here until the router says otherwise.
    /// </summary>
    private string? _goingTo;

    /// <summary>
    /// The highlight class, which is <c>on</c> — what the stylesheet has always styled. NavLink
    /// writes <c>active</c>, which nothing in app.css matches, so plain anchors and this do the
    /// job NavLink was silently failing at. <see cref="NavTree.IsCurrent"/> owns the rule.
    /// </summary>
    /// <param name="exact">
    /// True for an entry inside a dropdown, which is lit only where it actually is. See
    /// <see cref="NavTree.IsCurrent"/> — the branch covers its children, the children do not
    /// cover each other.
    /// </param>
    private string? On(string href, bool exact = false) =>
        NavTree.IsCurrent(href, _goingTo ?? Nav.ToBaseRelativePath(Nav.Uri), exact) ? "on" : null;

    private void Close(string? goingTo = null)
    {
        _open = false;
        _goingTo = goingTo;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Redrawn on every move, not only to shut the panel: the highlight is computed from the
        // current address now, so it goes stale if the menu does not follow along. The router
        // has spoken here, so its address wins over whatever the last click was aiming at.
        _open = false;
        _goingTo = null;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
