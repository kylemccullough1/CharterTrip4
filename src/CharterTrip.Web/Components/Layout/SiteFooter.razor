@inject ITripStore Store

<footer class="footer">
    <div class="footer-inner">
        <div class="deco-rule" aria-hidden="true"></div>
        <p><b>@Store.Current.Trip.Venue</b> · @Store.Current.Trip.City · @Store.Current.Trip.Dates</p>
        <p class="muted">
            Planned by <b>JAKE</b> — @string.Join(" · ", Store.Current.Trip.Committee).
            Payments to Kyle: <code>@Store.Current.Trip.Venmo</code>
        </p>
        <p class="footer-status">@ChildContent</p>
    </div>
</footer>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
