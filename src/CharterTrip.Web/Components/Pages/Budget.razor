@page "/budget"
@using CharterTrip.Core.Services
@inherits TripAwareComponent
@inject CharterTrip.Web.Services.ToastService Toasts

<PageTitle>Budget · Charter Trip 2026</PageTitle>

<AdminOnly>
<div class="page">

    <SectionCard Title="Budget" Subtitle="@SubtitleText">
        <Actions>
            @if (CanEdit)
            {
                <button class="btn btn-ghost btn-sm" @onclick="() => AddLineAsync(null)">+ Line</button>
            }
        </Actions>

        <ChildContent>
            @{ var s = Summary; }

            <div class="budget-tiles">
                <div class="budget-tile">
                    <span class="bt-label">Planned spend</span>
                    <strong class="bt-value">@Money.Format(s.Total)</strong>
                    <span class="bt-note">@Trip.Budget.Count lines</span>
                </div>

                <div class="budget-tile">
                    <span class="bt-label">Cost per person</span>
                    <strong class="bt-value">@Money.Format(s.PerPerson)</strong>
                    <span class="bt-note">@s.Total.ToString("C2") ÷ @s.Headcount people</span>
                </div>

                <div class="budget-tile">
                    <span class="bt-label">Charged per person</span>
                    <strong class="bt-value">@Money.Format(s.ChargedPerPerson)</strong>
                    <span class="bt-note">@Money.Format(s.ChargedTotal) in total</span>
                </div>

                <div class="budget-tile @(s.Variance < 0 ? "is-bad" : "is-good")">
                    <span class="bt-label">@(s.Variance < 0 ? "Short by" : "Headroom")</span>
                    <strong class="bt-value">@Money.Format(Math.Abs(s.Variance))</strong>
                    <span class="bt-note">
                        @(s.Variance < 0
                            ? "the plan costs more than you are charging"
                            : "charged minus planned")
                    </span>
                </div>

                <div class="budget-tile">
                    <span class="bt-label">Collected</span>
                    <strong class="bt-value">@Money.Format(s.Collected)</strong>
                    <span class="bt-note">@s.PaidCount of @s.Headcount paid · @Money.Format(s.Outstanding) outstanding</span>
                </div>
            </div>

            @foreach (var category in Categories)
            {
                <div class="budget-group" @key="category.Name">
                    <header class="budget-group-head">
                        <h3>@category.Name</h3>
                        <div class="bg-bar" title="@category.ShareOfTotal% of the budget">
                            <span style="width:@Pct(category.ShareOfTotal)"></span>
                        </div>
                        <strong>@Money.Format(category.Subtotal)</strong>
                        <span class="muted tiny">@category.ShareOfTotal%</span>
                    </header>

                    <div class="table-wrap">
                        <table class="budget-table">
                            <thead>
                                <tr>
                                    <th class="col-item">Item</th>
                                    <th class="col-store">Store</th>
                                    <th class="col-num">Unit</th>
                                    <th class="col-num">Qty</th>
                                    <th class="col-num">Total</th>
                                    @if (CanEdit) { <th class="col-act"></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in category.Lines)
                                {
                                    <tr @key="line.Id">
                                        <td class="col-item">
                                            <input class="cell" @key="@($"i{line.Id}-{_resync}")" value="@line.Item" aria-label="Item"
                                                   readonly="@(!CanEdit)"
                                                   @onchange="e => SetItemAsync(line.Id, e.Value?.ToString())" />
                                        </td>
                                        <td class="col-store">
                                            <input class="cell dim" @key="@($"s{line.Id}-{_resync}")" value="@line.Store" aria-label="Store" placeholder="—"
                                                   readonly="@(!CanEdit)"
                                                   @onchange="e => SetStoreAsync(line.Id, e.Value?.ToString())" />
                                        </td>
                                        <td class="col-num">
                                            <input class="cell num" inputmode="decimal" aria-label="Unit price"
                                                   @key="@($"u{line.Id}-{_resync}")" value="@Money.Plain(line.Unit)" readonly="@(!CanEdit)"
                                                   @onchange="e => SetUnitAsync(line.Id, e.Value?.ToString())" />
                                        </td>
                                        <td class="col-num">
                                            <input class="cell num" inputmode="decimal" aria-label="Quantity"
                                                   @key="@($"q{line.Id}-{_resync}")" value="@Money.Plain(line.Qty)" readonly="@(!CanEdit)"
                                                   @onchange="e => SetQtyAsync(line.Id, e.Value?.ToString())" />
                                        </td>
                                        <td class="col-num line-total">@Money.Format(line.Total)</td>
                                        @if (CanEdit)
                                        {
                                            <td class="col-act">
                                                <button class="mini-btn btn-danger-ghost" title="Delete this line"
                                                        @onclick="() => ConfirmDeleteAsync(line)">✕</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="@(CanEdit ? 4 : 4)" class="foot-label">
                                        @if (CanEdit)
                                        {
                                            <button class="btn btn-ghost btn-xs"
                                                    @onclick="() => AddLineAsync(category.Name)">+ Add to @category.Name</button>
                                        }
                                    </td>
                                    <td class="col-num"><strong>@Money.Format(category.Subtotal)</strong></td>
                                    @if (CanEdit) { <td></td> }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }

            <div class="budget-grand">
                <span>Total planned</span>
                <strong>@Money.Format(s.Total)</strong>
            </div>
        </ChildContent>
    </SectionCard>

    <ConfirmDialog @ref="_confirm" />
</div>
</AdminOnly>

@code {
    protected override TripArea Watching => TripArea.Budget;

    private ConfirmDialog? _confirm;

    private BudgetSummary Summary => BudgetService.Summarize(Trip);
    private IReadOnlyList<BudgetCategory> Categories => BudgetService.ByCategory(Trip);

    private string SubtitleText => CanEdit
        ? "Edit any cell and the totals follow. Line totals are unit × quantity."
        : "What the weekend costs and where it goes.";

    private static string Pct(decimal value) =>
        $"{Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    // ------------------------------------------------------------------ edits
    // A budget is a spreadsheet, so the cells behave like one: each commits on blur or Enter
    // rather than collecting into a form. A bad value falls back to what was there before
    // instead of silently becoming zero.

    /// <summary>
    /// Bumped whatever the cell ends up showing differs from what was typed — a rejected number,
    /// or text that got trimmed. The inputs are keyed on it, so Blazor rebuilds them with the
    /// stored value. Without this the box keeps displaying "banana" while the data holds 0.46,
    /// because Blazor diffs its own last render rather than the DOM and sees no change to make.
    /// </summary>
    private int _resync;

    private void ResyncIfDisplayDiffers(string? typed, string stored)
    {
        if (!string.Equals(typed?.Trim() ?? string.Empty, stored, StringComparison.Ordinal)) _resync++;
    }

    private Task SetItemAsync(string id, string? value)
    {
        var text = value?.Trim() ?? string.Empty;
        if (text.Length == 0)
        {
            _resync++;                      // an empty name is a slip, not an intention
            return Task.CompletedTask;
        }

        ResyncIfDisplayDiffers(value, text);
        return MutateAsync(t => BudgetService.Update(t, id, l => l.Item = text));
    }

    private Task SetStoreAsync(string id, string? value)
    {
        var text = value?.Trim() ?? string.Empty;
        ResyncIfDisplayDiffers(value, text);
        return MutateAsync(t => BudgetService.Update(t, id, l => l.Store = text));
    }

    private Task SetUnitAsync(string id, string? value) => SetNumberAsync(value, id, (l, v) => l.Unit = v, l => l.Unit);

    private Task SetQtyAsync(string id, string? value) => SetNumberAsync(value, id, (l, v) => l.Qty = v, l => l.Qty);

    private Task SetNumberAsync(string? value, string id, Action<BudgetLine, decimal> set, Func<BudgetLine, decimal> get)
    {
        var line = BudgetService.Find(Trip, id);
        if (line is null) return Task.CompletedTask;

        if (!Money.TryParse(value, out var parsed) || parsed < 0)
        {
            _resync++;                      // keep the old number and put it back on screen
            return Task.CompletedTask;
        }

        ResyncIfDisplayDiffers(value, Money.Plain(parsed));
        return get(line) == parsed
            ? Task.CompletedTask
            : MutateAsync(t => BudgetService.Update(t, id, l => set(l, parsed)));
    }

    private async Task AddLineAsync(string? category)
    {
        await MutateAsync(t => BudgetService.AddLine(t, category ?? "Food"));
        Toasts.Show("Line added", CharterTrip.Web.Services.ToastKind.Good);
    }

    private Task ConfirmDeleteAsync(BudgetLine line)
    {
        _confirm?.Show(
            $"Delete “{(string.IsNullOrWhiteSpace(line.Item) ? "this line" : line.Item)}” ({Money.Format(line.Total)})?",
            () => MutateAsync(t => BudgetService.RemoveLine(t, line.Id)),
            "Delete");

        return Task.CompletedTask;
    }
}
