@page "/buzz"
@page "/buzz/{Code}"
@using CharterTrip.Core.Services
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@layout CharterTrip.Web.Components.Layout.BareLayout

<PageTitle>Buzzer · Charter Trip</PageTitle>

<div class="buzz-root">

@if (string.IsNullOrWhiteSpace(Code) || (TeamId is null && !IsHost))
{
    <div class="buzz-enter">
        <h1>Buzzer</h1>
        <p class="muted">Type the code from the screen.</p>
        <input class="buzz-code-input" inputmode="latin" autocapitalize="characters" maxlength="4"
               placeholder="CODE" value="@_typed"
               @oninput="e => _typed = (e.Value?.ToString() ?? string.Empty).ToUpperInvariant()"
               @onkeydown="OnKey" />
        <button class="btn btn-gold btn-lg btn-block" @onclick="Go">Connect</button>
        @if (!string.IsNullOrWhiteSpace(Code))
        {
            <p class="buzz-bad">That code isn't live. The host may have reset the game.</p>
        }
    </div>
}
else if (IsHost)
{
    <div class="buzz-host">
        <header>
            <span class="buzz-role">Host</span>
            <span class="muted tiny">@PhaseLabel</span>
        </header>

        @* The answer lives here and nowhere else. The big screen is pointed at the room, so
           everything that would spoil a clue — the response, and the Correct/Wrong call — is on
           this phone only. *@
        @if (InPlay is { } clue)
        {
            <p class="buzz-cat">@ClueHead(clue)</p>
            @if (!string.IsNullOrWhiteSpace(clue.Clue)) { <p class="buzz-clue">@clue.Clue</p> }
            <p class="buzz-answer-label">Answer</p>
            <p class="buzz-answer">@clue.Response</p>
            @if (!string.IsNullOrWhiteSpace(clue.ResponseImage))
            {
                <MediaView Src="@clue.ResponseImage" CssClass="buzz-answer-img" />
            }

            @if (Game.Phase == JeopardyPhase.Revealed)
            {
                <p class="buzz-buzzed">
                    @(Game.RevealedWinnerTeamId is { } w ? $"{TeamName(w)} got it" : "Nobody got it")
                </p>
                <button class="btn btn-gold btn-lg btn-block" @onclick="ContinueAsync">
                    @(clue.IsFinal ? "See who won" : "Next clue")
                </button>
            }
            else if (Game.Phase == JeopardyPhase.Judging)
            {
                <p class="buzz-buzzed">@TeamName(Game.LeadingBuzzTeamId) buzzed</p>
                <div class="buzz-judge">
                    <button class="btn btn-lg jeo-right" @onclick="CorrectAsync">Correct</button>
                    <button class="btn btn-lg jeo-wrong" @onclick="WrongAsync">Wrong</button>
                </div>
            }
            else
            {
                <p class="muted tiny">Waiting for a buzz…</p>
                <button class="btn btn-ghost btn-block" @onclick="NobodyAsync">Nobody got it</button>
            }
        }
        else if (Game.Phase == JeopardyPhase.FinalIntro)
        {
            <p class="buzz-cat">Final Jeopardy</p>
            <p class="buzz-clue">@Board.Final.Clue</p>
            <p class="buzz-answer-label">Answer</p>
            <p class="buzz-answer">@(string.IsNullOrWhiteSpace(Board.Final.Response) ? "— not written yet —" : Board.Final.Response)</p>
            <button class="btn btn-gold btn-lg btn-block" @onclick="StartFinalAsync">Show the final clue</button>
        }
        else
        {
            <p class="muted">No clue on screen. The answer appears here as soon as one is picked.</p>
        }
    </div>
}
else
{
    <div class="buzz-team" style="--team:@TeamColor">
        <header>
            <span class="buzz-role">@TeamName(TeamId)</span>
            <span class="buzz-score">@JeopardyService.ScoreFor(Trip, TeamId!)</span>
        </header>

        @* It is this team's turn to choose, so the board comes to them. Picking used to mean
           somebody walking to the laptop, which is slow and hands the remote to whoever is
           standing nearest rather than to whoever won it. *@
        @if (MyPick)
        {
            <p class="buzz-cat">Your pick</p>
            <div class="buzz-board">
                @foreach (var category in Board.Categories)
                {
                    <div class="buzz-board-col">
                        <span class="buzz-board-cat">@category.Name</span>
                        @foreach (var clue in category.Clues)
                        {
                            var used = JeopardyService.IsUsed(Trip, clue.Id);
                            <button class="buzz-board-cell @(used || clue.IsEmpty ? "is-used" : null)"
                                    disabled="@(used || clue.IsEmpty)"
                                    @onclick="() => PickAsync(clue.Id)">
                                @(used || clue.IsEmpty ? "·" : clue.Value.ToString())
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <button class="buzz-button @BuzzClass" disabled="@(!CanBuzz)" @onclick="BuzzAsync">
                @BuzzLabel
            </button>
            <p class="buzz-status">@StatusLine</p>

            @* A place to work the final out together before ringing in. Deliberately local to
               this phone: nothing is sent, nothing is stored, and the host never sees it. The
               final is answered out loud like every other clue. *@
            @if (FinalInPlay)
            {
                <textarea class="buzz-final-input" rows="4"
                          placeholder="Notepad — work it out with your team, then buzz…"
                          @bind="_notepad" @bind:event="oninput"></textarea>
                <p class="muted tiny">Just for you — this stays on your phone.</p>
            }
        }
    </div>
}

</div>

@code {
    [Parameter] public string? Code { get; set; }

    protected override TripArea Watching => TripArea.All;

    private string _typed = "";

    /// <summary>The final's scratchpad. Never left this browser, by design.</summary>
    private string _notepad = "";

    private IJSObjectReference? _audio;

    private JeopardyBoard Board => Trip.Jeopardy;
    private JeopardyGame Game => Trip.Jeopardy.Game;

    private string? TeamId => Code is null ? null : JeopardyService.TeamForCode(Trip, Code);
    private bool IsHost => Code is not null && JeopardyService.IsHostCode(Trip, Code);

    private ClueInPlay? InPlay => JeopardyService.InPlay(Trip);

    /// <summary>This team won the pick and the board is waiting on them.</summary>
    private bool MyPick =>
        TeamId is not null
        && Game.Phase == JeopardyPhase.Board
        && !Game.BuzzersOpen
        && Game.PickingTeamId == TeamId;

    private bool FinalInPlay => Game.Phase == JeopardyPhase.Final || InPlay is { IsFinal: true };

    /// <summary>Matches the board's heading, so the host's phone and the wall agree.</summary>
    private static string ClueHead(ClueInPlay clue)
    {
        var category = clue.Category.Trim();

        if (!clue.IsFinal)
            return $"{category} · {clue.Value}";

        return category.Length == 0 || category.Contains("final", StringComparison.OrdinalIgnoreCase)
            ? $"Final Jeopardy · {clue.Value}"
            : $"Final Jeopardy · {category} · {clue.Value}";
    }

    private string TeamName(string? id) => Trip.Teams.FirstOrDefault(t => t.Id == id)?.Name ?? "—";
    private string TeamColor => Trip.Teams.FirstOrDefault(t => t.Id == TeamId)?.Color ?? "#d4af37";

    private bool LockedOut => TeamId is not null && Game.LockedOutTeamIds.Contains(TeamId);
    private bool AlreadyBuzzed => TeamId is not null && Game.Buzzes.Any(b => b.TeamId == TeamId);
    private bool CanBuzz => Game.BuzzersOpen && !LockedOut && !AlreadyBuzzed;

    private string PhaseLabel => Game.Phase switch
    {
        JeopardyPhase.NotStarted => "not started",
        JeopardyPhase.Board => Game.BuzzersOpen ? "buzz-off" : "picking",
        JeopardyPhase.Clue => Game.BuzzersOpen ? "buzzers open" : "reading the clue",
        JeopardyPhase.Judging => "your call",
        JeopardyPhase.Revealed => "answer up",
        JeopardyPhase.FinalIntro => "final titles",
        JeopardyPhase.Final => Game.BuzzersOpen ? "final — buzzers open" : "final — reading the clue",
        _ => "finished"
    };

    private string BuzzLabel => LockedOut ? "OUT" : AlreadyBuzzed ? "IN" : Game.BuzzersOpen ? "BUZZ" : "WAIT";

    private string BuzzClass =>
        LockedOut ? "is-out" : AlreadyBuzzed ? "is-in" : Game.BuzzersOpen ? "is-live" : "is-idle";

    private string StatusLine
    {
        get
        {
            if (LockedOut) return "Wrong answer — you're out of this clue.";
            if (AlreadyBuzzed) return Game.LeadingBuzzTeamId == TeamId ? "You're in! Answer it." : "Someone beat you to it.";
            if (Game.Phase == JeopardyPhase.Board && Game.BuzzersOpen) return "Buzz to win the first pick.";
            if (Game.Phase == JeopardyPhase.FinalIntro) return "Final Jeopardy is next.";
            if (FinalInPlay && Game.BuzzersOpen) return "Final Jeopardy — buzz when your team has it.";
            if (Game.BuzzersOpen) return "Buzzers are open.";
            if (Game.Phase is JeopardyPhase.Clue or JeopardyPhase.Final) return "Get ready — buzzers open in a moment.";
            if (Game.Phase == JeopardyPhase.Judging) return $"{TeamName(Game.LeadingBuzzTeamId)} is answering.";
            if (Game.Phase == JeopardyPhase.Revealed) return "Answer's up on the screen.";
            if (Game.Phase == JeopardyPhase.Board) return $"{TeamName(Game.PickingTeamId)} is picking.";
            return "Wait for the next clue.";
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Go();
    }

    private void Go()
    {
        if (_typed.Trim().Length > 0) Code = _typed.Trim();
    }

    private async Task BuzzAsync()
    {
        // The phone is the buzzer, so it should sound like one. Fired before the mutation and
        // not off any server state: the point is that the thumb gets an answer instantly, even
        // if the buzz turns out to be second and changes nothing at all.
        await Cue("buzz");
        await MutateAsync(t => JeopardyService.Buzz(t, TeamId!, DateTimeOffset.UtcNow));
    }

    private async Task PickAsync(string clueId)
    {
        await Cue("pick");
        await MutateAsync(t => JeopardyService.PickClue(t, clueId));
        ScheduleBuzzersOpen(clueId);
    }

    /// <summary>
    /// Opens the buzzers after the room's had a moment to read the clue. Runs detached from this
    /// circuit on purpose — the buzzers open on schedule even if whoever picked navigates away.
    /// </summary>
    private void ScheduleBuzzersOpen(string clueId) => _ = Task.Run(async () =>
    {
        await Task.Delay(JeopardyService.ClueReadDelay);
        await Store.MutateAsync(t => JeopardyService.OpenBuzzers(t, clueId, DateTimeOffset.UtcNow), Watching);
    });

    /// <summary>
    /// One sound on this phone.
    ///
    /// The module is loaded on the first cue rather than up front, because a browser will not
    /// make noise until the page has been touched — and on this page the first touch is always
    /// the button that wants the sound.
    /// </summary>
    private async Task Cue(string name)
    {
        try
        {
            _audio ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/jeopardy-audio.js");
            await _audio.InvokeVoidAsync("unlock");
            await _audio.InvokeVoidAsync(name);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* no audio on this device; the buzz still counts */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_audio is not null)
        {
            try { await _audio.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _audio.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        Dispose();
    }

    private Task CorrectAsync() => MutateAsync(t => JeopardyService.JudgeCorrect(t, DateTimeOffset.UtcNow));
    private Task WrongAsync() => MutateAsync(t => JeopardyService.JudgeWrong(t, DateTimeOffset.UtcNow));
    private Task NobodyAsync() => MutateAsync(JeopardyService.NobodyGotIt);
    private Task ContinueAsync() => MutateAsync(JeopardyService.Continue);

    private async Task StartFinalAsync()
    {
        await MutateAsync(t => JeopardyService.StartFinal(t));
        ScheduleBuzzersOpen(JeopardyService.FinalClueId);
    }
}
