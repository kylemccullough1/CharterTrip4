@page "/games"
@page "/games/{GameId}"
@inherits TripAwareComponent
@using CharterTrip.Web.Services
@inject ToastService Toasts

<PageTitle>@(Game?.Name ?? "Games") · Charter Trip 2026</PageTitle>

@* The games and the roster are the committee's working area, not part of what a
   guest came here for. AdminOnly guards the page itself, so typing the URL lands
   on the same polite refusal as following a link that is not in their menu. *@
<AdminOnly>
<div class="page">
    @if (Game is null)
    {
        @if (GameId is not null)
        {
            <SectionCard Title="Unknown game" Subtitle="@($"There is no game called “{GameId}”.")">
                <a class="btn btn-gold btn-sm" href="/games">See all games</a>
            </SectionCard>
        }

        <SectionCard Title="Games"
                     Subtitle="@($"{Trip.Games.Count + 1} events across the weekend. Rules are live; scoring arrives in phase 4.")">
            <div class="game-grid">
                @foreach (var game in Trip.Games)
                {
                    <a class="game-card" href="@($"/games/{game.Id}")" @key="game.Id">
                        <h3>@game.Name</h3>
                        <p class="game-card-when">@game.When · @game.Host</p>
                        <p class="game-card-blurb">@game.Blurb</p>
                        <p class="muted tiny">@game.Rules.Count rules</p>
                    </a>
                }
                <a class="game-card game-card-alt" href="/games/mystery">
                    <h3>Murder at Braun Manor</h3>
                    <p class="game-card-when">Saturday 8:00 PM · everyone</p>
                    <p class="game-card-blurb">21 characters, three killers, six factions. Three trials to find them.</p>
                    <p class="muted tiny">Full host kit →</p>
                </a>
            </div>
        </SectionCard>

        @* One button for what used to be three, on three screens, one of which nobody knew was
           there. It is here rather than on a game's own page because the thing it is for is
           starting the whole weekend over — after a Friday rehearsal, or after a run-through that
           got far enough to be worth clearing properly. *@
        <SectionCard Title="Start over"
                     Subtitle="Everything the games have recorded, cleared in one go.">
            <div class="card reset-card">
                @if (WhatWouldGo.Count == 0)
                {
                    <p class="muted">Nothing has been played yet. There is nothing to clear.</p>
                }
                else
                {
                    @* Said out loud before it is done. One press stands between this and a
                       weekend of scores, and "are you sure?" is not the same as knowing. *@
                    <ul class="rules">
                        @foreach (var line in WhatWouldGo)
                        {
                            <li @key="line">@line</li>
                        }
                    </ul>
                }

                <p class="muted tiny">
                    Written content is never touched — the Jeopardy board's clues and the murder
                    mystery's characters, rooms and prose all survive this. Only a night of playing
                    them goes.
                </p>

                <button class="btn btn-danger btn-sm" disabled="@(WhatWouldGo.Count == 0)"
                        @onclick="ConfirmReset">
                    Reset every game
                </button>
            </div>
        </SectionCard>

        <ConfirmDialog @ref="_confirm" />
    }
    else
    {
        <div class="game-head">
            <div class="grow">
                <h1 class="game-title">@Game.Name</h1>
                <p class="game-meta"><b>@Game.When</b> · hosted by <b>@Game.Host</b></p>
                <p class="game-blurb">@Game.Blurb</p>
            </div>
            <a class="btn btn-ghost btn-sm" href="/games">← All games</a>
        </div>

        <SectionCard Title="Rules">
            <div class="card rules-card">
                <ul class="rules">
                    @foreach (var rule in Game.Rules)
                    {
                        <li>@rule</li>
                    }
                </ul>
                @if (Game.Legs.Count > 0)
                {
                    <h4 class="mt">Legs</h4>
                    <ol class="rules">
                        @foreach (var leg in Game.Legs)
                        {
                            <li>@leg</li>
                        }
                    </ol>
                }
            </div>
        </SectionCard>

        <SectionCard Title="Scoring">
            <div class="card coming-soon">
                <p class="coming-badge">Phase 4</p>
                <p>
                    Live scoring for this game lands with the rest of the games work.
                    @if (Game.Id == "jeopardy")
                    {
                        <text>
                            The full board — 25 clues, both image clues, and phone buzzers — is already
                            seeded in <code>trip.json</code> and just needs its screen.
                        </text>
                    }
                </p>
            </div>
        </SectionCard>
    }
</div>
</AdminOnly>

@code {
    protected override TripArea Watching => TripArea.Games;

    [Parameter] public string? GameId { get; set; }

    private Game? Game => GameId is null
        ? null
        : Trip.Games.FirstOrDefault(g => string.Equals(g.Id, GameId, StringComparison.OrdinalIgnoreCase));

    private ConfirmDialog? _confirm;

    private IReadOnlyList<string> WhatWouldGo => GameReset.WhatWouldGo(Trip);

    private void ConfirmReset() =>
        _confirm?.Show(
            "Reset every game? Jeopardy goes back to the title card, the murder mystery closes its "
            + "doors, and the standings empty. Nothing anybody wrote is touched.",
            ResetAsync, "Reset everything", "Start the weekend over");

    /// <summary>
    /// Announced as <see cref="TripArea.All"/>, not Games.
    ///
    /// This is three areas at once, and the screens that care about the other two are the ones in
    /// other rooms — a board mid-trial has to hear that its game just went away, rather than
    /// carrying on showing a trial that no longer exists.
    /// </summary>
    private async Task ResetAsync()
    {
        await Store.MutateAsync(t => GameReset.All(t, Random.Shared), TripArea.All);

        // Worth forcing to disk. This is the one action on the site that cannot be undone by
        // pressing it again, and reconstructing what it cleared is not possible at all.
        await Store.FlushAsync();

        Toasts.Show("Every game reset.", ToastKind.Good);
    }
}
