@page "/"
@inherits TripAwareComponent
@using CharterTrip.Web.Services
@implements IDisposable

<PageTitle>4th Annual Charter Trip · 2026</PageTitle>

<div class="page page-home">

    <section class="hero">
        <div class="carousel">
            @* The breathing lives on the wrapper, not the individual slides, so every layer is
               at exactly the same scale during a crossfade. On the slides it made the fade and
               the breath fight each other for the transform. *@
            <div class="slides">
                @for (var i = 0; i < Palette.Count; i++)
                {
                    @* The outgoing slide stays fully opaque underneath while the incoming one
                       fades in over the top. Fading both at once dips the composite — which is
                       invisible between two different pictures and reads as a flash between two
                       identical ones, which is exactly what a single team colour produces. *@
                    <div class="slide @SlideClass(i)"
                         style="background-image: url('@DecoArt.SlideDataUri(Palette[i])')"
                         @key="i"></div>
                }
            </div>
        </div>
        <div class="hero-scrim"></div>

        <div class="hero-inner">
            <div class="hero-top">
                <p class="kicker">@Trip.Trip.Kicker</p>
                <h1 class="hero-title">
                    @Trip.Trip.Name<span class="hero-year">@Trip.Trip.Year</span>
                </h1>
                <p class="hero-meta">
                    <b>@Trip.Trip.Venue</b> · @Trip.Trip.City · @Trip.Trip.Dates
                </p>
            </div>

            @* Everybody sees the order; only the committee sees the numbers. Half of what is on
               this board comes out of games that have not been played in front of anybody yet,
               and a guest seeing a running total invites questions nobody wants to answer
               mid-weekend — but who is ahead of whom is exactly the thing worth arguing about
               in the van. *@
            <div class="hero-board">
                <div class="hero-board-head">
                    <span class="hb-label">@(AnyScores ? "Current standings" : "Standings — no points yet")</span>
                    @if (CanEdit)
                    {
                        <span class="row gap">
                            @* Where the committee puts a thumb on the scale: a point for the best
                               costume, ten off for the team that lost the van keys. *@
                            <a class="btn btn-ghost btn-xs" href="/points">Edit points</a>
                            @if (AnyScores)
                            {
                                <button class="btn btn-ghost btn-xs" @onclick="ConfirmResetPoints">Reset points</button>
                            }
                        </span>
                    }
                </div>
                <div class="hb-rows @(CanEdit ? "" : "is-ranks")">
                    @{ var top = Standings.Count > 0 ? Math.Max(1, Standings[0].Total) : 1; }
                    @for (var i = 0; i < Standings.Count; i++)
                    {
                        var row = Standings[i];
                        var pct = Math.Max(3, (int)(Math.Max(0, row.Total) / (double)top * 100));
                        <div class="hb-row @(i == 0 && AnyScores ? "hb-lead" : null)">
                            <span class="hb-rank">@(i + 1)</span>
                            <span class="hb-dot" style="background: @row.Team.Color"></span>
                            <span class="hb-name">@row.Team.Name</span>
                            @if (CanEdit)
                            {
                                <span class="hb-bar"><i style="width: @pct%; background: @row.Team.Color"></i></span>
                                <span class="hb-pts">@row.Total</span>
                            }
                        </div>
                    }
                </div>
                @if (AnyScores && CanEdit)
                {
                    <p class="hb-foot muted">
                        <b>@Standings[0].Team.Name</b> leads by
                        <b>@(Standings[0].Total - (Standings.Count > 1 ? Standings[1].Total : 0))</b> points
                    </p>
                }
            </div>

            <div class="hero-cd">
                <b>@_countdown.Headline</b><span>@_countdown.Detail</span>
            </div>
        </div>

    </section>

    <SectionCard Title="The weekend at a glance"
                 Subtitle="@($"{Trip.Trip.Venue} · {Trip.Trip.Dates}")">
        <Actions>
            @* Straight to the planner. Landing on Essentials and making someone find the tab
               is a worse answer to "edit the itinerary" than naming the tab in the link.

               Only offered to somebody who can act on it — for a guest the button was a door
               onto a room where nothing is clickable. *@
            @if (CanEdit)
            {
                <a class="btn btn-ghost btn-sm" href="/itinerary?tab=schedule">Edit itinerary →</a>
            }
        </Actions>
        <ChildContent>
            <div class="glance-grid">
                @foreach (var day in Trip.Itinerary)
                {
                    <div class="card glance-card" @key="day.Id">
                        <h3 class="glance-day">@day.Day<span class="glance-date">@day.Date</span></h3>
                        <ul class="glance-list">
                        @* The same screening the planner does: a guest sees "Games", not which
                           one. Leaving this list alone would give away on the front page exactly
                           what the schedule tab is being careful about. *@
                            @foreach (var item in (CanEdit ? day.Items : GuestSchedule.Screen(day.Items)))
                            {
                                <li @key="item.Id">
                                    <span class="gl-time">@GlanceTime(item)</span>
                                    <span class="gl-title">@item.Title</span>
                                    <TagChip Tag="item.Tag" />
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </ChildContent>
    </SectionCard>


</div>

<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>
    /// The glance list wants one short label per row: just the start time.
    /// </summary>
    private static string GlanceTime(ItineraryItem item) =>
        CharterTrip.Core.Services.TimeText.Format(item.StartMinutes);

    protected override TripArea Watching => TripArea.All;

    private int _slideIndex;
    private int _previousIndex = -1;
    private Timer? _timer;
    private TripSummary.Countdown _countdown;
    private ConfirmDialog? _confirm;

    private List<CarouselSlide> Slides => Trip.Slides;
    private IReadOnlyList<(Team Team, int Total)> Standings => TripSummary.Standings(Trip);
    private bool AnyScores => Trip.Scores.Count > 0;

    /// <summary>
    /// The colours the hero moves through.
    ///
    /// Once anyone is on the board there is exactly one — the leader's — because the point of
    /// colouring it at all is to say who is winning from across the room, and a single entry
    /// means nothing cycles and nothing crossfades.
    ///
    /// Before that it walks the teams, with a blend between each pair. Cutting straight from one
    /// team colour to the next was a noticeable step even across a long fade; going by halves
    /// turns it into a drift.
    /// </summary>
    private IReadOnlyList<string> Palette
    {
        get
        {
            if (AnyScores && Standings.Count > 0) return [Standings[0].Team.Color];
            if (Trip.Teams.Count == 0) return ["#d4af37"];

            var ramp = new List<string>();
            for (var i = 0; i < Trip.Teams.Count; i++)
            {
                var from = Trip.Teams[i].Color;
                var to = Trip.Teams[(i + 1) % Trip.Teams.Count].Color;

                ramp.Add(from);
                ramp.Add(DecoArt.Mix(from, to, 0.5));
            }

            return ramp;
        }
    }

    /// <summary>
    /// One layer is on top fading in, the one it is replacing sits opaque beneath it, and every
    /// other layer is hidden. A single-colour palette is always just "on top", never fading.
    /// </summary>
    private string? SlideClass(int index)
    {
        if (index == _slideIndex) return Palette.Count > 1 ? "is-active is-fading" : "is-active";
        return index == _previousIndex ? "is-under" : null;
    }

    private void ConfirmResetPoints() =>
        _confirm?.Show(
            "Clear every point from the weekend standings? Jeopardy, the games, all of it. " +
            "This cannot be undone.",
            () => MutateAsync(t => t.Scores.Clear()),
            "Reset the points",
            "Reset standings");

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _countdown = TripSummary.ToStart(Trip.Trip, DateTimeOffset.UtcNow);

        // Crossfades the hero background. This costs one small render per connected client every
        // few seconds, which is nothing for a couple of dozen people but is pure decoration — if
        // it ever matters, this is a CSS animation waiting to happen.
        //
        // Kept running even when there is nothing to cycle — resetting the points turns one
        // colour back into eight, and a timer that was never started would leave the hero stuck.
        // Advance simply does nothing while the palette holds a single colour.
        _timer = new Timer(_ => _ = InvokeAsync(() => { Advance(); StateHasChanged(); }),
                           null, SlideInterval, SlideInterval);
    }

    /// <summary>
    /// Long enough that the fade underneath it is still moving when the next one starts, which
    /// is what makes the colour feel like it is drifting rather than stepping.
    /// </summary>
    private static readonly TimeSpan SlideInterval = TimeSpan.FromSeconds(8);

    private void Advance()
    {
        var count = Palette.Count;
        if (count <= 1) return;

        _previousIndex = _slideIndex;
        _slideIndex = (_slideIndex + 1) % count;
    }

    public override void Dispose()
    {
        _timer?.Dispose();
        base.Dispose();
    }
}
