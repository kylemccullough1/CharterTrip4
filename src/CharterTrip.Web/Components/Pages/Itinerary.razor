@page "/itinerary"
@using CharterTrip.Core.Services
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject CharterTrip.Web.Services.ToastService Toasts

<PageTitle>Itinerary · Charter Trip 2026</PageTitle>

<div class="page">

    <SectionCard Title="@TabTitle" Subtitle="@TabSubtitle">
        <Actions>
            @* The planner's tools belong to the planner. Showing zoom controls next to the menu
               would be nonsense, so they come and go with their own tab. *@
            @if (_tab == GuideTab.Schedule)
            {
                <div class="planner-tools">
                    <div class="zoom" role="group" aria-label="Zoom">
                        <button class="mini-btn" title="Zoom out" disabled="@(_pxPerHour <= MinZoom)"
                                @onclick="() => Zoom(-1)">−</button>
                        <span class="zoom-label">@(_pxPerHour)px/hr</span>
                        <button class="mini-btn" title="Zoom in" disabled="@(_pxPerHour >= MaxZoom)"
                                @onclick="() => Zoom(1)">+</button>
                    </div>

                    <button class="btn btn-ghost btn-sm" @onclick="ToggleAllGaps">
                        @(AnyCollapsed ? "Expand empty hours" : "Collapse empty hours")
                    </button>

                    @if (CanEdit)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="AddDayAsync">+ Day</button>
                    }
                </div>
            }
        </Actions>

        <ChildContent>

            <div class="guide-tabs" role="tablist" aria-label="Weekend information">
                @foreach (var tab in Tabs)
                {
                    <button role="tab"
                            class="guide-tab @(_tab == tab.Key ? "is-active" : null)"
                            data-accent="@tab.Accent"
                            aria-selected="@(_tab == tab.Key)"
                            @onclick="() => _tab = tab.Key">
                        <span class="guide-tab-icon" aria-hidden="true">@tab.Icon</span>
                        <span>@tab.Label</span>
                    </button>
                }
            </div>

            @* Every panel stays in the document and is hidden with CSS rather than being torn
               out of it. Unmounting the planner would throw away a half-written itinerary item
               the moment somebody glanced at the menu. *@

            <section class="guide-panel @(_tab == GuideTab.Essentials ? "is-active" : null)" data-accent="gold"
                     role="tabpanel" aria-label="The essentials">

                <div class="fact-list">
                    @foreach (var fact in Guide.Essentials)
                    {
                        <div class="fact @(fact.Highlight ? "is-loud" : null)" @key="fact.Label">
                            <span class="fact-label">@fact.Label</span>
                            <span class="fact-value">@fact.Value</span>
                            @if (fact.Highlight)
                            {
                                <span class="fact-flag">bring it yourself</span>
                            }
                        </div>
                    }
                </div>

                <div class="note-grid">
                    <div class="card">
                        <h4>Nearby</h4>
                        <ul class="plain">
                            @foreach (var place in Trip.Venue.Stores)
                            {
                                <li><b>@place.Name</b> — @place.Distance</li>
                            }
                        </ul>
                    </div>

                    <div class="card">
                        <h4>Questions</h4>
                        <p class="muted">
                            Reach out to any of the four of us —
                            @string.Join(", ", Trip.Trip.Committee).
                        </p>
                    </div>
                </div>
            </section>

            <section class="guide-panel @(_tab == GuideTab.Schedule ? "is-active" : null)" data-accent="emerald"
                     role="tabpanel" aria-label="Schedule">

            @* Day tabs. Hidden on desktop by CSS, where every day is shown at once. *@
            <div class="planner-tabs" role="tablist">
                @foreach (var day in Trip.Itinerary)
                {
                    <button role="tab"
                            class="planner-tab @(day.Id == ActiveDayId ? "is-active" : null)"
                            aria-selected="@(day.Id == ActiveDayId)"
                            @onclick="() => _activeDayId = day.Id">
                        @day.Day
                    </button>
                }
            </div>

            <div class="planner">
                @foreach (var day in Trip.Itinerary)
                {
                    var timeline = TimelineFor(day);
                    var positioned = OverlapLayout.Arrange(day.Items);

                    <section class="planner-day @(day.Id == ActiveDayId ? "is-active" : null)" @key="day.Id">

                        <header class="planner-day-head">
                            <div>
                                <h3>
                                    <EditableText Value="@day.Day" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => RenameDayAsync(day.Id, v))"
                                                  Placeholder="Day" />
                                </h3>
                                <p class="muted tiny">
                                    <EditableText Value="@day.Date" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => SetDayDateAsync(day.Id, v))"
                                                  Placeholder="date" />
                                    · @day.Items.Count item@(day.Items.Count == 1 ? "" : "s")
                                </p>
                            </div>
                            @if (CanEdit)
                            {
                                <div class="planner-day-actions">
                                    <button class="mini-btn" title="Add an item at midday"
                                            @onclick="() => AddItemAsync(day.Id)">+</button>
                                    @if (day.Items.Count == 0)
                                    {
                                        <button class="mini-btn btn-danger-ghost" title="Delete this day"
                                                @onclick="() => ConfirmDeleteDay(day)">✕</button>
                                    }
                                </div>
                            }
                        </header>

                        @* The canvas supplies padding; the track is exactly TotalPixels tall so
                           ToPixels maps 1:1 onto it. Sizing the padded box itself left every card
                           on a scale 20px taller than the box holding them. *@
                        <div class="planner-canvas">
                        <div class="planner-track" style="height:@Px(timeline.TotalPixels)">

                            @foreach (var mark in timeline.HourMarks())
                            {
                                <div class="planner-hour" style="top:@Px(timeline.ToPixels(mark))">
                                    <span class="planner-hour-label">@TimeText.FormatShort(mark)</span>
                                </div>
                            }

                            @foreach (var band in timeline.Bands.Where(b => b.Kind == BandKind.Collapsed))
                            {
                                <button type="button" class="planner-gap"
                                        style="top:@Px(band.TopPixels); height:@Px(band.HeightPixels)"
                                        title="@TimeText.Format(band.StartMinutes) – @TimeText.Format(band.EndMinutes)"
                                        @onclick="() => ToggleGap(day.Id, band.Key)">
                                    <span>@TimeText.Humanize(band.DurationMinutes) free · show hours</span>
                                </button>
                            }

                            @foreach (var band in ExpandedGapBands(day, timeline))
                            {
                                <button type="button" class="planner-gap-open"
                                        style="top:@Px(band.TopPixels); height:@Px(band.HeightPixels)"
                                        @onclick="() => ToggleGap(day.Id, band.Key)">
                                    <span>collapse @TimeText.Humanize(band.DurationMinutes)</span>
                                </button>
                            }

                            <div class="planner-lanes" data-day-id="@day.Id">
                                @foreach (var pos in positioned)
                                {
                                    var item = pos.Item;
                                    var top = timeline.ToPixels(item.StartMinutes);
                                    var height = Math.Max(MinCardPixels, timeline.HeightOf(item.StartMinutes, item.DurationMinutes));
                                    var width = 100d / pos.ColumnCount;

                                    <article class="planner-card @SizeClass(height) @(_draft?.ItemId == item.Id ? "is-editing" : null)"
                                             @key="item.Id"
                                             data-item-id="@item.Id"
                                             data-day-id="@day.Id"
                                             style="top:@Px(top); height:@Px(height); left:@Pct(pos.Column * width); width:@Pct(width); --tag:@TagColor(item.Tag)"
                                             tabindex="0"
                                             @onclick="() => OpenEditor(item)"
                                             @onkeydown="e => CardKey(e, item)">

                                        <div class="card-time">@TimeText.FormatRange(item.StartMinutes, item.DurationMinutes)</div>
                                        <div class="card-title">@Display(item.Title, "Untitled")</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="card-notes">@item.Notes</div>
                                        }

                                        @if (CanEdit)
                                        {
                                            <div class="card-resize" data-resize="@item.Id" title="Drag to change how long this runs"></div>
                                        }
                                    </article>
                                }
                            </div>
                        </div>
                        </div>
                    </section>
                }
            </div>

            @if (_draft is not null)
            {
                <div class="planner-editor-backdrop" @onclick="TryCloseAsync"></div>
                <aside class="planner-editor" @onclick:stopPropagation="true">
                    <header>
                        <strong>Edit item @(IsDirty ? "·" : "")</strong>
                        <button class="mini-btn" title="Close" @onclick="TryCloseAsync">✕</button>
                    </header>

                    @if (_conflict is not null)
                    {
                        <div class="conflict">
                            <strong>Someone else changed this</strong>
                            <p class="tiny">While this was open, it was edited elsewhere. Pick which version wins.</p>
                            <ul class="tiny">
                                @foreach (var line in _conflict.Differences)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                            <div class="conflict-actions">
                                <button class="btn btn-sm" @onclick="UseTheirsAsync">Use theirs</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => SaveAsync(force: true)">Keep mine</button>
                            </div>
                        </div>
                    }

                    <label>
                        <span>Title</span>
                        <input class="inline-edit" @bind="_draft.Title" @bind:event="oninput" />
                    </label>

                    <label>
                        <span>Notes</span>
                        <textarea class="inline-edit" rows="3" @bind="_draft.Notes" @bind:event="oninput"></textarea>
                    </label>

                    <div class="editor-row">
                        <label>
                            <span>Starts</span>
                            @* Explicit value/@onchange rather than @bind: Blazor infers TimeOnly
                               for type="time" inputs, which will not bind to a string property. *@
                            <input type="time" step="900" class="inline-edit"
                                   value="@DraftClock"
                                   @onchange="e => DraftClock = e.Value?.ToString() ?? string.Empty" />
                        </label>

                        <label>
                            <span>Runs for</span>
                            <select class="inline-edit" @bind="_draft.DurationMinutes">
                                @foreach (var minutes in DurationChoices)
                                {
                                    <option value="@minutes">@TimeText.Humanize(minutes)</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="editor-row">
                        <label>
                            <span>Category</span>
                            <select class="inline-edit" @bind="_draft.Tag">
                                @foreach (var tag in Enum.GetValues<ItineraryTag>())
                                {
                                    <option value="@tag">@TagLabel(tag)</option>
                                }
                            </select>
                        </label>

                        <label>
                            <span>Day</span>
                            <select class="inline-edit" @bind="_draft.DayId">
                                @foreach (var day in Trip.Itinerary)
                                {
                                    <option value="@day.Id">@day.Day</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="editor-nudge">
                        <span class="muted tiny">Shift the start</span>
                        <div>
                            <button class="pill-btn" @onclick="() => NudgeDraft(-15)">−15 min</button>
                            <button class="pill-btn" @onclick="() => NudgeDraft(15)">+15 min</button>
                        </div>
                        <span class="muted tiny">@TimeText.FormatRange(_draft.StartMinutes, _draft.DurationMinutes)</span>
                    </div>

                    <footer>
                        <button class="btn btn-sm btn-danger-ghost" @onclick="ConfirmDeleteDraft">Delete</button>
                        <div class="spacer"></div>
                        <button class="btn btn-sm" @onclick="TryCloseAsync">Cancel</button>
                        <button class="btn btn-sm btn-gold" disabled="@(!IsDirty)" @onclick="() => SaveAsync(false)">
                            @(IsDirty ? "Save" : "Saved")
                        </button>
                    </footer>
                </aside>
            }

                <div class="note-grid mt">
                    <div class="card">
                        <h4>Saturday night</h4>
                        <p>@Guide.SaturdayNight</p>
                    </div>
                    <div class="card is-dresscode">
                        <h4>Dress code</h4>
                        <p>@Guide.DressCode</p>
                    </div>
                </div>

            </section>

            <section class="guide-panel @(_tab == GuideTab.Menu ? "is-active" : null)" data-accent="ruby"
                     role="tabpanel" aria-label="Menu">

                <div class="menu-list">
                    @foreach (var entry in Guide.Menu)
                    {
                        <div class="menu-row" @key="entry.When">
                            <span class="menu-when">@entry.When</span>
                            <span class="menu-what">@entry.What</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Guide.MenuNote))
                {
                    <p class="menu-note">@Guide.MenuNote</p>
                }
            </section>

            <section class="guide-panel @(_tab == GuideTab.Travel ? "is-active" : null)" data-accent="sapphire"
                     role="tabpanel" aria-label="Travel">

                <div class="note-grid">
                    <div class="card">
                        <h4>Destination</h4>
                        <p class="strong">
                            <EditableText Value="@Travel.Destination" ReadOnly="@(!CanEdit)"
                                          ValueChanged="@(v => EditTravelAsync(t => t.Destination = v))"
                                          Placeholder="Where we are going" />
                        </p>
                        <p class="muted">
                            <EditableText Value="@Travel.Address" ReadOnly="@(!CanEdit)"
                                          ValueChanged="@(v => EditTravelAsync(t => t.Address = v))"
                                          Placeholder="Street address" />
                        </p>
                        <p class="muted tiny">
                            Check-in
                            <b><EditableText Value="@Travel.CheckInTime" ReadOnly="@(!CanEdit)"
                                             ValueChanged="@(v => EditTravelAsync(t => t.CheckInTime = v))"
                                             Placeholder="—" /></b>
                            · Check-out
                            <b><EditableText Value="@Travel.CheckOutTime" ReadOnly="@(!CanEdit)"
                                             ValueChanged="@(v => EditTravelAsync(t => t.CheckOutTime = v))"
                                             Placeholder="—" /></b>
                        </p>
                    </div>

                    <div class="card">
                        <h4>Drive times</h4>
                        <ul class="plain">
                            @for (var i = 0; i < Travel.DriveTimes.Count; i++)
                            {
                                var index = i;
                                <li>
                                    <b>@Travel.DriveTimes[index].From</b> —
                                    <EditableText Value="@Travel.DriveTimes[index].Duration" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditTravelAsync(t => t.DriveTimes[index].Duration = v))"
                                                  Placeholder="—" />
                                </li>
                            }
                        </ul>
                        <p class="muted tiny">
                            <EditableText Value="@Travel.Note" Multiline="true" ReadOnly="@(!CanEdit)"
                                          ValueChanged="@(v => EditTravelAsync(t => t.Note = v))"
                                          Placeholder="How carpooling works" />
                        </p>
                    </div>
                </div>

                @if (Cars.Count > 0)
                {
                    <div class="car-legend">
                        <span class="muted tiny">Cars</span>
                        @foreach (var car in Cars)
                        {
                            <span class="car-chip" style="--car:@CarColor(car)">
                                @car <b>@CarCount(car)</b>
                            </span>
                        }
                    </div>
                }

                <div class="table-scroll mt">
                    <table class="table travel-table">
                        <thead>
                        <tr>
                            <th>Who</th>
                            <th>Car</th>
                            <th>Leaving from</th>
                            <th>Can depart</th>
                            <th>Dietary</th>
                            <th>Notes</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var person in Trip.Roster)
                        {
                            var row = RowFor(person.Id);
                            <tr @key="person.Id" style="--car:@CarColor(row.Car)"
                                class="@(string.IsNullOrWhiteSpace(row.Car) ? null : "has-car")">
                                <td class="travel-who">@person.Name</td>
                                <td>
                                    <EditableText Value="@row.Car" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditRowAsync(person.Id, r => r.Car = v))"
                                                  Placeholder="—" />
                                </td>
                                <td>
                                    <EditableText Value="@row.LeavingFrom" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditRowAsync(person.Id, r => r.LeavingFrom = v))"
                                                  Placeholder="—" />
                                </td>
                                <td>
                                    <EditableText Value="@row.DepartAt" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditRowAsync(person.Id, r => r.DepartAt = v))"
                                                  Placeholder="—" />
                                </td>
                                <td>
                                    <EditableText Value="@row.Dietary" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditRowAsync(person.Id, r => r.Dietary = v))"
                                                  Placeholder="—" />
                                </td>
                                <td>
                                    <EditableText Value="@row.Notes" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditRowAsync(person.Id, r => r.Notes = v))"
                                                  Placeholder="—" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>

        </ChildContent>
    </SectionCard>

    <SectionCard Title="What to bring"
                 Subtitle="Ticked boxes are saved on this device only — nobody else sees your list.">
        <Actions>
            <span class="muted tiny">@PackedCount of @PackTotal packed</span>
            @if (PackedCount > 0)
            {
                <button class="btn btn-ghost btn-sm" @onclick="ClearPackingAsync">Reset</button>
            }
        </Actions>

        <ChildContent>
            <div class="pack-grid">
                @foreach (var group in Guide.Packing)
                {
                    <div class="card pack-group @(group.Required ? "is-required" : null)" @key="group.Id">
                        <h4>
                            @group.Title
                            @if (group.Required)
                            {
                                <span class="pack-required-flag">everyone</span>
                            }
                        </h4>

                        <ul class="pack-items">
                            @foreach (var item in group.Items)
                            {
                                <li @key="item.Id">
                                    <label class="pack-item @(IsPacked(item.Id) ? "is-done" : null)">
                                        <input type="checkbox"
                                               checked="@IsPacked(item.Id)"
                                               @onchange="e => TogglePackedAsync(item.Id, e.Value is true)" />
                                        <span>@item.Text</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="card pack-group is-car">
                    <h4>What every car brings</h4>
                    <p class="muted tiny">Once your car group is set, that car is responsible for:</p>
                    <ul class="plain pack-car">
                        @foreach (var thing in Guide.CarBrings)
                        {
                            <li @key="thing">@thing</li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(Guide.CarBringsNote))
                    {
                        <p class="muted tiny">@Guide.CarBringsNote</p>
                    }
                </div>
            </div>
        </ChildContent>
    </SectionCard>

    <ConfirmDialog @ref="_confirm" />
</div>

@code {
    // The page now shows the itinerary, the guest guide and the travel sheet, so it has a stake
    // in more than one area and watching all of them is the honest answer.
    protected override TripArea Watching => TripArea.All;

    // ------------------------------------------------------------------ tabs

    private enum GuideTab { Essentials, Schedule, Menu, Travel }

    private GuideTab _tab = GuideTab.Essentials;

    /// <summary>
    /// Each tab carries its own accent. Four sections of dense text all in the same gold were
    /// hard to tell apart at a glance, so the colour does the work the headings could not.
    /// </summary>
    private static readonly (GuideTab Key, string Label, string Icon, string Accent)[] Tabs =
    [
        (GuideTab.Essentials, "Essentials", "◆", "gold"),
        (GuideTab.Schedule, "Itinerary", "◷", "emerald"),
        (GuideTab.Menu, "Menu", "◈", "ruby"),
        (GuideTab.Travel, "Travel", "◇", "sapphire")
    ];

    private string AccentFor(GuideTab tab) => Tabs.First(t => t.Key == tab).Accent;

    private GuestGuide Guide => Trip.Guide;
    private TravelPlan Travel => Trip.Travel;

    private string TabTitle => _tab switch
    {
        GuideTab.Essentials => "The essentials",
        GuideTab.Menu => "Menu",
        GuideTab.Travel => "Getting there",
        _ => "Itinerary"
    };

    private string TabSubtitle => _tab switch
    {
        GuideTab.Essentials => $"{Trip.Trip.Venue} · {Trip.Trip.Dates}",
        GuideTab.Menu => "Everything on this list is covered.",
        GuideTab.Travel => "Same car name, same colour. Sort it out amongst yourselves.",
        _ => SubtitleText
    };

    // ---------------------------------------------------------------- travel

    private Task EditTravelAsync(Action<TravelPlan> apply) =>
        Store.MutateAsync(t => apply(t.Travel), TripArea.Travel);

    /// <summary>
    /// The row for a person, or a blank stand-in. Reading the table must not write to it — a row
    /// is only ever created once somebody actually types something.
    /// </summary>
    private TravelRow RowFor(string personId) =>
        Travel.Rows.FirstOrDefault(r => r.PersonId == personId) ?? new TravelRow { PersonId = personId };

    /// <summary>
    /// Edit a person's row, creating it on first use and dropping it again once every field has
    /// been cleared, so the file does not fill with empty records.
    /// </summary>
    private Task EditRowAsync(string personId, Action<TravelRow> apply) =>
        Store.MutateAsync(t =>
        {
            var row = t.Travel.Rows.FirstOrDefault(r => r.PersonId == personId);
            if (row is null)
            {
                row = new TravelRow { PersonId = personId };
                t.Travel.Rows.Add(row);
            }

            apply(row);

            if (row.IsEmpty) t.Travel.Rows.Remove(row);
        }, TripArea.Travel);

    /// <summary>Car names in the order they first appear, so a car keeps its colour as rows change.</summary>
    private List<string> Cars =>
        Trip.Roster
            .Select(p => RowFor(p.Id).Car)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private int CarCount(string car) =>
        Trip.Roster.Count(p => string.Equals(RowFor(p.Id).Car.Trim(), car, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// The spreadsheet asked everyone to highlight their car in a matching colour by hand. Here
    /// the name picks the colour, so two people in the same car cannot end up different shades.
    /// </summary>
    private static readonly string[] CarColors =
        ["#d4af37", "#2e9e7e", "#c94f5a", "#4a7fd6", "#b07cc6", "#d98c3f", "#4fb0a5", "#c96f9b"];

    private string CarColor(string? car)
    {
        if (string.IsNullOrWhiteSpace(car)) return "transparent";

        var index = Cars.FindIndex(c => string.Equals(c, car.Trim(), StringComparison.OrdinalIgnoreCase));
        return index < 0 ? "transparent" : CarColors[index % CarColors.Length];
    }

    // --------------------------------------------------------------- packing

    /// <summary>
    /// Which items this person has ticked. Held here for rendering and mirrored into the
    /// browser's own storage — it is never written to trip.json, because one shared set of
    /// checkboxes across twenty-six people would be useless to all of them.
    /// </summary>
    private readonly HashSet<string> _packed = new(StringComparer.Ordinal);

    private IJSObjectReference? _packing;

    private int PackTotal => Guide.Packing.Sum(g => g.Items.Count);

    /// <summary>Counted against the list as it stands, so a removed item cannot inflate it.</summary>
    private int PackedCount => Guide.Packing.SelectMany(g => g.Items).Count(i => _packed.Contains(i.Id));

    private bool IsPacked(string id) => _packed.Contains(id);

    private async Task TogglePackedAsync(string id, bool packed)
    {
        if (packed) _packed.Add(id); else _packed.Remove(id);
        await SavePackingAsync();
    }

    private async Task ClearPackingAsync()
    {
        _packed.Clear();
        await SavePackingAsync();
    }

    private async Task SavePackingAsync()
    {
        if (_packing is null) return;
        try { await _packing.InvokeVoidAsync("save", _packed); } catch (JSDisconnectedException) { }
    }

    private const int MinZoom = 40;
    private const int MaxZoom = 112;
    // Two stacked lines need about this much room. Anything shorter than roughly half an hour
    // renders at this floor rather than becoming an unreadable sliver.
    private const double MinCardPixels = 32;

    private static readonly int[] DurationChoices =
        [15, 30, 45, 60, 90, 120, 150, 180, 240, 300, 360];

    private ConfirmDialog? _confirm;
    private int _pxPerHour = 64;
    private string? _activeDayId;

    /// <summary>Gap band keys the user has opened out, per day.</summary>
    private readonly Dictionary<string, HashSet<string>> _expanded = [];

    // --- the editor's working copy -----------------------------------------
    // Nothing here touches the trip until Save is pressed. _pristine is the copy the form
    // opened with, so "is this dirty?" is a comparison rather than a pile of change flags.
    private Draft? _draft;
    private Draft? _pristine;
    private ConflictInfo? _conflict;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Itinerary>? _self;

    private string SubtitleText => CanEdit
        ? "Drag a card to move it, or drag its bottom edge to change how long it runs. Click a card to edit the details."
        : "The plan for the weekend. The committee keeps this up to date.";

    private string? ActiveDayId => _activeDayId ?? Trip.Itinerary.FirstOrDefault()?.Id;

    private bool IsDirty => _draft is not null && _pristine is not null && !_draft.SameAs(_pristine);

    // ------------------------------------------------------------- timeline

    private TimelineSettings Settings => new() { PxPerHour = _pxPerHour };

    private DayTimeline TimelineFor(ItineraryDay day) =>
        DayTimeline.Build(day, Settings, ExpandedFor(day.Id));

    private HashSet<string> ExpandedFor(string dayId) =>
        _expanded.TryGetValue(dayId, out var set) ? set : [];

    private IEnumerable<TimelineBand> ExpandedGapBands(ItineraryDay day, DayTimeline timeline)
    {
        var open = ExpandedFor(day.Id);
        return open.Count == 0
            ? []
            : timeline.Bands.Where(b => b.Kind == BandKind.Expanded && open.Contains(b.Key));
    }

    private bool AnyCollapsed => Trip.Itinerary
        .Any(d => TimelineFor(d).Bands.Any(b => b.Kind == BandKind.Collapsed));

    private void ToggleGap(string dayId, string bandKey)
    {
        var set = _expanded.TryGetValue(dayId, out var existing) ? existing : _expanded[dayId] = [];
        if (!set.Remove(bandKey)) set.Add(bandKey);
    }

    private void ToggleAllGaps()
    {
        if (AnyCollapsed)
        {
            foreach (var day in Trip.Itinerary)
            {
                var set = _expanded.TryGetValue(day.Id, out var existing) ? existing : _expanded[day.Id] = [];
                foreach (var band in TimelineFor(day).Bands.Where(b => b.Kind == BandKind.Collapsed))
                    set.Add(band.Key);
            }
        }
        else
        {
            _expanded.Clear();
        }
    }

    private void Zoom(int direction) =>
        _pxPerHour = Math.Clamp(_pxPerHour + direction * 16, MinZoom, MaxZoom);

    // --------------------------------------------------------- editor form

    private void OpenEditor(ItineraryItem item)
    {
        if (!CanEdit) return;

        var day = ItineraryService.Locate(Trip, item.Id).Day;
        if (day is null) return;

        _draft = Draft.From(item, day.Id);
        _pristine = _draft.Copy();
        _conflict = null;
    }

    private void CloseEditor()
    {
        _draft = null;
        _pristine = null;
        _conflict = null;
    }

    private Task TryCloseAsync()
    {
        if (!IsDirty)
        {
            CloseEditor();
            return Task.CompletedTask;
        }

        _confirm?.Show("Close without saving? Your changes to this item will be lost.",
            () => { CloseEditor(); StateHasChanged(); return Task.CompletedTask; },
            "Discard changes", "Unsaved changes");

        return Task.CompletedTask;
    }

    private string DraftClock
    {
        get
        {
            var m = (_draft?.StartMinutes ?? ItineraryItem.DefaultStartMinutes) % TimeText.Day;
            return $"{m / 60:00}:{m % 60:00}";
        }
        set
        {
            if (_draft is null || !TimeOnly.TryParse(value, out var clock)) return;

            // A browser time input has no concept of "1am belongs to last night", so anything
            // before the 6am anchor is pushed into the small hours of the same planner day.
            var minutes = clock.Hour * 60 + clock.Minute;
            if (minutes < TimeText.DayAnchor) minutes += TimeText.Day;
            _draft.StartMinutes = ItineraryService.ClampStart(minutes);
        }
    }

    private void NudgeDraft(int deltaMinutes)
    {
        if (_draft is null) return;
        _draft.StartMinutes = ItineraryService.ClampStart(TimeText.Snap(_draft.StartMinutes + deltaMinutes));
    }

    private async Task SaveAsync(bool force)
    {
        if (_draft is null) return;

        var outcome = SaveOutcome.Saved;
        await MutateAsync(t => outcome = ItineraryService.ApplyEdit(t, _draft.ToEdit(), force));

        switch (outcome)
        {
            case SaveOutcome.Saved:
                // Saving is the end of the interaction — leaving the panel open over the grid
                // just hides the change you came to make.
                CloseEditor();
                Toasts.Show("Saved", CharterTrip.Web.Services.ToastKind.Good);
                break;

            case SaveOutcome.Conflict:
                var theirs = ItineraryService.Locate(Trip, _draft.ItemId).Item;
                _conflict = theirs is null ? null : ConflictInfo.Between(_draft, theirs, Trip);
                break;

            case SaveOutcome.Missing:
                Toasts.Show("That item was deleted by someone else", CharterTrip.Web.Services.ToastKind.Bad);
                CloseEditor();
                break;
        }
    }

    /// <summary>Throw away the local edits and reload the form from whatever is current.</summary>
    private Task UseTheirsAsync()
    {
        if (_draft is null) return Task.CompletedTask;

        var (day, item) = ItineraryService.Locate(Trip, _draft.ItemId);
        if (day is null || item is null)
        {
            CloseEditor();
            return Task.CompletedTask;
        }

        _draft = Draft.From(item, day.Id);
        _pristine = _draft.Copy();
        _conflict = null;
        return Task.CompletedTask;
    }

    private void CardKey(KeyboardEventArgs e, ItineraryItem item)
    {
        if (!CanEdit) return;
        if (e.Key is "Enter" or " ") OpenEditor(item);
    }

    // ------------------------------------------------------- adding, removing

    private Task RenameDayAsync(string dayId, string value) => MutateAsync(t =>
    {
        var day = ItineraryService.FindDay(t, dayId);
        if (day is not null) day.Day = value;
    });

    private Task SetDayDateAsync(string dayId, string value) => MutateAsync(t =>
    {
        var day = ItineraryService.FindDay(t, dayId);
        if (day is not null) day.Date = value;
    });

    private async Task AddItemAsync(string dayId)
    {
        string? newId = null;
        await MutateAsync(t => newId = ItineraryService.AddItem(t, dayId)?.Id);

        var added = newId is null ? null : ItineraryService.Locate(Trip, newId).Item;
        if (added is not null) OpenEditor(added);
    }

    private Task AddDayAsync() => MutateAsync(t => ItineraryService.AddDay(t));

    private void ConfirmDeleteDraft()
    {
        if (_draft is null) return;

        var id = _draft.ItemId;
        var title = Display(_draft.Title, "this item");

        _confirm?.Show($"Delete “{title}”?", async () =>
        {
            CloseEditor();
            await MutateAsync(t => ItineraryService.RemoveItem(t, id));
        }, "Delete");
    }

    private void ConfirmDeleteDay(ItineraryDay day) =>
        _confirm?.Show($"Delete {Display(day.Day, "this day")}?",
            () => MutateAsync(t => ItineraryService.RemoveDay(t, day.Id)), "Delete");

    // ------------------------------------------------------- drag and resize
    // The browser reports pixels; the conversion to minutes happens here, because collapsed
    // bands make that mapping non-linear and DayTimeline is the one place that knows about them.
    //
    // Dragging stays immediate rather than joining the save model — direct manipulation that
    // needed a separate confirmation would be its own kind of strange.

    [JSInvokable]
    public async Task ItemDropped(string itemId, string dayId, double topPixels, string? ontoItemId)
    {
        if (!string.IsNullOrEmpty(ontoItemId) && ontoItemId != itemId)
        {
            await MutateAsync(t => ItineraryService.SwapSlots(t, itemId, ontoItemId));
            return;
        }

        var day = ItineraryService.FindDay(Trip, dayId);
        if (day is null) return;

        var minutes = TimeText.Snap(TimelineFor(day).ToMinutes(topPixels));
        await MutateAsync(t => ItineraryService.MoveToDay(t, itemId, dayId, minutes));
    }

    [JSInvokable]
    public async Task ItemResized(string itemId, double bottomPixels)
    {
        var (day, item) = ItineraryService.Locate(Trip, itemId);
        if (day is null || item is null) return;

        var end = TimeText.Snap(TimelineFor(day).ToMinutes(bottomPixels));
        await MutateAsync(t => ItineraryService.SetDuration(t, itemId, end - item.StartMinutes));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The ticked boxes can only be read once there is a browser to read them from, so the
        // list renders unticked for one frame and then fills in. Cheaper than blocking the page
        // on interop, and nobody is looking at their packing list in the first 30ms.
        try
        {
            _packing = await JS.InvokeAsync<IJSObjectReference>("import", "./js/packing.js");
            var saved = await _packing.InvokeAsync<string[]>("load");

            _packed.Clear();
            foreach (var id in saved) _packed.Add(id);

            StateHasChanged();
        }
        catch (JSDisconnectedException) { }

        if (!CanEdit) return;

        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/planner.js");
        await _module.InvokeVoidAsync("init", _self);
    }

    // ------------------------------------------------------------- display

    private static string Px(double value) => $"{value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px";
    private static string Pct(double value) => $"{value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string Display(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    /// <summary>A 30-minute card has room for a title and nothing else. Render to fit.</summary>
    private static string SizeClass(double height) => height switch
    {
        >= 80 => "is-full",     // time, activity, and the note
        >= 46 => "is-medium",   // time and activity, comfortably
        _ => "is-compact"       // time and activity, tight
    };

    private static string TagLabel(ItineraryTag tag) => tag switch
    {
        ItineraryTag.FreeTime => "Free time",
        _ => tag.ToString()
    };

    private static string TagColor(ItineraryTag tag) => tag switch
    {
        ItineraryTag.Food => "#e0a458",
        ItineraryTag.Game => "#c94f5a",
        ItineraryTag.Logistics => "#4a7fd6",
        ItineraryTag.FreeTime => "#2e9e7e",
        _ => "#888888"
    };

    // ---------------------------------------------------------------- types

    /// <summary>The editor's mutable working copy. Bound to the form; never shared with the store.</summary>
    private sealed class Draft
    {
        public string ItemId { get; set; } = "";
        public int BaseVersion { get; set; }
        public string DayId { get; set; } = "";
        public string Title { get; set; } = "";
        public string Notes { get; set; } = "";
        public ItineraryTag Tag { get; set; }
        public int StartMinutes { get; set; }
        public int DurationMinutes { get; set; }

        public static Draft From(ItineraryItem item, string dayId) => new()
        {
            ItemId = item.Id,
            BaseVersion = item.Version,
            DayId = dayId,
            Title = item.Title,
            Notes = item.Notes,
            Tag = item.Tag,
            StartMinutes = item.StartMinutes,
            DurationMinutes = item.DurationMinutes
        };

        public Draft Copy() => (Draft)MemberwiseClone();

        public bool SameAs(Draft other) =>
            DayId == other.DayId && Title == other.Title && Notes == other.Notes &&
            Tag == other.Tag && StartMinutes == other.StartMinutes && DurationMinutes == other.DurationMinutes;

        public ItemEdit ToEdit() =>
            new(ItemId, BaseVersion, DayId, Title, Notes, Tag, StartMinutes, DurationMinutes);
    }

    /// <summary>What the other person changed, in words, so the choice is an informed one.</summary>
    private sealed record ConflictInfo(IReadOnlyList<string> Differences)
    {
        public static ConflictInfo Between(Draft mine, ItineraryItem theirs, TripData trip)
        {
            var lines = new List<string>();

            if (mine.Title != theirs.Title)
                lines.Add($"Title — theirs: “{theirs.Title}”, yours: “{mine.Title}”");

            if (mine.StartMinutes != theirs.StartMinutes || mine.DurationMinutes != theirs.DurationMinutes)
                lines.Add($"Time — theirs: {TimeText.FormatRange(theirs.StartMinutes, theirs.DurationMinutes)}, " +
                          $"yours: {TimeText.FormatRange(mine.StartMinutes, mine.DurationMinutes)}");

            if (mine.Notes != theirs.Notes)
                lines.Add("Notes differ");

            if (mine.Tag != theirs.Tag)
                lines.Add($"Category — theirs: {theirs.Tag}, yours: {mine.Tag}");

            var theirDay = ItineraryService.Locate(trip, theirs.Id).Day;
            if (theirDay is not null && theirDay.Id != mine.DayId)
                lines.Add($"Day — theirs: {theirDay.Day}");

            if (lines.Count == 0) lines.Add("Someone saved it without changing anything you also edited.");

            return new ConflictInfo(lines);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }

        if (_packing is not null)
        {
            try { await _packing.DisposeAsync(); } catch (JSDisconnectedException) { }
        }

        _self?.Dispose();
        Dispose();
    }
}
