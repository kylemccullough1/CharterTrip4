@page "/itinerary"
@using CharterTrip.Core.Services
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject CharterTrip.Web.Services.ToastService Toasts

<PageTitle>Itinerary · Charter Trip 2026</PageTitle>

<div class="page">

    @* Fixed overall height, not just a fixed panel. The panels were already the same size, but
       the head above them is not: Schedule carries the planner toolbar and the subtitles wrap to
       different depths, so the card total drifted by a row or two between tabs and the divider
       below moved with it. Sizing the card and letting the body take whatever is left makes
       every tab end on exactly the same line. *@
    <SectionCard CssClass="guide-card" Title="@TabTitle" Subtitle="@TabSubtitle">
        <Actions>
            @* The planner's tools belong to the planner. Showing zoom controls next to the menu
               would be nonsense, so they come and go with their own tab. *@
            @if (_tab == GuideTab.Schedule)
            {
                <div class="planner-tools">
                    @* How tall an hour is drawn is a stored decision about how the schedule reads,
                       so changing it is an edit like any other. *@
                    @if (CanEdit)
                    {
                    <div class="zoom" role="group" aria-label="Zoom">
                        <button class="mini-btn" title="Zoom out" disabled="@(PxPerHour <= MinZoom)"
                                @onclick="() => ZoomAsync(-1)">−</button>
                        <span class="zoom-label">@(PxPerHour)px/hr</span>
                        <button class="mini-btn" title="Zoom in" disabled="@(PxPerHour >= MaxZoom)"
                                @onclick="() => ZoomAsync(1)">+</button>
                    </div>
                    }

                    <button class="btn btn-ghost btn-sm" @onclick="ToggleAllGaps">
                        @(AnyCollapsed ? "Expand empty hours" : "Collapse empty hours")
                    </button>
                </div>
            }
        </Actions>

        <ChildContent>

            <div class="guide-tabs" role="tablist" aria-label="Weekend information">
                @foreach (var tab in Tabs)
                {
                    <button role="tab"
                            class="guide-tab @(_tab == tab.Key ? "is-active" : null)"
                            data-accent="@tab.Accent"
                            aria-selected="@(_tab == tab.Key)"
                            @onclick="() => _tab = tab.Key">
                        <span class="guide-tab-icon" aria-hidden="true">@tab.Icon</span>
                        <span>@tab.Label</span>
                    </button>
                }
            </div>

            @* Every panel stays in the document and is hidden with CSS rather than being torn
               out of it. Unmounting the planner would throw away a half-written itinerary item
               the moment somebody glanced at the menu. *@

            <section class="guide-panel @(_tab == GuideTab.Essentials ? "is-active" : null)" data-accent="gold"
                     role="tabpanel" aria-label="The essentials">

                @* Headed groups. Seven unrelated rows in one flat list was the problem — the
                   answer to "what does the house cost me" sat between the check-out time and the
                   bathroom count. Each heading now holds only the facts that belong to it. *@
                <div class="ess-groups">
                    @foreach (var group in EssentialGroups)
                    {
                        <section class="ess-group" @key="group.Name">
                            <header class="ess-group-head">
                                <h4 class="ess-group-name">@group.Name</h4>
                                @if (CanEdit)
                                {
                                    <IconButton Icon="IconButtonIcon.Plus"
                                                Title="@($"Add a line to {group.Name}")"
                                                OnClick="@(() => AddFactAsync(group.Name))" />
                                }
                            </header>

                            <dl class="ess-rows">
                                @foreach (var entry in group.Facts)
                                {
                                    var index = entry.Index;
                                    var fact = entry.Fact;

                                    <div class="ess-row @(fact.Highlight ? "is-loud" : null)" @key="fact">
                                        <dt>
                                            <EditableText Value="@fact.Label" ReadOnly="@(!CanEdit)"
                                                          ValueChanged="@(v => EditFactAsync(index, f => f.Label = v))"
                                                          Placeholder="label" />
                                        </dt>
                                        <dd>
                                            @* The Where line is itself the map link — for anyone who cannot edit
                                               it. A committee member still clicks it to edit, so they keep
                                               the small link below instead; one click cannot do both. *@
                                            <EditableText Value="@fact.Value" Multiline="true" ReadOnly="@(!CanEdit)"
                                                          Href="@MapHrefFor(fact)"
                                                          ValueChanged="@(v => EditFactAsync(index, f => f.Value = v))"
                                                          Placeholder="—" />

                                            @if (fact.Highlight)
                                            {
                                                <span class="fact-flag">bring it yourself</span>
                                            }

                                            @if (CanEdit && MapHrefFor(fact) is { } href)
                                            {
                                                <a class="map-link" href="@href"
                                                   target="_blank" rel="noopener">Open in Maps</a>
                                            }
                                        </dd>

                                        @if (CanEdit)
                                        {
                                            <button type="button" class="ess-remove" title="Remove this line"
                                                    @onclick="() => RemoveFactAsync(index)">✕</button>
                                        }
                                    </div>
                                }
                            </dl>
                        </section>
                    }

                    @* Nearby reads from the venue rather than being copied into the guide, so the
                       Venue page and this one can never disagree about how far Walmart is. *@
                    <section class="ess-group">
                        <header class="ess-group-head">
                            <h4 class="ess-group-name">Nearby</h4>
                            @if (CanEdit)
                            {
                                <IconButton Icon="IconButtonIcon.Plus"
                                            Title="Add a place"
                                            OnClick="AddStoreAsync" />
                            }
                        </header>

                        <dl class="ess-rows">
                            @for (var i = 0; i < Trip.Venue.Stores.Count; i++)
                            {
                                var index = i;
                                var place = Trip.Venue.Stores[index];

                                <div class="ess-row" @key="place">
                                    <dt>
                                        <EditableText Value="@place.Name" ReadOnly="@(!CanEdit)"
                                                      ValueChanged="@(v => EditStoreAsync(index, s => s.Name = v))"
                                                      Placeholder="place" />
                                    </dt>
                                    <dd>
                                        <EditableText Value="@place.Distance" ReadOnly="@(!CanEdit)"
                                                      ValueChanged="@(v => EditStoreAsync(index, s => s.Distance = v))"
                                                      Placeholder="—" />
                                    </dd>

                                    @if (CanEdit)
                                    {
                                        <button type="button" class="ess-remove" title="Remove this line"
                                                @onclick="() => RemoveStoreAsync(index)">✕</button>
                                    }
                                </div>
                            }
                        </dl>
                    </section>
                </div>
            </section>

            <section class="guide-panel @(_tab == GuideTab.Schedule ? "is-active" : null)" data-accent="emerald"
                     role="tabpanel" aria-label="Schedule">

                @* Above the planner, not below it. These are the two things somebody needs
                   *before* reading Saturday — what the evening is, and what to wear for it —
                   and underneath a full-height schedule they were off the bottom of the panel. *@
                <div class="note-grid schedule-lede">
                    <div class="card">
                        <h4>Saturday night</h4>
                        <p>
                            <EditableText Value="@Guide.SaturdayNight" Multiline="true" Rows="3"
                                          ReadOnly="@(!CanEdit)"
                                          ValueChanged="@(v => EditGuideAsync(g => g.SaturdayNight = v))"
                                          Placeholder="What Saturday evening is" />
                        </p>
                    </div>
                    <div class="card is-dresscode">
                        <h4>Dress code</h4>
                        <p>
                            <EditableText Value="@Guide.DressCode" Multiline="true" Rows="3"
                                          ReadOnly="@(!CanEdit)"
                                          ValueChanged="@(v => EditGuideAsync(g => g.DressCode = v))"
                                          Placeholder="What to wear for it" />
                        </p>
                    </div>
                </div>

            @* Day tabs. Hidden on desktop by CSS, where every day is shown at once. *@
            <div class="planner-tabs" role="tablist">
                @foreach (var day in Trip.Itinerary)
                {
                    <button role="tab"
                            class="planner-tab @(day.Id == ActiveDayId ? "is-active" : null)"
                            aria-selected="@(day.Id == ActiveDayId)"
                            @onclick="() => _activeDayId = day.Id">
                        @day.Day
                    </button>
                }
            </div>

            @* On desktop a day can take the whole stage: the others fall back to a sidebar of
               names, and any of them — or Overview — brings the three-across view back. Same
               planner, same cards; only which days are visible changes, so nothing in flight
               (an open editor, a half-dragged card) is ever thrown away by zooming in. *@
            <div class="planner-stage @(FocusDay is not null ? "is-focused" : null)">
            @if (FocusDay is not null)
            {
                <aside class="planner-side">
                    <button type="button" class="planner-side-back" @onclick="() => _focusDayId = null">
                        ← Overview
                    </button>
                    @foreach (var day in Trip.Itinerary)
                    {
                        <button type="button"
                                class="planner-side-day @(day.Id == _focusDayId ? "is-current" : null)"
                                @onclick="() => _focusDayId = day.Id">
                            <b>@day.Day</b>
                            <span>@day.Date</span>
                            <i>@day.Items.Count item@(day.Items.Count == 1 ? "" : "s")</i>
                        </button>
                    }
                </aside>
            }

            <div class="planner">
                @foreach (var day in Trip.Itinerary)
                {
                    var view = ViewOf(day);
                    var timeline = TimelineFor(view);
                    var positioned = OverlapLayout.Arrange(view.Items);

                    <section class="planner-day @(day.Id == ActiveDayId ? "is-active" : null) @(FocusDay is not null ? (day.Id == _focusDayId ? "is-focus" : "is-parked") : null)"
                             @key="day.Id">

                        <header class="planner-day-head">
                            <div>
                                <h3>
                                    <EditableText Value="@day.Day" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => RenameDayAsync(day.Id, v))"
                                                  Placeholder="Day" />
                                </h3>
                                <p class="muted tiny">
                                    <EditableText Value="@day.Date" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => SetDayDateAsync(day.Id, v))"
                                                  Placeholder="date" />
                                    · @view.Items.Count item@(view.Items.Count == 1 ? "" : "s")
                                </p>
                            </div>
                            <div class="planner-day-actions">
                                <IconButton Icon="@(day.Id == _focusDayId ? IconButtonIcon.Collapse : IconButtonIcon.Expand)"
                                            Title="@(day.Id == _focusDayId ? "Back to all days" : "Expand this day")"
                                            OnClick="@(() => _focusDayId = day.Id == _focusDayId ? null : day.Id)" />
                                @if (CanEdit)
                                {
                                    <IconButton Icon="IconButtonIcon.Plus" Title="Add an item at midday"
                                                OnClick="@(() => AddItem(day.Id))" />
                                    @if (day.Items.Count == 0)
                                    {
                                        <IconButton Icon="IconButtonIcon.Close" Tone="danger" Title="Delete this day"
                                                    OnClick="@(() => ConfirmDeleteDay(day))" />
                                    }
                                }
                            </div>
                        </header>

                        @* The canvas supplies padding; the track is exactly TotalPixels tall so
                           ToPixels maps 1:1 onto it. Sizing the padded box itself left every card
                           on a scale 20px taller than the box holding them. *@
                        <div class="planner-canvas">
                        <div class="planner-track" style="height:@Px(timeline.TotalPixels)">

                            @foreach (var mark in timeline.HourMarks())
                            {
                                <div class="planner-hour" style="top:@Px(timeline.ToPixels(mark))">
                                    <span class="planner-hour-label">@TimeText.FormatShort(mark)</span>
                                </div>
                            }

                            @foreach (var band in timeline.Bands.Where(b => b.Kind == BandKind.Collapsed))
                            {
                                <button type="button" class="planner-gap"
                                        style="top:@Px(band.TopPixels); height:@Px(band.HeightPixels)"
                                        title="@TimeText.Format(band.StartMinutes) – @TimeText.Format(band.EndMinutes)"
                                        @onclick="() => ToggleGap(day.Id, band.Key)">
                                    <span>@TimeText.Humanize(band.DurationMinutes) free · show hours</span>
                                </button>
                            }

                            @foreach (var band in ExpandedGapBands(day, timeline))
                            {
                                <button type="button" class="planner-gap-open"
                                        style="top:@Px(band.TopPixels); height:@Px(band.HeightPixels)"
                                        @onclick="() => ToggleGap(day.Id, band.Key)">
                                    <span>collapse @TimeText.Humanize(band.DurationMinutes)</span>
                                </button>
                            }

                            <div class="planner-lanes" data-day-id="@day.Id">
                                @foreach (var pos in positioned)
                                {
                                    var item = pos.Item;
                                    var top = timeline.ToPixels(item.StartMinutes);
                                    var height = Math.Max(MinCardPixels, timeline.HeightOf(item.StartMinutes, item.DurationMinutes));
                                    var width = 100d / pos.ColumnCount;

                                    <article class="planner-card @SizeClass(height) @(_draft?.ItemId == item.Id ? "is-editing" : null)"
                                             @key="item.Id"
                                             data-item-id="@item.Id"
                                             data-day-id="@day.Id"
                                             style="top:@Px(top); height:@Px(height); left:@Pct(pos.Column * width); width:@Pct(width); --tag:@TagColor(item.Tag)"
                                             tabindex="0"
                                             @onclick="() => OpenEditor(item)"
                                             @onkeydown="e => CardKey(e, item)">

                                        <div class="card-time">@TimeText.FormatRange(item.StartMinutes, item.DurationMinutes)</div>
                                        <div class="card-title">@Display(item.Title, "Untitled")</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="card-notes">@item.Notes</div>
                                        }

                                        @if (CanEdit)
                                        {
                                            <div class="card-resize" data-resize="@item.Id" title="Drag to change how long this runs"></div>
                                        }
                                    </article>
                                }
                            </div>
                        </div>
                        </div>
                    </section>
                }
            </div>
            </div>

            @if (_draft is not null)
            {
                <div class="planner-editor-backdrop" @onclick="TryCloseAsync"></div>
                <aside class="planner-editor" @onclick:stopPropagation="true">
                    <header>
                        <strong>@(_isNew ? "New item" : "Edit item") @(IsDirty ? "·" : "")</strong>
                        <button class="mini-btn" title="Close" @onclick="TryCloseAsync">✕</button>
                    </header>

                    @if (_conflict is not null)
                    {
                        <div class="conflict">
                            <strong>Someone else changed this</strong>
                            <p class="tiny">While this was open, it was edited elsewhere. Pick which version wins.</p>
                            <ul class="tiny">
                                @foreach (var line in _conflict.Differences)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                            <div class="conflict-actions">
                                <button class="btn btn-sm" @onclick="UseTheirsAsync">Use theirs</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => SaveAsync(force: true)">Keep mine</button>
                            </div>
                        </div>
                    }

                    <label>
                        <span>Title</span>
                        <input class="inline-edit" @bind="_draft.Title" @bind:event="oninput" />
                    </label>

                    <label>
                        <span>Notes</span>
                        <textarea class="inline-edit" rows="3" @bind="_draft.Notes" @bind:event="oninput"></textarea>
                    </label>

                    <div class="editor-row">
                        <label>
                            <span>Starts</span>
                            @* Explicit value/@onchange rather than @bind: Blazor infers TimeOnly
                               for type="time" inputs, which will not bind to a string property. *@
                            <input type="time" step="900" class="inline-edit"
                                   value="@DraftClock"
                                   @onchange="e => DraftClock = e.Value?.ToString() ?? string.Empty" />
                        </label>

                        <label>
                            <span>Runs for</span>
                            <select class="inline-edit" @bind="_draft.DurationMinutes">
                                @foreach (var minutes in DurationChoices)
                                {
                                    <option value="@minutes">@TimeText.Humanize(minutes)</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="editor-row">
                        <label>
                            <span>Category</span>
                            <select class="inline-edit" @bind="_draft.Tag">
                                @foreach (var tag in Enum.GetValues<ItineraryTag>())
                                {
                                    <option value="@tag">@TagLabel(tag)</option>
                                }
                            </select>
                        </label>

                        <label>
                            <span>Day</span>
                            <select class="inline-edit" @bind="_draft.DayId">
                                @foreach (var day in Trip.Itinerary)
                                {
                                    <option value="@day.Id">@day.Day</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="editor-nudge">
                        <span class="muted tiny">Shift the start</span>
                        <div>
                            <button class="pill-btn" @onclick="() => NudgeDraft(-15)">−15 min</button>
                            <button class="pill-btn" @onclick="() => NudgeDraft(15)">+15 min</button>
                        </div>
                        <span class="muted tiny">@TimeText.FormatRange(_draft.StartMinutes, _draft.DurationMinutes)</span>
                    </div>

                    <footer>
                        @* Nothing to delete on an item that was never saved; Cancel is that button. *@
                        @if (!_isNew)
                        {
                            <button class="btn btn-sm btn-danger-ghost" @onclick="ConfirmDeleteDraft">Delete</button>
                        }
                        <div class="spacer"></div>
                        <button class="btn btn-sm" @onclick="TryCloseAsync">Cancel</button>
                        <button class="btn btn-sm btn-gold" disabled="@(!CanSave)" @onclick="() => SaveAsync(false)">
                            @(_isNew ? "Add to the day" : IsDirty ? "Save" : "Saved")
                        </button>
                    </footer>
                </aside>
            }

            </section>

            <section class="guide-panel @(_tab == GuideTab.Menu ? "is-active" : null)" data-accent="ruby"
                     role="tabpanel" aria-label="Menu">

                @* The menu as a board: a card per day, a slot per meal. A filled slot is a meal
                   card the committee can edit in place or drag into another slot — moving grill
                   night from Saturday to Friday is one gesture, and if the target slot is taken
                   the two meals swap rather than one being eaten. *@
                <div class="menu-board">
                    @foreach (var day in MenuDaysShown)
                    {
                        <div class="menu-day" @key="day.Id">
                            <h4 class="menu-day-name">
                                <EditableText Value="@day.Day" ReadOnly="@(!CanEdit)"
                                              ValueChanged="@(v => EditMenuDayAsync(day.Id, d => d.Day = v))"
                                              Placeholder="Day" />
                            </h4>

                            @foreach (var slot in SlotsShown(day))
                            {
                                var meal = GetMeal(day, slot);
                                var isDrop = _mealHover == (day.Id, slot);

                                <div class="menu-slot @(isDrop ? "is-drop" : null) @(string.IsNullOrWhiteSpace(meal) ? "is-open" : null)"
                                     data-menu-day-id="@day.Id" data-menu-slot="@slot">
                                    <span class="menu-slot-label">@slot</span>

                                    @if (!string.IsNullOrWhiteSpace(meal))
                                    {
                                        <div class="menu-meal" data-day-id="@day.Id" data-slot="@slot">
                                            <EditableText Value="@meal" Multiline="true" ReadOnly="@(!CanEdit)"
                                                          ValueChanged="@(v => SetMealAsync(day.Id, slot, v))"
                                                          Placeholder="—" />
                                            @if (CanEdit)
                                            {
                                                <button type="button" class="menu-clear" title="Remove this meal"
                                                        @onclick="() => SetMealAsync(day.Id, slot, string.Empty)">✕</button>
                                            }
                                        </div>
                                    }
                                    else if (CanEdit)
                                    {
                                        <div class="menu-empty">
                                            <EditableText Value="" ValueChanged="@(v => SetMealAsync(day.Id, slot, v))"
                                                          Placeholder="nothing planned — click to add" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (CanEdit || Guide.Staples.Count > 0)
                {
                <div class="menu-staples">
                    <h4>All weekend</h4>
                    <div class="staple-row">
                        @foreach (var staple in Guide.Staples)
                        {
                            <span class="staple-chip" @key="staple.Id">
                                <EditableText Value="@staple.Text" ReadOnly="@(!CanEdit)"
                                              ValueChanged="@(v => EditStapleAsync(staple.Id, v))"
                                              Placeholder="—" />
                                @if (CanEdit)
                                {
                                    <button type="button" class="staple-del" title="Remove"
                                            @onclick="() => RemoveStapleAsync(staple.Id)">✕</button>
                                }
                            </span>
                        }

                        @if (CanEdit)
                        {
                            <button type="button" class="staple-chip is-add" @onclick="AddStapleAsync">+ add</button>
                        }
                    </div>
                </div>
                }

                @if (CanEdit || !string.IsNullOrWhiteSpace(Guide.MenuNote))
                {
                    <p class="menu-note">
                        <EditableText Value="@Guide.MenuNote" ReadOnly="@(!CanEdit)"
                                      ValueChanged="@(v => EditGuideAsync(g => g.MenuNote = v))"
                                      Placeholder="allergies note" />
                    </p>
                }
            </section>

            <section class="guide-panel @(_tab == GuideTab.Travel ? "is-active" : null)" data-accent="sapphire"
                     role="tabpanel" aria-label="Travel">

                @* Fixed facts, not a working document: the address is what it is, and a stray click
                   that renamed the destination would be a bad way to find that out. Only the
                   per-person rows below are editable. *@
                <div class="note-grid travel-facts">
                    <div class="card">
                        <h4>Destination</h4>
                        <p class="strong">@Travel.Destination</p>
                        @* The address line is the link. Nothing on this card is editable, so there is
                           no gesture to compete with. *@
                        <p>
                            <a class="map-line" href="@MapUrl(Travel.Address)"
                               target="_blank" rel="noopener">@Travel.Address</a>
                        </p>
                        <dl class="travel-when">
                            <dt>Check-in</dt>
                            <dd>@CheckInLine</dd>
                            <dt>Check-out</dt>
                            <dd>@CheckOutLine</dd>
                        </dl>
                    </div>
                    @* The carpools sit beside the destination rather than under it: the drive
                       times used to hold that half of the row, and a key that reads at a glance
                       is worth more there than more empty rail. *@
                    <div class="car-key">
                        <div class="car-key-head">
                            <span>Carpools</span>
                            <span class="muted tiny">Attach a color to your row to associate yourself with your car.</span>
                        </div>

                        @if (CarGroups.Count == 0)
                        {
                            <p class="muted tiny">Nobody has picked a car yet.</p>
                        }

                        @foreach (var group in CarGroups)
                        {
                            <div class="car-key-row" style="--car:@group.Color" @key="group.Slot">
                                <span class="car-key-swatch" aria-hidden="true"></span>
                                <span class="car-key-people">@string.Join(" · ", group.People)</span>
                                <span class="car-key-from">@OriginSummary(group.Slot)</span>
                            </div>
                        }

                        @if (Unassigned.Count > 0)
                        {
                            @* No roll call — two dozen names here just restated the table below.
                               This row is the legend entry for the blank swatch, nothing more. *@
                            <div class="car-key-row is-unassigned">
                                <span class="car-key-swatch" aria-hidden="true"></span>
                                <span class="car-key-people"><b>No car yet</b></span>
                            </div>
                        }
                    </div>
                </div>


                @* The palette is fixed-position and placed by JS, so it escapes the scrolling
                   panel instead of being clipped by it. The backdrop is what closes it. *@
                @if (_pickerFor is not null)
                {
                    <div class="car-backdrop" @onclick="() => _pickerFor = null"></div>

                    var picked = RowFor(_pickerFor).CarColor;
                    <div class="car-palette" data-car-pop="@_pickerFor"
                         role="group" aria-label="Pick a carpool colour">
                        <button type="button" class="car-swatch is-none"
                                title="No car" aria-label="No car"
                                @onclick="() => SetCarAsync(_pickerFor, 0)">✕</button>
                        @for (var slot = 1; slot <= CarColors.Length; slot++)
                        {
                            var pick = slot;
                            <button type="button"
                                    class="car-swatch @(picked == pick ? "is-on" : null)"
                                    style="--car:@CarColors[pick - 1]"
                                    aria-label="@($"Car {pick}")"
                                    @onclick="() => SetCarAsync(_pickerFor, pick)"></button>
                        }
                    </div>
                }

                <div class="travel-tools">
                    <span class="muted tiny">Group by</span>
                    <div class="seg" role="group" aria-label="Group the tables by">
                        <button type="button" class="seg-btn @(_groupBy == TravelGroup.Carpool ? "is-on" : null)"
                                @onclick="() => _groupBy = TravelGroup.Carpool">Carpool</button>
                        <button type="button" class="seg-btn @(_groupBy == TravelGroup.Origin ? "is-on" : null)"
                                @onclick="() => _groupBy = TravelGroup.Origin">Leaving from</button>
                    </div>
                </div>

                @* One card per group, side by side, with whoever has not answered yet in a wider
                   table of their own underneath. Splitting the roster this way is the whole point
                   of the exercise: a carpool you can read in one card is a carpool that is sorted. *@
                @if (TravelGroups.Count > 0)
                {
                    <div class="tt-row">
                        @foreach (var group in TravelGroups)
                        {
                            <TravelTable @key="group.Key"
                                         Title="@group.Title"
                                         Color="@group.Color"
                                         Compact="true"
                                         People="group.People"
                                         RowFor="RowFor"
                                         OnEdit="EditRowAsync"
                                         ColorOf="ColorOf"
                                         Origins="Origins"
                                         CustomOrigins="_customOrigins"
                                         OnCityAdded="AddCityAsync"
                                         CanEdit="true"
                                         Ascending="AscendingFor(group.Key)"
                                         OnToggleSort="@(() => ToggleSort(group.Key))"
                                         OnTogglePicker="TogglePicker" />
                        }
                    </div>
                }

                @if (Unplaced.Count > 0)
                {
                    <TravelTable Title="@UnplacedTitle"
                                 People="Unplaced"
                                 RowFor="RowFor"
                                 OnEdit="EditRowAsync"
                                 ColorOf="ColorOf"
                                 Origins="Origins"
                                 CustomOrigins="_customOrigins"
                                 OnCityAdded="AddCityAsync"
                                 CanEdit="true"
                                 Ascending="AscendingFor(UnplacedKey)"
                                 OnToggleSort="@(() => ToggleSort(UnplacedKey))"
                                 OnTogglePicker="TogglePicker" />
                }
            </section>

        </ChildContent>
    </SectionCard>

    @* The tabs above and the packing list below are two different things on one page, and with
       both sitting in identical cards they read as one long scroll. The house divider — a rule
       with the deco diamond on it — says otherwise. *@
    <div class="section-divider" aria-hidden="true"></div>

    <SectionCard Title="What to bring"
                 Subtitle="Ticked boxes are saved on this device only — nobody else sees your list.">
        <Actions>
            <span class="muted tiny">@PackedCount of @PackTotal packed</span>
            @if (PackedCount > 0)
            {
                <button class="btn btn-ghost btn-sm" @onclick="ClearPackingAsync">Reset</button>
            }
        </Actions>

        <ChildContent>
            <div class="pack-grid">
                @foreach (var group in Guide.Packing)
                {
                    <div class="card pack-group @(group.Required ? "is-required" : null)" @key="group.Id">
                        <header class="pack-head">
                            <h4>
                                @group.Title
                                @if (group.Required)
                                {
                                    <span class="pack-required-flag">everyone</span>
                                }
                            </h4>
                            @if (CanEdit)
                            {
                                <IconButton Icon="IconButtonIcon.Plus"
                                            Title="@($"Add to {group.Title}")"
                                            OnClick="@(() => AddPackItemAsync(group.Id))" />
                            }
                        </header>

                        <ul class="pack-items">
                            @foreach (var item in group.Items)
                            {
                                @* The tick and the words are separate controls now: adding from the
                                   header creates an unnamed line, so the text has to be editable —
                                   and a click cannot mean both "rename" and "packed". *@
                                <li class="pack-line @(IsPacked(item.Id) ? "is-done" : null)" @key="item.Id">
                                    <input class="pack-check" type="checkbox" id="@($"pk-{item.Id}")"
                                           checked="@IsPacked(item.Id)"
                                           @onchange="e => TogglePackedAsync(item.Id, e.Value is true)" />
                                    @if (CanEdit)
                                    {
                                        <span class="pack-text">
                                            <EditableText Value="@item.Text"
                                                          ValueChanged="@(v => EditPackItemAsync(group.Id, item.Id, v))"
                                                          Placeholder="—" />
                                        </span>
                                        <button type="button" class="pack-del" title="Remove from the list"
                                                @onclick="() => RemovePackItemAsync(group.Id, item.Id)">✕</button>
                                    }
                                    else
                                    {
                                        @* Read-only, so the label can do what a label should and
                                           let the whole line toggle the box. *@
                                        <label class="pack-text" for="@($"pk-{item.Id}")">@item.Text</label>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="card pack-group is-car">
                    <header class="pack-head">
                        <h4>What every car brings</h4>
                        @if (CanEdit)
                        {
                            <IconButton Icon="IconButtonIcon.Plus"
                                        Title="Add to what every car brings"
                                        OnClick="@(() => AddPackItemAsync(CarBringsKey))" />
                        }
                    </header>

                    <p class="muted tiny">Once your car group is set, that car is responsible for:</p>
                    <ul class="plain pack-car">
                        @for (var i = 0; i < Guide.CarBrings.Count; i++)
                        {
                            var index = i;
                            <li class="pack-line" @key="index">
                                <span class="pack-text">
                                    <EditableText Value="@Guide.CarBrings[index]" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => EditCarBringAsync(index, v))"
                                                  Placeholder="—" />
                                </span>
                                @if (CanEdit)
                                {
                                    <button type="button" class="pack-del" title="Remove"
                                            @onclick="() => RemoveCarBringAsync(index)">✕</button>
                                }
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(Guide.CarBringsNote))
                    {
                        <p class="muted tiny">@Guide.CarBringsNote</p>
                    }
                </div>
            </div>
        </ChildContent>
    </SectionCard>

    <ConfirmDialog @ref="_confirm" />
</div>

@code {
    // The page now shows the itinerary, the guest guide and the travel sheet, so it has a stake
    // in more than one area and watching all of them is the honest answer.
    protected override TripArea Watching => TripArea.All;

    // ------------------------------------------------------------------ tabs

    private enum GuideTab { Essentials, Schedule, Menu, Travel }

    private GuideTab _tab = GuideTab.Essentials;

    /// <summary>
    /// Which tab to open on, from the URL — <c>/itinerary?tab=schedule</c>. Lets a link
    /// elsewhere point at a section rather than dumping people on Essentials to go hunting.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    /// <summary>
    /// The query value already acted on. Without this the tab would snap back every time the
    /// component's parameters were set again, undoing whatever the reader had clicked.
    /// </summary>
    private string? _appliedTabQuery;

    protected override void OnParametersSet()
    {
        if (TabQuery == _appliedTabQuery) return;
        _appliedTabQuery = TabQuery;

        if (TabFromQuery(TabQuery) is { } tab) _tab = tab;
    }

    /// <summary>An unrecognised value is ignored rather than throwing — it is a URL, and URLs
    /// get typed by hand and truncated by chat apps.</summary>
    private static GuideTab? TabFromQuery(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "essentials" => GuideTab.Essentials,
        "schedule" => GuideTab.Schedule,
        "menu" => GuideTab.Menu,
        "travel" => GuideTab.Travel,
        _ => null
    };

    /// <summary>
    /// Each tab carries its own accent. Four sections of dense text all in the same gold were
    /// hard to tell apart at a glance, so the colour does the work the headings could not.
    /// </summary>
    // "Schedule", not "Itinerary" — the page is already called Itinerary, and a tab repeating
    // the page's own name reads like a folder containing itself.
    private static readonly (GuideTab Key, string Label, string Icon, string Accent)[] Tabs =
    [
        (GuideTab.Essentials, "Essentials", "◆", "gold"),
        (GuideTab.Schedule, "Schedule", "◷", "emerald"),
        (GuideTab.Menu, "Menu", "◈", "ruby"),
        (GuideTab.Travel, "Travel", "◇", "sapphire")
    ];

    private string AccentFor(GuideTab tab) => Tabs.First(t => t.Key == tab).Accent;

    private GuestGuide Guide => Trip.Guide;
    private TravelPlan Travel => Trip.Travel;

    private string TabTitle => _tab switch
    {
        GuideTab.Essentials => "The essentials",
        GuideTab.Menu => "Menu",
        GuideTab.Travel => "Getting there",
        _ => "Schedule"
    };

    private string TabSubtitle => _tab switch
    {
        GuideTab.Essentials => $"{Trip.Trip.Venue} · {Trip.Trip.Dates}",
        GuideTab.Menu => "Everything on this list is covered.",
        GuideTab.Travel => "Same color, same car. Sort it out amongst yourselves.",
        _ => SubtitleText
    };

    // ----------------------------------------------------------------- guide

    private Task EditGuideAsync(Action<GuestGuide> apply) =>
        Store.MutateAsync(t => apply(t.Guide), TripArea.All);

    /// <summary>Index-guarded inside the mutation, so a card deleted mid-edit is a no-op, not a crash.</summary>
    private Task EditFactAsync(int index, Action<GuideFact> apply) =>
        Store.MutateAsync(t =>
        {
            if (index >= 0 && index < t.Guide.Essentials.Count) apply(t.Guide.Essentials[index]);
        }, TripArea.All);

    /// <summary>One heading and the facts under it, each carrying its index in the flat list.</summary>
    private sealed record EssentialEntry(GuideFact Fact, int Index);
    private sealed record EssentialGroup(string Name, List<EssentialEntry> Facts);

    /// <summary>
    /// The essentials split under their headings, in the order the headings first appear.
    ///
    /// The list itself stays flat — grouping is a rendering concern, and keeping the storage flat
    /// means an index is still an index, so editing and removal do not need reworking every time
    /// a heading is added.
    /// </summary>
    private List<EssentialGroup> EssentialGroups
    {
        get
        {
            var groups = new List<EssentialGroup>();

            for (var i = 0; i < Guide.Essentials.Count; i++)
            {
                var fact = Guide.Essentials[i];
                var name = string.IsNullOrWhiteSpace(fact.Group) ? "Other" : fact.Group.Trim();

                var group = groups.FirstOrDefault(g =>
                    g.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

                if (group is null)
                {
                    group = new EssentialGroup(name, []);
                    groups.Add(group);
                }

                group.Facts.Add(new EssentialEntry(fact, i));
            }

            return groups;
        }
    }

    /// <summary>
    /// Added at the end of its own heading rather than the end of the list, so a new Logistics
    /// line does not appear underneath the bathrooms.
    /// </summary>
    private Task AddFactAsync(string group) =>
        EditGuideAsync(g =>
        {
            var fact = new GuideFact { Group = group, Label = "New", Value = "" };
            var last = g.Essentials.FindLastIndex(f =>
                f.Group.Equals(group, StringComparison.OrdinalIgnoreCase));

            if (last >= 0) g.Essentials.Insert(last + 1, fact);
            else g.Essentials.Add(fact);
        });

    // ---------------------------------------------------------------- nearby

    private Task EditStoreAsync(int index, Action<NearbyPlace> apply) =>
        Store.MutateAsync(t =>
        {
            if (index >= 0 && index < t.Venue.Stores.Count) apply(t.Venue.Stores[index]);
        }, TripArea.Venue);

    private Task AddStoreAsync() =>
        Store.MutateAsync(t => t.Venue.Stores.Add(new NearbyPlace { Name = "New", Distance = "" }),
            TripArea.Venue);

    private Task RemoveStoreAsync(int index) =>
        Store.MutateAsync(t =>
        {
            if (index >= 0 && index < t.Venue.Stores.Count) t.Venue.Stores.RemoveAt(index);
        }, TripArea.Venue);

    private Task RemoveFactAsync(int index) =>
        EditGuideAsync(g =>
        {
            if (index >= 0 && index < g.Essentials.Count) g.Essentials.RemoveAt(index);
        });

    /// <summary>The card that earns the map pin — the one that says where the house is.</summary>
    private static bool IsWhereFact(GuideFact fact) =>
        fact.Label.Trim().Equals("Where", StringComparison.OrdinalIgnoreCase);

    /// <summary>The map link for a fact, when it is the one that names where the house is.</summary>
    private string? MapHrefFor(GuideFact fact) =>
        IsWhereFact(fact) && !string.IsNullOrWhiteSpace(Travel.Address) ? MapUrl(Travel.Address) : null;

    private static string MapUrl(string address) =>
        "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(address);

    // ------------------------------------------------------------------ menu

    private static readonly string[] MealSlots = ["breakfast", "lunch", "dinner"];

    /// <summary>Which slot the dragged meal is hovering, so it can light up.</summary>
    private (string DayId, string Slot)? _mealHover;

    /// <summary>
    /// The menu as this person should see it. A guest gets the plan, not the gaps in it: an
    /// empty slot is a note the committee left itself, and a day with nothing in it yet reads
    /// like the kitchen is closed rather than like nobody has decided.
    /// </summary>
    private IEnumerable<MenuDay> MenuDaysShown =>
        CanEdit ? Guide.MenuDays : Guide.MenuDays.Where(HasAnyMeal);

    private IEnumerable<string> SlotsShown(MenuDay day) =>
        CanEdit ? MealSlots : MealSlots.Where(s => !string.IsNullOrWhiteSpace(GetMeal(day, s)));

    private static bool HasAnyMeal(MenuDay day) =>
        MealSlots.Any(s => !string.IsNullOrWhiteSpace(GetMeal(day, s)));

    private static string GetMeal(MenuDay day, string slot) => slot switch
    {
        "breakfast" => day.Breakfast,
        "lunch" => day.Lunch,
        _ => day.Dinner
    };

    private static void SetMeal(MenuDay day, string slot, string value)
    {
        switch (slot)
        {
            case "breakfast": day.Breakfast = value; break;
            case "lunch": day.Lunch = value; break;
            default: day.Dinner = value; break;
        }
    }

    private Task EditMenuDayAsync(string dayId, Action<MenuDay> apply) =>
        Store.MutateAsync(t =>
        {
            if (t.Guide.MenuDays.FirstOrDefault(d => d.Id == dayId) is { } day) apply(day);
        }, TripArea.All);

    private Task SetMealAsync(string dayId, string slot, string value) =>
        EditMenuDayAsync(dayId, d => SetMeal(d, slot, value.Trim()));

    /// <summary>
    /// A meal landed on another slot. Occupied targets swap rather than being overwritten,
    /// because "put grill night where Friday dinner is" almost always means trading the two —
    /// and a swap never destroys anything, which matters for a gesture this easy to fumble.
    /// </summary>
    [JSInvokable]
    public Task MealDropped(string fromDayId, string fromSlot, string toDayId, string toSlot) =>
        Store.MutateAsync(t =>
        {
            var from = t.Guide.MenuDays.FirstOrDefault(d => d.Id == fromDayId);
            var to = t.Guide.MenuDays.FirstOrDefault(d => d.Id == toDayId);
            if (from is null || to is null) return;

            var moving = GetMeal(from, fromSlot);
            if (string.IsNullOrWhiteSpace(moving)) return;

            var displaced = GetMeal(to, toSlot);
            SetMeal(to, toSlot, moving);
            SetMeal(from, fromSlot, displaced);
        }, TripArea.All);

    [JSInvokable]
    public Task MealHover(string? dayId, string? slot)
    {
        _mealHover = dayId is null || slot is null ? null : (dayId, slot);
        return InvokeAsync(StateHasChanged);
    }

    private Task AddStapleAsync() =>
        EditGuideAsync(g => g.Staples.Add(new MenuStaple { Id = Ids.New("staple"), Text = "New" }));

    private Task EditStapleAsync(string id, string value) =>
        EditGuideAsync(g =>
        {
            if (g.Staples.FirstOrDefault(s => s.Id == id) is { } staple) staple.Text = value;
        });

    private Task RemoveStapleAsync(string id) =>
        EditGuideAsync(g => g.Staples.RemoveAll(s => s.Id == id));

    // ---------------------------------------------------------------- travel

    private Task EditTravelAsync(Action<TravelPlan> apply) =>
        Store.MutateAsync(t => apply(t.Travel), TripArea.Travel);

    /// <summary>
    /// The row for a person, or a blank stand-in. Reading the table must not write to it — a row
    /// is only ever created once somebody actually types something.
    /// </summary>
    private TravelRow RowFor(string personId) =>
        Travel.Rows.FirstOrDefault(r => r.PersonId == personId) ?? new TravelRow { PersonId = personId };

    /// <summary>
    /// Edit a person's row, creating it on first use and dropping it again once every field has
    /// been cleared, so the file does not fill with empty records.
    /// </summary>
    private Task EditRowAsync(string personId, Action<TravelRow> apply) =>
        Store.MutateAsync(t =>
        {
            var row = t.Travel.Rows.FirstOrDefault(r => r.PersonId == personId);
            if (row is null)
            {
                row = new TravelRow { PersonId = personId };
                t.Travel.Rows.Add(row);
            }

            apply(row);

            if (row.IsEmpty) t.Travel.Rows.Remove(row);
        }, TripArea.Travel);

    /// <summary>
    /// The dates come from the trip itself rather than being typed alongside the times, so a
    /// check-in date can never drift from the weekend the rest of the site is running on.
    /// </summary>
    private string CheckInLine => WhenLine(Trip.Trip.StartsAt, Travel.CheckInTime);
    private string CheckOutLine => WhenLine(Trip.Trip.EndsAt, Travel.CheckOutTime);

    private static string WhenLine(DateTimeOffset date, string time)
    {
        var day = date.ToString("dddd, MMMM d");
        return string.IsNullOrWhiteSpace(time) ? day : $"{day} · {time}";
    }

    /// <summary>One carpool: its colour, and — the part that matters — who is in it.</summary>
    private sealed record CarGroup(int Slot, string Color, List<string> People);

    /// <summary>Whose colour picker is open, if any. View state; nothing to save.</summary>
    private string? _pickerFor;

    private void TogglePicker(string personId) =>
        _pickerFor = _pickerFor == personId ? null : personId;

    private async Task SetCarAsync(string personId, int slot)
    {
        _pickerFor = null;
        await EditRowAsync(personId, r => r.CarColor = slot);
    }

    /// <summary>
    /// The spreadsheet asked everyone to highlight their car in a matching colour by hand, which
    /// only works if everyone picks the same shade. Here the name picks the colour, in the order
    /// the cars first appear down the roster, so a car keeps its colour as rows are filled in.
    ///
    /// Twelve colours because four was not enough the moment people split into small cars, and
    /// the list wraps rather than running out.
    /// </summary>
    private static readonly string[] CarColors =
    [
        "#d4af37", "#2e9e7e", "#c94f5a", "#4a7fd6", "#b07cc6",
        "#d98c3f", "#4fb0a5", "#c96f9b", "#8fb339", "#e0736d"
    ];

    /// <summary>The colour for a slot, or nothing for the unassigned zero.</summary>
    private static string ColorOf(int slot) =>
        slot >= 1 && slot <= CarColors.Length ? CarColors[slot - 1] : "transparent";

    /// <summary>
    /// Every carpool in use, in palette order, with the people in it. Slots nobody picked simply
    /// do not appear — the key is a list of the cars that exist, not of the ten available.
    /// </summary>
    private List<CarGroup> CarGroups
    {
        get
        {
            var groups = new List<CarGroup>();

            for (var slot = 1; slot <= CarColors.Length; slot++)
            {
                // Alphabetical, matching the table this key sits above — roster order here and
                // sorted order there made the two look like different groups.
                var people = Trip.Roster
                    .Where(p => RowFor(p.Id).CarColor == slot)
                    .Select(p => p.Name)
                    .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (people.Count > 0) groups.Add(new CarGroup(slot, ColorOf(slot), people));
            }

            return groups;
        }
    }

    /// <summary>Who still has no car. The whole point of the sheet is getting this to empty.</summary>
    private List<string> Unassigned =>
        Trip.Roster.Where(p => RowFor(p.Id).CarColor == 0).Select(p => p.Name).ToList();

    // ---------------------------------------------------------- travel sort

    private enum TravelGroup { Carpool, Origin }

    /// <summary>Which fact splits the roster into tables.</summary>
    private TravelGroup _groupBy = TravelGroup.Carpool;

    /// <summary>Shared by every table on the page — one header click sorts all of them.</summary>
    /// <summary>
    /// Sort direction per table, keyed by the table's own key.
    ///
    /// One shared flag made every card on the page flip together, which is not what a header on
    /// an individual table means — sorting Car 1 should leave Car 2 alone.
    /// </summary>
    private readonly Dictionary<string, bool> _sortAscending = new(StringComparer.Ordinal);

    /// <summary>Ascending until somebody says otherwise.</summary>
    private bool AscendingFor(string key) => _sortAscending.GetValueOrDefault(key, true);

    private void ToggleSort(string key) => _sortAscending[key] = !AscendingFor(key);

    /// <summary>The key the leftovers table sorts under. Its contents change with the grouping,
    /// but it is the same table either way, so it keeps one direction.</summary>
    private const string UnplacedKey = "unplaced";

    /// <summary>People who chose "somewhere else" and have not typed a city yet.</summary>
    private readonly HashSet<string> _customOrigins = new(StringComparer.Ordinal);

    /// <summary>
    /// Sets a city somebody typed into their own row.
    ///
    /// Nothing else has to happen for it to become an option for everybody: the dropdown is built
    /// from the cities the roster is actually leaving from, so writing it on one row is what puts
    /// it in front of the next person from the same place — and stops two spellings becoming two
    /// tables.
    /// </summary>
    private Task AddCityAsync(string personId, string city)
    {
        var trimmed = city.Trim();

        return Store.MutateAsync(t =>
        {
            var row = t.Travel.Rows.FirstOrDefault(r => r.PersonId == personId);
            if (row is null)
            {
                row = new TravelRow { PersonId = personId };
                t.Travel.Rows.Add(row);
            }

            row.LeavingFrom = trimmed;
        }, TripArea.Itinerary);
    }

    /// <summary>
    /// The cities in play, alphabetised for the dropdown.
    ///
    /// Read off the roster rather than kept as a separate list. There is nothing to maintain, a
    /// city appears the moment somebody says they are coming from there, and it leaves when the
    /// last person from there changes their mind — which is the honest answer to "where is anyone
    /// setting off from".
    /// </summary>
    private IReadOnlyList<string> Origins =>
        Trip.Roster
            .Select(p => RowFor(p.Id).LeavingFrom.Trim())
            .Where(c => c.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();

    /// <summary>The cities a carpool is setting off from.</summary>
    private string OriginSummary(int slot)
    {
        var cities = Trip.Roster
            .Where(p => RowFor(p.Id).CarColor == slot)
            .Select(p => RowFor(p.Id).LeavingFrom.Trim())
            .Where(c => c.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();

        return string.Join(" · ", cities);
    }

    /// <summary>Sorted by the direction belonging to <paramref name="key"/>, not a shared one.</summary>
    private List<RosterPerson> ByName(string key, IEnumerable<RosterPerson> people)
    {
        var sorted = people.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase);
        return (AscendingFor(key) ? sorted : sorted.Reverse()).ToList();
    }

    /// <summary>One table's worth of people, and how to head it.</summary>
    private sealed record TravelSection(string Key, string Title, string? Color, List<RosterPerson> People);

    /// <summary>
    /// The roster split into cards. Grouping by carpool gives a card per colour in use; grouping
    /// by city gives a card per departure point. Either way the people who have not answered
    /// that question yet are held back for <see cref="Unplaced"/>.
    /// </summary>
    private List<TravelSection> TravelGroups
    {
        get
        {
            if (_groupBy == TravelGroup.Carpool)
            {
                return CarGroups
                    .Select(g =>
                    {
                        var key = $"car-{g.Slot}";
                        return new TravelSection(key, "Car", g.Color,
                            ByName(key, Trip.Roster.Where(p => RowFor(p.Id).CarColor == g.Slot)));
                    })
                    .ToList();
            }

            return Trip.Roster
                .Select(p => RowFor(p.Id).LeavingFrom.Trim())
                .Where(c => c.Length > 0)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
                .Select(city =>
                {
                    var key = $"city-{city}";
                    return new TravelSection(key, city, null,
                        ByName(key, Trip.Roster.Where(p =>
                            RowFor(p.Id).LeavingFrom.Trim().Equals(city, StringComparison.OrdinalIgnoreCase))));
                })
                .ToList();
        }
    }

    /// <summary>Whoever the current grouping has nothing to say about.</summary>
    private List<RosterPerson> Unplaced => ByName(UnplacedKey, _groupBy == TravelGroup.Carpool
        ? Trip.Roster.Where(p => RowFor(p.Id).CarColor == 0)
        : Trip.Roster.Where(p => RowFor(p.Id).LeavingFrom.Trim().Length == 0));

    private string UnplacedTitle =>
        _groupBy == TravelGroup.Carpool ? "No car yet" : "No departure city yet";



    // --------------------------------------------------------------- packing

    /// <summary>
    /// Which items this person has ticked. Held here for rendering and mirrored into the
    /// browser's own storage — it is never written to trip.json, because one shared set of
    /// checkboxes across twenty-six people would be useless to all of them.
    /// </summary>
    private readonly HashSet<string> _packed = new(StringComparer.Ordinal);

    private IJSObjectReference? _packing;

    private int PackTotal => Guide.Packing.Sum(g => g.Items.Count);

    /// <summary>Counted against the list as it stands, so a removed item cannot inflate it.</summary>
    private int PackedCount => Guide.Packing.SelectMany(g => g.Items).Count(i => _packed.Contains(i.Id));

    private bool IsPacked(string id) => _packed.Contains(id);

    private async Task TogglePackedAsync(string id, bool packed)
    {
        if (packed) _packed.Add(id); else _packed.Remove(id);
        await SavePackingAsync();
    }

    private async Task ClearPackingAsync()
    {
        _packed.Clear();
        await SavePackingAsync();
    }

    private async Task SavePackingAsync()
    {
        if (_packing is null) return;
        try { await _packing.InvokeVoidAsync("save", _packed); } catch (JSDisconnectedException) { }
    }

    // -------------------------------------------------------- packing edits

    /// <summary>The car card shares the add plumbing under this stand-in key.</summary>
    private const string CarBringsKey = "car-brings";

    /// <summary>
    /// Add an unnamed line for somebody to type over, the same way the essentials cards work.
    /// The add box that used to sit under each list is gone: one control per card, in the
    /// header, and the naming happens in place.
    /// </summary>
    private async Task AddPackItemAsync(string key)
    {
        if (key == CarBringsKey)
        {
            await EditGuideAsync(g => g.CarBrings.Add("New"));
            return;
        }

        // A fresh id, minted once and stored — the ticked-box memory in everyone's browser is
        // keyed on it, so it must never be derived from anything that could change.
        await EditGuideAsync(g =>
        {
            if (g.Packing.FirstOrDefault(x => x.Id == key) is { } group)
                group.Items.Add(new PackItem { Id = Ids.New("pk"), Text = "New" });
        });
    }

    /// <summary>Renaming leaves the id alone, so a ticked box stays ticked through an edit.</summary>
    private Task EditPackItemAsync(string groupId, string itemId, string text) =>
        EditGuideAsync(g =>
        {
            if (g.Packing.FirstOrDefault(x => x.Id == groupId) is { } group &&
                group.Items.FirstOrDefault(i => i.Id == itemId) is { } item)
            {
                item.Text = text;
            }
        });

    private Task EditCarBringAsync(int index, string text) =>
        EditGuideAsync(g =>
        {
            if (index >= 0 && index < g.CarBrings.Count) g.CarBrings[index] = text;
        });

    private Task RemovePackItemAsync(string groupId, string itemId) =>
        EditGuideAsync(g =>
        {
            if (g.Packing.FirstOrDefault(x => x.Id == groupId) is { } group)
                group.Items.RemoveAll(i => i.Id == itemId);
        });

    private Task RemoveCarBringAsync(int index) =>
        EditGuideAsync(g =>
        {
            if (index >= 0 && index < g.CarBrings.Count) g.CarBrings.RemoveAt(index);
        });

    private const int MinZoom = 40;
    private const int MaxZoom = 112;
    // Two stacked lines need about this much room. Anything shorter than roughly half an hour
    // renders at this floor rather than becoming an unreadable sliver.
    private const double MinCardPixels = 32;

    private static readonly int[] DurationChoices =
        [15, 30, 45, 60, 90, 120, 150, 180, 240, 300, 360];

    private ConfirmDialog? _confirm;
    private string? _activeDayId;

    /// <summary>
    /// The stored zoom, clamped on the way out. A hand-edited trip.json could carry anything —
    /// a zero would collapse every hour band to nothing — so the page never trusts the number
    /// it reads, only the range.
    /// </summary>
    private int PxPerHour => Math.Clamp(Trip.PlannerPxPerHour, MinZoom, MaxZoom);

    /// <summary>The day taking the whole stage, or null for the three-across overview.</summary>
    private string? _focusDayId;

    /// <summary>Resolved against the trip, so a focused day that gets deleted falls back to the overview.</summary>
    private ItineraryDay? FocusDay => Trip.Itinerary.FirstOrDefault(d => d.Id == _focusDayId);

    /// <summary>Gap band keys the user has opened out, per day.</summary>
    private readonly Dictionary<string, HashSet<string>> _expanded = [];

    // --- the editor's working copy -----------------------------------------
    // Nothing here touches the trip until Save is pressed. _pristine is the copy the form
    // opened with, so "is this dirty?" is a comparison rather than a pile of change flags.
    private Draft? _draft;
    private Draft? _pristine;

    /// <summary>The draft describes an item that is not in the trip yet.</summary>
    private bool _isNew;
    private ConflictInfo? _conflict;

    private IJSObjectReference? _module;
    private IJSObjectReference? _menuJs;
    private IJSObjectReference? _popover;
    private DotNetObjectReference<Itinerary>? _self;

    private string SubtitleText => CanEdit
        ? "Drag a card to move it, or drag its bottom edge to change how long it runs. Click a card to edit the details."
        : "The plan for the weekend. The committee keeps this up to date.";

    private string? ActiveDayId => _activeDayId ?? Trip.Itinerary.FirstOrDefault()?.Id;

    /// <summary>Whether closing now would lose something somebody typed.</summary>
    private bool IsDirty => _draft is not null && _pristine is not null && !_draft.SameAs(_pristine);

    /// <summary>
    /// Whether Save has anything to do. A new item always has — it does not exist yet — which is
    /// a different question from <see cref="IsDirty"/>: pressing plus and then Cancel without
    /// typing anything should not stop to ask what to discard.
    /// </summary>
    private bool CanSave => _draft is not null && (_isNew || IsDirty);

    // ------------------------------------------------------------- timeline

    private TimelineSettings Settings => new() { PxPerHour = PxPerHour };

    /// <summary>
    /// The day as this viewer may see it. For the committee that is simply the day; for everyone
    /// else adjacent games collapse into one anonymous block, so the schedule does not announce
    /// what is being played days in advance.
    ///
    /// A whole day rather than just its items, because the timeline draws its hour window and its
    /// collapsible gaps from the day — given the real one it would offer to collapse a gap that
    /// the merged block now covers.
    /// </summary>
    private ItineraryDay ViewOf(ItineraryDay day) => CanEdit ? day : new ItineraryDay
    {
        Id = day.Id,
        Day = day.Day,
        Date = day.Date,
        WindowStartMinutes = day.WindowStartMinutes,
        WindowEndMinutes = day.WindowEndMinutes,
        Items = GuestSchedule.Screen(day.Items)
    };

    private DayTimeline TimelineFor(ItineraryDay day) =>
        DayTimeline.Build(day, Settings, ExpandedFor(day.Id));

    private HashSet<string> ExpandedFor(string dayId) =>
        _expanded.TryGetValue(dayId, out var set) ? set : [];

    private IEnumerable<TimelineBand> ExpandedGapBands(ItineraryDay day, DayTimeline timeline)
    {
        var open = ExpandedFor(day.Id);
        return open.Count == 0
            ? []
            : timeline.Bands.Where(b => b.Kind == BandKind.Expanded && open.Contains(b.Key));
    }

    private bool AnyCollapsed => Trip.Itinerary
        .Any(d => TimelineFor(d).Bands.Any(b => b.Kind == BandKind.Collapsed));

    private void ToggleGap(string dayId, string bandKey)
    {
        var set = _expanded.TryGetValue(dayId, out var existing) ? existing : _expanded[dayId] = [];
        if (!set.Remove(bandKey)) set.Add(bandKey);
    }

    private void ToggleAllGaps()
    {
        if (AnyCollapsed)
        {
            foreach (var day in Trip.Itinerary)
            {
                var set = _expanded.TryGetValue(day.Id, out var existing) ? existing : _expanded[day.Id] = [];
                foreach (var band in TimelineFor(day).Bands.Where(b => b.Kind == BandKind.Collapsed))
                    set.Add(band.Key);
            }
        }
        else
        {
            _expanded.Clear();
        }
    }

    /// <summary>
    /// Zooming is a saved edit now, not a page setting — so it survives a reload and everyone
    /// looking at the schedule sees the same one.
    /// </summary>
    private Task ZoomAsync(int direction)
    {
        var next = Math.Clamp(PxPerHour + direction * 16, MinZoom, MaxZoom);
        if (next == Trip.PlannerPxPerHour) return Task.CompletedTask;

        return Store.MutateAsync(t => t.PlannerPxPerHour = next, TripArea.Itinerary);
    }

    // --------------------------------------------------------- editor form

    private void OpenEditor(ItineraryItem item)
    {
        _isNew = false;
        if (!CanEdit) return;

        var day = ItineraryService.Locate(Trip, item.Id).Day;
        if (day is null) return;

        _draft = Draft.From(item, day.Id);
        _pristine = _draft.Copy();
        _conflict = null;
    }

    private void CloseEditor()
    {
        _isNew = false;
        _draft = null;
        _pristine = null;
        _conflict = null;
    }

    private Task TryCloseAsync()
    {
        if (!IsDirty)
        {
            CloseEditor();
            return Task.CompletedTask;
        }

        _confirm?.Show("Close without saving? Your changes to this item will be lost.",
            () => { CloseEditor(); StateHasChanged(); return Task.CompletedTask; },
            "Discard changes", "Unsaved changes");

        return Task.CompletedTask;
    }

    private string DraftClock
    {
        get
        {
            var m = (_draft?.StartMinutes ?? ItineraryItem.DefaultStartMinutes) % TimeText.Day;
            return $"{m / 60:00}:{m % 60:00}";
        }
        set
        {
            if (_draft is null || !TimeOnly.TryParse(value, out var clock)) return;

            // A browser time input has no concept of "1am belongs to last night", so anything
            // before the 6am anchor is pushed into the small hours of the same planner day.
            var minutes = clock.Hour * 60 + clock.Minute;
            if (minutes < TimeText.DayAnchor) minutes += TimeText.Day;
            _draft.StartMinutes = ItineraryService.ClampStart(minutes);
        }
    }

    private void NudgeDraft(int deltaMinutes)
    {
        if (_draft is null) return;
        _draft.StartMinutes = ItineraryService.ClampStart(TimeText.Snap(_draft.StartMinutes + deltaMinutes));
    }

    private async Task SaveAsync(bool force)
    {
        if (_draft is null) return;

        var edit = _draft.ToEdit();
        var creating = _isNew;

        var outcome = SaveOutcome.Saved;
        await MutateAsync(t => outcome = creating
            ? ItineraryService.CreateItem(t, edit)
            : ItineraryService.ApplyEdit(t, edit, force));

        switch (outcome)
        {
            case SaveOutcome.Saved:
                // Saving is the end of the interaction — leaving the panel open over the grid
                // just hides the change you came to make.
                CloseEditor();
                Toasts.Show("Saved", CharterTrip.Web.Services.ToastKind.Good);
                break;

            case SaveOutcome.Conflict:
                var theirs = ItineraryService.Locate(Trip, _draft.ItemId).Item;
                _conflict = theirs is null ? null : ConflictInfo.Between(_draft, theirs, Trip);
                break;

            case SaveOutcome.Missing:
                Toasts.Show("That item was deleted by someone else", CharterTrip.Web.Services.ToastKind.Bad);
                CloseEditor();
                break;
        }
    }

    /// <summary>Throw away the local edits and reload the form from whatever is current.</summary>
    private Task UseTheirsAsync()
    {
        if (_draft is null) return Task.CompletedTask;

        var (day, item) = ItineraryService.Locate(Trip, _draft.ItemId);
        if (day is null || item is null)
        {
            CloseEditor();
            return Task.CompletedTask;
        }

        _draft = Draft.From(item, day.Id);
        _pristine = _draft.Copy();
        _conflict = null;
        return Task.CompletedTask;
    }

    private void CardKey(KeyboardEventArgs e, ItineraryItem item)
    {
        if (!CanEdit) return;
        if (e.Key is "Enter" or " ") OpenEditor(item);
    }

    // ------------------------------------------------------- adding, removing

    private Task RenameDayAsync(string dayId, string value) => MutateAsync(t =>
    {
        var day = ItineraryService.FindDay(t, dayId);
        if (day is not null) day.Day = value;
    });

    private Task SetDayDateAsync(string dayId, string value) => MutateAsync(t =>
    {
        var day = ItineraryService.FindDay(t, dayId);
        if (day is not null) day.Date = value;
    });

    /// <summary>
    /// Opens the editor on an item that does not exist yet.
    ///
    /// It used to be written to the trip first and edited afterwards, which meant pressing plus
    /// and then Cancel left "New item" sitting on the schedule to be deleted by hand. The draft
    /// is the only copy until Save.
    /// </summary>
    private void AddItem(string dayId)
    {
        if (!CanEdit) return;

        _conflict = null;
        _isNew = true;
        _draft = Draft.ForNewItem(dayId);
        _pristine = _draft.Copy();
    }

    private void ConfirmDeleteDraft()
    {
        if (_draft is null) return;

        // An item that was never saved has nothing to delete — discarding the draft is the whole
        // of it, and asking "are you sure?" about something nobody else can see is theatre.
        if (_isNew)
        {
            CloseEditor();
            return;
        }

        var id = _draft.ItemId;
        var title = Display(_draft.Title, "this item");

        _confirm?.Show($"Delete “{title}”?", async () =>
        {
            CloseEditor();
            await MutateAsync(t => ItineraryService.RemoveItem(t, id));
        }, "Delete");
    }

    private void ConfirmDeleteDay(ItineraryDay day) =>
        _confirm?.Show($"Delete {Display(day.Day, "this day")}?",
            () => MutateAsync(t => ItineraryService.RemoveDay(t, day.Id)), "Delete");

    // ------------------------------------------------------- drag and resize
    // The browser reports pixels; the conversion to minutes happens here, because collapsed
    // bands make that mapping non-linear and DayTimeline is the one place that knows about them.
    //
    // Dragging stays immediate rather than joining the save model — direct manipulation that
    // needed a separate confirmation would be its own kind of strange.

    [JSInvokable]
    public async Task ItemDropped(string itemId, string dayId, double topPixels, string? ontoItemId)
    {
        if (!string.IsNullOrEmpty(ontoItemId) && ontoItemId != itemId)
        {
            await MutateAsync(t => ItineraryService.SwapSlots(t, itemId, ontoItemId));
            return;
        }

        var day = ItineraryService.FindDay(Trip, dayId);
        if (day is null) return;

        var minutes = TimeText.Snap(TimelineFor(day).ToMinutes(topPixels));
        await MutateAsync(t => ItineraryService.MoveToDay(t, itemId, dayId, minutes));
    }

    [JSInvokable]
    public async Task ItemResized(string itemId, double bottomPixels)
    {
        var (day, item) = ItineraryService.Locate(Trip, itemId);
        if (day is null || item is null) return;

        var end = TimeText.Snap(TimelineFor(day).ToMinutes(bottomPixels));
        await MutateAsync(t => ItineraryService.SetDuration(t, itemId, end - item.StartMinutes));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Placed after every render, not just when it opens: the panel behind it can scroll or
        // reflow while the palette is up, and a stale position is worse than none.
        if (_pickerFor is not null && _popover is not null)
        {
            try { await _popover.InvokeVoidAsync("placeCarPalette"); }
            catch (JSDisconnectedException) { }
        }

        if (!firstRender) return;

        // The ticked boxes can only be read once there is a browser to read them from, so the
        // list renders unticked for one frame and then fills in. Cheaper than blocking the page
        // on interop, and nobody is looking at their packing list in the first 30ms.
        try
        {
            _popover = await JS.InvokeAsync<IJSObjectReference>("import", "./js/popover.js");
            _packing = await JS.InvokeAsync<IJSObjectReference>("import", "./js/packing.js");
            var saved = await _packing.InvokeAsync<string[]>("load");

            _packed.Clear();
            foreach (var id in saved) _packed.Add(id);

            StateHasChanged();
        }
        catch (JSDisconnectedException) { }

        if (!CanEdit) return;

        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/planner.js");
        await _module.InvokeVoidAsync("init", _self);

        // The menu board's drag lives in its own module: it targets .menu-meal where the planner
        // targets .planner-card, so the two document-level listeners never fight over a pointer.
        _menuJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/menu.js");
        await _menuJs.InvokeVoidAsync("init", _self);
    }

