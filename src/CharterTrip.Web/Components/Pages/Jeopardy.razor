@page "/games/jeopardy"
@using CharterTrip.Core.Services
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CharterTrip.Web.Services.ToastService Toasts

<PageTitle>Jeopardy · Charter Trip 2026</PageTitle>

@* The games and the roster are the committee's working area, not part of what a
   guest came here for. AdminOnly guards the page itself, so typing the URL lands
   on the same polite refusal as following a link that is not in their menu. *@
<AdminOnly>
<div class="jeo-root @(IsTitleCard ? "is-title" : null)">

@if (IsEditingBoard)
{
    <section class="jeo-editor">

        <header class="jeo-editor-head">
            <div>
                <p class="jeo-kicker">Editing the board</p>
                <h2 class="jeo-editor-title">
                    <EditableText Value="@Board.Title" ValueChanged="SetBoardTitleAsync"
                                  Placeholder="Board title" />
                </h2>
            </div>
            <button class="btn btn-gold" @onclick="() => _editingBoard = false">Done</button>
        </header>

        <p class="jeo-hint">
            Click any line to change it; edits save as soon as you leave the field.
            A clue with no text and nothing attached stays greyed out on the board.
        </p>

        @for (var i = 0; i < Board.Categories.Count; i++)
        {
            var index = i;                       // the loop variable is shared; the handlers are not
            var category = Board.Categories[i];

            <section class="jeo-editor-cat" @key="category">
                <h3 class="jeo-editor-catname">
                    <EditableText Value="@category.Name"
                                  ValueChanged="@(v => SetCategoryNameAsync(index, v))"
                                  Placeholder="Category" />
                </h3>

                @foreach (var clue in category.Clues)
                {
                    <div class="jeo-editor-clue @(clue.IsEmpty ? "is-empty" : null)" @key="clue.Id">
                        <input class="inline-edit jeo-editor-value" type="number" min="0" step="5"
                               aria-label="Points" value="@clue.Value"
                               @onchange="@(e => SetClueValueAsync(clue.Id, e.Value?.ToString()))" />

                        <div class="jeo-editor-fields">
                            <div class="jeo-editor-field">
                                <span class="jeo-editor-label">Clue</span>
                                <EditableText Value="@clue.Clue" Multiline="true"
                                              ValueChanged="@(v => EditClueAsync(clue.Id, c => c.Clue = v))"
                                              Placeholder="what goes up on the board" />
                            </div>
                            <div class="jeo-editor-field">
                                <span class="jeo-editor-label">Answer</span>
                                <EditableText Value="@clue.Response" Multiline="true"
                                              ValueChanged="@(v => EditClueAsync(clue.Id, c => c.Response = v))"
                                              Placeholder="what the host is looking for" />
                            </div>
                            <div class="jeo-editor-field is-aside">
                                <span class="jeo-editor-label">Clue image / video</span>
                                <MediaField Value="@clue.ClueImage" Label="Clue image"
                                            ValueChanged="@(v => EditClueAsync(clue.Id, c => c.ClueImage = v))" />
                            </div>
                            <div class="jeo-editor-field is-aside">
                                <span class="jeo-editor-label">Answer image / video</span>
                                <MediaField Value="@clue.ResponseImage" Label="Answer image"
                                            ValueChanged="@(v => EditClueAsync(clue.Id, c => c.ResponseImage = v))" />
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <section class="jeo-editor-cat is-final">
            <h3 class="jeo-editor-catname">
                <EditableText Value="@Board.Final.Category"
                              ValueChanged="@(v => EditFinalAsync(f => f.Category = v))"
                              Placeholder="Final Jeopardy" />
            </h3>

            <div class="jeo-editor-clue">
                <input class="inline-edit jeo-editor-value" type="number" min="0" step="5"
                       aria-label="Final points" value="@Board.Final.Value"
                       @onchange="@(e => SetFinalValueAsync(e.Value?.ToString()))" />

                <div class="jeo-editor-fields">
                    <div class="jeo-editor-field">
                        <span class="jeo-editor-label">Clue</span>
                        <EditableText Value="@Board.Final.Clue" Multiline="true"
                                      ValueChanged="@(v => EditFinalAsync(f => f.Clue = v))"
                                      Placeholder="the final clue" />
                    </div>
                    <div class="jeo-editor-field">
                        <span class="jeo-editor-label">Answer</span>
                        <EditableText Value="@Board.Final.Response" Multiline="true"
                                      ValueChanged="@(v => EditFinalAsync(f => f.Response = v))"
                                      Placeholder="what the host is looking for" />
                    </div>
                </div>
            </div>
        </section>

        <div class="jeo-title-actions">
            <button class="btn btn-gold" @onclick="() => _editingBoard = false">Done editing</button>
        </div>
    </section>
}
else if (Game.Phase == JeopardyPhase.NotStarted)
{
    <section class="jeo-title">
        <p class="jeo-kicker">4th Annual Charter Trip</p>
        <h1>JEOPARDY</h1>

        <div class="jeo-join">
            @foreach (var team in Trip.Teams)
            {
                <div class="jeo-join-card" style="--team:@team.Color">
                    <span class="jeo-join-team">@team.Name</span>
                    <QrImage Content="@BuzzUrl(CodeFor(team.Id))" Size="150" Alt="@($"Buzzer for {team.Name}")" />
                    <span class="jeo-code">@CodeFor(team.Id)</span>
                </div>
            }
            <div class="jeo-join-card is-host">
                <span class="jeo-join-team">Host — answers</span>
                <QrImage Content="@BuzzUrl(Game.HostCode)" Size="150" Alt="Host answer sheet" />
                <span class="jeo-code">@Game.HostCode</span>
            </div>
        </div>

        <p class="jeo-hint">Scan a code, or go to <b>@JoinHost/login</b> and type it in.</p>

        @if (CanEdit)
        {
            <div class="jeo-title-actions">
                <button class="btn btn-gold btn-lg" @onclick="BeginAsync">Start the game</button>
                <button class="btn btn-ghost btn-sm" @onclick="() => _editingBoard = true">Edit questions</button>
                <button class="btn btn-ghost btn-sm" @onclick="NewCodesAsync">New codes</button>
                <button class="mini-btn" title="@(Muted ? "Unmute" : "Mute")" @onclick="ToggleMuteAsync">@(Muted ? "🔇" : "🔊")</button>
            </div>
        }
    </section>
}
else
{
    <header class="jeo-bar">
        <div class="jeo-scores">
            @foreach (var (team, score) in JeopardyService.Scoreboard(Trip))
            {
                <div class="jeo-score @(Game.PickingTeamId == team.Id ? "is-picking" : null) @(BuzzedFirst == team.Id ? "is-buzzed" : null)"
                     style="--team:@team.Color">
                    <span class="jeo-score-name">@team.Name</span>
                    <b class="jeo-score-value">@score</b>
                    @if (Game.PickingTeamId == team.Id && Game.Phase == JeopardyPhase.Board)
                    {
                        <span class="jeo-score-tag">picks</span>
                    }
                    @if (Game.LockedOutTeamIds.Contains(team.Id))
                    {
                        <span class="jeo-score-tag is-out">out</span>
                    }
                </div>
            }
        </div>
        @if (CanEdit)
        {
            <div class="jeo-bar-actions">
                <button class="mini-btn" title="@(Muted ? "Unmute" : "Mute")" @onclick="ToggleMuteAsync">@(Muted ? "🔇" : "🔊")</button>
                <button class="btn btn-ghost btn-xs" @onclick="ConfirmReset">Reset</button>
            </div>
        }
    </header>

    @if (Game.Phase == JeopardyPhase.FinalIntro)
    {
        @* The one moment in the game that gets its own titles. The rules are on the wall because
           the final plays by the same ones as everything else and nobody will remember that. *@
        <section class="jeo-finalintro">
            <div class="jeo-fi-diamond" aria-hidden="true">
                <svg viewBox="0 0 100 100"><path d="M50 4 L92 50 L50 96 L8 50 Z" /></svg>
            </div>
            <p class="jeo-kicker jeo-fi-kicker">The board is spent</p>
            <h1 class="jeo-fi-title">FINAL JEOPARDY</h1>
            <p class="jeo-fi-cat">@Board.Final.Category · @Board.Final.Value points</p>

            <ul class="jeo-fi-rules">
                <li>Same as every other clue — <b>buzz in</b> to answer.</li>
                <li>Get it right and you take <b>@Board.Final.Value</b>. First one to do it wins the game.</li>
                <li>Get it wrong and you <b>lose @Board.Final.Value</b>, and the rest get their shot.</li>
                <li>Talk to your team first. There's a notepad on your phone to write it down.</li>
            </ul>

            @if (CanEdit)
            {
                <div class="jeo-title-actions">
                    <button class="btn btn-gold btn-lg" @onclick="StartFinalAsync">Show the final clue</button>
                </div>
            }
        </section>
    }
    else if (InPlay is { } inPlay)
    {
        @* One section for a clue, the final, and the answer afterwards. They are the same thing
           now, so they are the same markup — the phase only decides what is added underneath.

           Nothing the host needs to keep to themselves appears here. The answer is on their
           phone until it is settled, and so is the Correct/Wrong call, because this screen is
           pointed at the room. *@
        var revealed = Game.Phase == JeopardyPhase.Revealed;

        @* Keyed on the clue so each new one is a new element, which is what replays the expand
           animation. The reveal keeps the same key on purpose — the answer appearing under a
           clue that is already up should not throw the whole panel back at the room. *@
        <section class="jeo-clue @(inPlay.IsFinal ? "is-final" : null) @(revealed ? "is-revealed" : null)"
                 @key="inPlay.Id">
            <p class="jeo-clue-head">@ClueHead(inPlay)</p>

            @if (!string.IsNullOrWhiteSpace(inPlay.ClueImage))
            {
                <MediaView Src="@inPlay.ClueImage" CssClass="jeo-clue-img" Autoplay="true" />
            }
            @if (!string.IsNullOrWhiteSpace(inPlay.Clue))
            {
                <p class="jeo-clue-text">@inPlay.Clue</p>
            }

            @if (revealed)
            {
                <div class="jeo-reveal">
                    <p class="jeo-reveal-label">Answer</p>
                    <p class="jeo-answer">@inPlay.Response</p>
                    @if (!string.IsNullOrWhiteSpace(inPlay.ResponseImage))
                    {
                        <MediaView Src="@inPlay.ResponseImage" CssClass="jeo-clue-img" Autoplay="true" />
                    }

                    @if (Game.RevealedWinnerTeamId is { } winner)
                    {
                        <p class="jeo-reveal-who" style="--team:@TeamColor(winner)">
                            <b class="jeo-reveal-team">@TeamName(winner)</b>
                            <span>takes @inPlay.Value</span>
                        </p>
                    }
                    else
                    {
                        <p class="jeo-reveal-who muted">Nobody got it.</p>
                    }
                </div>

                @if (CanEdit)
                {
                    <div class="jeo-title-actions">
                        <button class="btn btn-gold btn-lg" @onclick="ContinueAsync">
                            @(inPlay.IsFinal ? "See who won" : "Next clue")
                        </button>
                    </div>
                }
            }
            else if (Game.Phase == JeopardyPhase.Judging)
            {
                <div class="jeo-buzzed">
                    <span class="jeo-buzzed-team" style="--team:@TeamColor(BuzzedFirst)">@TeamName(BuzzedFirst)</span>
                    <span class="muted">buzzed in @Reaction(Game.Buzzes.FirstOrDefault()?.Milliseconds ?? 0)</span>
                </div>
            }
            else
            {
                <p class="jeo-open">Buzzers are open@(Game.LockedOutTeamIds.Count > 0 ? $" — {Game.LockedOutTeamIds.Count} locked out" : "")</p>
            }
        </section>
    }
    else if (Game.Phase == JeopardyPhase.Finished)
    {
        <section class="jeo-win">
            <div class="jeo-win-burst" aria-hidden="true">
                @for (var i = 0; i < 12; i++)
                {
                    <span style="--i:@i"></span>
                }
            </div>

            <p class="jeo-kicker">Final scores</p>
            <h1 class="jeo-win-name" style="--team:@WinnerColor">@Winner</h1>

            <div class="jeo-final-grid">
                @foreach (var (team, score) in JeopardyService.Scoreboard(Trip).OrderByDescending(x => x.Score))
                {
                    <div class="jeo-final-card @(score == TopScore ? "is-winner" : null)" style="--team:@team.Color">
                        <span class="jeo-join-team">@team.Name</span>
                        <p class="jeo-final-score">@score</p>
                    </div>
                }
            </div>

            <div class="jeo-title-actions">
                <a class="btn btn-gold btn-lg" href="/">Home</a>
            </div>
        </section>
    }
    else
    {
        @* The board is up for the opening race too, rather than being replaced by a panel. The
           point of the race is choosing from this board, so it should be the thing everyone is
           staring at while they hammer their phones. *@
        <section class="jeo-board @(Game.BuzzersOpen ? "is-racing" : null)">
            @foreach (var category in Board.Categories)
            {
                <div class="jeo-col">
                    <div class="jeo-cat">@category.Name</div>
                    @foreach (var clue in category.Clues)
                    {
                        var used = JeopardyService.IsUsed(Trip, clue.Id);
                        <button class="jeo-cell @(used ? "is-used" : null) @(clue.IsEmpty ? "is-empty" : null)"
                                disabled="@(used || clue.IsEmpty || !CanEdit || Game.BuzzersOpen)"
                                @onclick="() => PickAsync(clue.Id)">
                            @(used || clue.IsEmpty ? "" : clue.Value.ToString())
                        </button>
                    }
                </div>
            }
        </section>

        @if (Game.BuzzersOpen)
        {
            <div class="jeo-race">
                <span class="jeo-race-dot" aria-hidden="true"></span>
                <b>Buzz in to pick first</b>
                <span class="muted">fastest team opens the board</span>
            </div>
        }
        else if (ShowingPickCard)
        {
            @* Whoever won the race gets the screen for a moment, so the room knows who it is and
               the winner knows to look up at the board. It clears itself. *@
            <div class="jeo-pickcard" style="--team:@TeamColor(Game.PickingTeamId)">
                <div class="jeo-pickcard-inner">
                    <span class="jeo-pickcard-name">@TeamName(Game.PickingTeamId)</span>
                    <span class="jeo-pickcard-line">picks first</span>
                    @if (Game.Buzzes.FirstOrDefault() is { } won)
                    {
                        <span class="jeo-pickcard-time">in @Reaction(won.Milliseconds)</span>
                    }
                    <span class="jeo-pickcard-hint">Choose a clue on the board</span>
                </div>
            </div>
        }
        else if (Game.PickingTeamId is not null)
        {
            <p class="jeo-turn"><b style="color:@TeamColor(Game.PickingTeamId)">@TeamName(Game.PickingTeamId)</b> picks</p>
        }
    }
}

</div>
</AdminOnly>

<ConfirmDialog @ref="_confirm" />

@code {
    // Jeopardy writes to both the board and the trip's score log, and the standings elsewhere
    // read the latter, so every mutation is announced as All rather than a narrower area.
    protected override TripArea Watching => TripArea.All;

    private ConfirmDialog? _confirm;
    private IJSObjectReference? _audio;
    private JeopardyPhase _lastPhase = JeopardyPhase.NotStarted;
    private string? _lastClueId;
    private bool _editingBoard;

    /// <summary>How long the "you picked first" card holds the screen before the board is clear.</summary>
    private static readonly TimeSpan PickCardDuration = TimeSpan.FromSeconds(3.4);

    private bool _showPickCard;
    private bool _lastBuzzersOpen;
    private CancellationTokenSource? _pickCard;

    private bool ShowingPickCard => _showPickCard && Game.PickingTeamId is not null;

    private JeopardyBoard Board => Trip.Jeopardy;
    private JeopardyGame Game => Trip.Jeopardy.Game;
    private bool Muted { get; set; }

    /// <summary>Whatever is on the wall — a clue, the final, or the answer to either.</summary>
    private ClueInPlay? InPlay => JeopardyService.InPlay(Trip);

    // Only ever reachable from the title card, so a stale flag cannot hijack a game in progress.
    private bool IsEditingBoard => _editingBoard && CanEdit && Game.Phase == JeopardyPhase.NotStarted;
    private bool IsTitleCard => Game.Phase == JeopardyPhase.NotStarted && !IsEditingBoard;

    private string? BuzzedFirst => Game.LeadingBuzzTeamId;

    private string JoinHost => new Uri(Nav.BaseUri).Authority;
    private string BuzzUrl(string code) => Nav.ToAbsoluteUri($"/login/{code}").ToString();
    private string CodeFor(string teamId) => Game.BuzzerCodes.GetValueOrDefault(teamId, "—");

    /// <summary>
    /// Always seconds. "4108 ms" is the sort of number a stopwatch reports and a person has to
    /// convert in their head; "4.11 s" is the one they can read off the wall.
    /// </summary>
    private static string Reaction(int ms) => $"{ms / 1000.0:0.00} s";

    /// <summary>
    /// The line above a clue. The final says so, unless its category already does — the board
    /// ships with that category called "Final Jeopardy", which otherwise reads back twice.
    /// </summary>
    private static string ClueHead(ClueInPlay clue)
    {
        var category = clue.Category.Trim();

        if (!clue.IsFinal)
            return $"{category} · {clue.Value}";

        return category.Length == 0 || category.Contains("final", StringComparison.OrdinalIgnoreCase)
            ? $"Final Jeopardy · {clue.Value}"
            : $"Final Jeopardy · {category} · {clue.Value}";
    }

    private string TeamName(string? id) => Trip.Teams.FirstOrDefault(t => t.Id == id)?.Name ?? "—";
    private string TeamColor(string? id) => Trip.Teams.FirstOrDefault(t => t.Id == id)?.Color ?? "#d4af37";
    private string CategoryName(string? clueId) =>
        clueId is null ? "" : JeopardyService.CategoryOf(Trip, clueId)?.Name ?? "";

    private IReadOnlyList<(Team Team, int Score)> Ranked =>
        JeopardyService.Scoreboard(Trip).OrderByDescending(x => x.Score).ToList();

    private int TopScore => Ranked.Count == 0 ? 0 : Ranked[0].Score;

    private string Winner
    {
        get
        {
            var board = Ranked;
            if (board.Count == 0) return "No one";
            var tied = board.Where(x => x.Score == TopScore).Select(x => x.Team.Name).ToList();
            return tied.Count > 1 ? string.Join(" and ", tied) + " tie" : $"{tied[0]} wins";
        }
    }

    /// <summary>The winning team's colour, or gold when it is a tie and nobody owns the screen.</summary>
    private string WinnerColor
    {
        get
        {
            var winners = Ranked.Where(x => x.Score == TopScore).ToList();
            return winners.Count == 1 ? winners[0].Team.Color : "#d4af37";
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Codes need to exist before the join screen is any use, but opening the board must not
        // disturb a game already under way — so this fills gaps rather than resetting.
        if (CanEdit && JeopardyService.EnsureCodes(Trip, Random.Shared))
            _ = MutateAsync(_ => { });
    }

    // ------------------------------------------------------------------ flow

    private async Task BeginAsync()
    {
        await Unlock();
        await MutateAsync(t => JeopardyService.StartBuzzOff(t, DateTimeOffset.UtcNow));
    }

    private async Task NewCodesAsync()
    {
        await MutateAsync(t => JeopardyService.Reset(t, Random.Shared));
        Toasts.Show("New codes issued", CharterTrip.Web.Services.ToastKind.Good);
    }

    private async Task PickAsync(string clueId)
    {
        // Fired here rather than off the phase change so the click is answered on the device
        // that made it, without waiting for the round trip.
        await Cue("pick");
        await MutateAsync(t => JeopardyService.PickClue(t, clueId, DateTimeOffset.UtcNow));
    }

    /// <summary>
    /// Give the winner of the opening race the screen for a moment. Purely a view state — it is
    /// not worth a field in trip.json, and every screen watching works it out for itself from
    /// the same transition.
    /// </summary>
    private void ShowPickCard()
    {
        _pickCard?.Cancel();
        _pickCard?.Dispose();
        _pickCard = new CancellationTokenSource();
        var token = _pickCard.Token;

        _showPickCard = true;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(PickCardDuration, token);
                _showPickCard = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { /* superseded, or the page went away */ }
        });
    }

    private Task ContinueAsync() => MutateAsync(JeopardyService.Continue);

    private Task StartFinalAsync() =>
        MutateAsync(t => JeopardyService.StartFinal(t, DateTimeOffset.UtcNow));

    private void ConfirmReset() =>
        _confirm?.Show("Reset the whole game? Every clue comes back and the Jeopardy points leave the standings.",
            () => MutateAsync(t => JeopardyService.Reset(t, Random.Shared)), "Reset");

    // ---------------------------------------------------------------- editing

    private Task SetBoardTitleAsync(string value) => MutateAsync(t => t.Jeopardy.Title = value);

    private Task SetCategoryNameAsync(int index, string value) => MutateAsync(t =>
    {
        if (index >= 0 && index < t.Jeopardy.Categories.Count)
            t.Jeopardy.Categories[index].Name = value;
    });

    /// <summary>
    /// Every clue field is written through here. The clue is looked up by id inside the mutation
    /// rather than captured from the render, so an edit still lands on the right clue if the
    /// board changed underneath the page.
    /// </summary>
    private Task EditClueAsync(string clueId, Action<JeopardyClue> apply) => MutateAsync(t =>
    {
        if (JeopardyService.FindClue(t, clueId) is { } clue) apply(clue);
    });

    private Task EditFinalAsync(Action<JeopardyFinal> apply) => MutateAsync(t => apply(t.Jeopardy.Final));

    /// <summary>A cleared or nonsense points box leaves the value alone rather than zeroing it.</summary>
    private Task SetClueValueAsync(string clueId, string? raw) =>
        ParseValue(raw) is { } value ? EditClueAsync(clueId, c => c.Value = value) : Task.CompletedTask;

    private Task SetFinalValueAsync(string? raw) =>
        ParseValue(raw) is { } value ? EditFinalAsync(f => f.Value = value) : Task.CompletedTask;

    private static int? ParseValue(string? raw) =>
        int.TryParse(raw, out var value) && value >= 0 ? value : null;

    // ----------------------------------------------------------------- audio

    private async Task Unlock()
    {
        _audio ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/jeopardy-audio.js");
        await _audio.InvokeVoidAsync("unlock");
    }

    /// <summary>Fire one sound, and never let a dead circuit turn into an unhandled exception.</summary>
    private async Task Cue(string name)
    {
        if (_audio is null) return;
        try { await _audio.InvokeVoidAsync(name); } catch (JSDisconnectedException) { }
    }

    private async Task ToggleMuteAsync()
    {
        Muted = !Muted;
        if (_audio is not null) await _audio.InvokeVoidAsync("setMuted", Muted);
    }

    /// <summary>
    /// Which piece of music belongs to a phase, or null for silence.
    ///
    /// Four beds, deliberately distinct in pace and register, so the game is legible from the
    /// kitchen: a lounge vamp while people are still scanning codes, something warmer and out of
    /// the way while the board is being picked from, a tense countdown while a clue is live, and
    /// the fast one for the final.
    ///
    /// The final's music has to cover its judging and its answer too, because those reuse the
    /// same phases a normal clue does — hence the check on what is actually in play rather than
    /// on the phase alone. The win screen is silent underneath, so the jingle has the room.
    /// </summary>
    private string? BedFor(JeopardyPhase phase)
    {
        if (FinalInPlay(phase)) return "final";

        return phase switch
        {
            JeopardyPhase.NotStarted => "vamp",
            JeopardyPhase.Board or JeopardyPhase.Revealed => "board",
            JeopardyPhase.Clue or JeopardyPhase.Judging => "question",
            JeopardyPhase.FinalIntro => "final",
            _ => null
        };
    }

    /// <summary>True from the moment the final clue goes up until the game is over.</summary>
    private bool FinalInPlay(JeopardyPhase phase) =>
        phase == JeopardyPhase.Final || InPlay is { IsFinal: true };

    /// <summary>
    /// Cues follow the phase rather than being fired from each handler, so a buzz arriving from
    /// somebody's phone sounds the same as one triggered here.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Loaded here rather than on the first cue: the join screen needs music before
            // anybody has pressed anything. Opening the page mid-game adopts the current phase
            // silently, so a second screen joining does not replay cues everyone already heard.
            try
            {
                _audio = await JS.InvokeAsync<IJSObjectReference>("import", "./js/jeopardy-audio.js");
                _lastPhase = Game.Phase;
                _lastClueId = Game.CurrentClueId;
                _lastBuzzersOpen = Game.BuzzersOpen;

                // Adopt the current phase's music, so a screen opened mid-game joins the
                // soundtrack rather than sitting in silence until the next transition.
                await _audio.InvokeVoidAsync("setBed", BedFor(Game.Phase));
            }
            catch (JSDisconnectedException) { }

            return;
        }

        // The opening race ending is what puts the winner's card on screen. Detected from the
        // buzzers closing rather than pushed from the click, so a screen that was not the one
        // being tapped shows it too.
        if (_lastBuzzersOpen && !Game.BuzzersOpen
            && Game.Phase == JeopardyPhase.Board && Game.PickingTeamId is not null)
        {
            ShowPickCard();
            await Cue("correct");
            StateHasChanged();
        }

        _lastBuzzersOpen = Game.BuzzersOpen;

        if (_audio is null) return;

        var phase = Game.Phase;
        var clueId = Game.CurrentClueId;

        try
        {
            if (clueId != _lastClueId && clueId is not null)
                await _audio.InvokeVoidAsync("reveal");

            if (phase != _lastPhase)
            {
                // One call decides the music. Every phase names the bed it wants and the module
                // switches to it — no per-bed stop to forget, and a phase returning to a bed it
                // was already on does not restart it mid-bar.
                await _audio.InvokeVoidAsync("setBed", BedFor(phase));

                // The one-shots that mark a moment, on top of whatever is playing under them.
                switch (phase)
                {
                    case JeopardyPhase.Judging:
                        await _audio.InvokeVoidAsync("buzz");
                        break;

                    case JeopardyPhase.FinalIntro:
                        await _audio.InvokeVoidAsync("fanfare");
                        break;

                    case JeopardyPhase.Finished:
                        await _audio.InvokeVoidAsync("winJingle");
                        break;
                }
            }

            // Judging to Clue or Final means a wrong answer sent it back for someone else.
            if (_lastPhase == JeopardyPhase.Judging && phase is JeopardyPhase.Clue or JeopardyPhase.Final)
                await _audio.InvokeVoidAsync("wrong");

            // Anything reaching the answer with a name on it got there by being right.
            if (_lastPhase == JeopardyPhase.Judging && phase == JeopardyPhase.Revealed)
                await _audio.InvokeVoidAsync(Game.RevealedWinnerTeamId is null ? "wrong" : "correct");
        }
        catch (JSDisconnectedException) { }

        _lastPhase = phase;
        _lastClueId = clueId;
    }

    public async ValueTask DisposeAsync()
    {
        _pickCard?.Cancel();
        _pickCard?.Dispose();

        if (_audio is not null)
        {
            try { await _audio.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _audio.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        Dispose();
    }
}
