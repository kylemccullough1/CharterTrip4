@page "/join/{Code}"
@attribute [ExcludeFromInteractiveRouting]
@layout BareLayout
@using CharterTrip.Core.Abstractions
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@using CharterTrip.Web.Auth
@using CharterTrip.Core.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject ITripStore Store
@inject NavigationManager Nav
@inject ILogger<JoinWithCode> Log
@inject IWebHostEnvironment Env
@inject CharterTrip.Web.Services.SimPhones Sims

@* The one door for every code on this trip.

   Static SSR on purpose: taking a code and turning it into a session means writing a cookie, and a
   cookie needs an HTTP response to be written to. An interactive circuit is a WebSocket long after
   the response has gone.

   Most codes resolve to somebody and this page redirects without rendering. The party code is the
   exception — it proves you are in the house but says nothing about who you are, so it stops here
   and asks. *@

<PageTitle>Join · Charter Trip 2026</PageTitle>

<div class="login-page">
    <div class="login-card">

@if (Stale)
{
    @* Bounced back here by the antiforgery guard in Program.cs rather than shown a 400. Says what
       to do, because "your token expired" is not something anybody at a party can act on. *@
    <p class="login-error" role="alert">That took a moment too long. Tap again.</p>
}

@if (_state == State.PickHostName)
{
    <h1 class="login-title">Which of you is this?</h1>
    <p class="login-sub">Then you choose your part, rather than being dealt one.</p>

    <form method="post" @formname="pick-organiser" @onsubmit="PickOrganiserAsync">
        <AntiforgeryToken />

        <label class="login-field">
            <span>Your name</span>
            <select name="Picked" class="login-input join-picker" @bind="Picked">
                <option value="">Choose…</option>
                @foreach (var person in Organizers)
                {
                    <option value="@person.Id">@person.Name</option>
                }
            </select>
        </label>

        <button type="submit" class="btn btn-gold btn-block">That's me</button>
    </form>
}
else if (_state == State.PickPart)
{
    <h1 class="login-title">Which part?</h1>
    <p class="login-sub">
        These four run the evening. Braun works the room, dies, and takes the game master's console;
        the other three are guests who are secretly staff.
    </p>

    @if (StaffParts.Count == 0)
    {
        <p class="login-sub">All four are taken. If that's wrong, somebody needs to hand one back.</p>
    }
    else
    {
        <div class="join-roles">
            @foreach (var part in StaffParts)
            {
                <form method="post" @formname="@($"npc-{part.Id}")" @onsubmit="() => ClaimStaffAsync(part.Id)">
                    <AntiforgeryToken />
                    <button type="submit" class="join-role">
                        <span class="join-role-name">@part.Name</span>
                        <span class="join-role-title">@part.Job</span>
                    </button>
                </form>
            }
        </div>
    }
}
else if (_state == State.PickName)
{
    <h1 class="login-title">Who are you?</h1>
    <p class="login-sub">
        @(_door switch
        {
            CodeKind.BeeParty => "Pick your name to take your place in the row.",
            CodeKind.BuzzerParty => "Pick your name and you get your team's buzzer.",
            _ => "Pick your name and the house will find you a part."
        })
    </p>

    @if (People.Count == 0 && !CanTakeTheHostJob)
    {
        @* The dead end everybody hits once, and it used to say the wrong thing.
 
           The twenty-one guest parts and the four house parts are handed out through two different
           gates: the guest list here excludes organizers entirely, and the house parts appear only
           on a browser already signed in as one. So the last four people through this door — the
           four running the evening — see an empty list, and "find Bertram" is no help at all when
           you ARE Bertram and simply have not signed in yet. Say the thing they can act on. *@
        <p class="login-sub">
            @(_door == CodeKind.MysteryParty
                ? "Every guest part has been taken."
                : "Nobody is on a team yet — find whoever is running the trip.")
        </p>

        @if (_door == CodeKind.MysteryParty)
        {
            <p class="login-sub">
                If you are one of the four running the evening, the house parts are behind your own
                sign-in rather than on this list — open your personal link, or
                <a href="/login">sign in</a>, then come back to this code.
            </p>
        }
    }
    else
    {
        @* One form with a select, rather than a form per name. It used to be a wrap of pill
           buttons on the argument that one tap beats a dropdown plus a submit, which is true of
           the tap and was wrong about the wrap: twenty-five names is a wall of pills to read in a
           dark room, and the name you want is wherever the wrap happened to put it. A list you
           scroll is one place to look.

           Still a plain form rather than EditForm, and that part is load-bearing. EditForm demands
           a Model, the model here carried no data, and on a POST the form binder set it to null —
           so every tap threw "EditForm requires either a Model parameter" and the front door 500'd
           for everybody. A form that posts one string does not need a model at all. *@
        <form method="post" @formname="pick-name" @onsubmit="PickedAsync">
            <AntiforgeryToken />

            <label class="login-field">
                <span>Your name</span>
                <select name="Picked" class="login-input join-picker" @bind="Picked">
                    <option value="">Choose…</option>

                    @foreach (var person in People)
                    {
                        @* The bee's tick rides in the text. It used to be a span with no CSS rule
                           anywhere, so it rendered as a bare ✓ regardless; inside an option it
                           could not be anything else. *@
                        <option value="@person.Id">
                            @person.Name@(_door == CodeKind.BeeParty && AlreadyIn(person.Id) ? "  ✓" : "")
                        </option>
                    }

                    @if (CanTakeTheHostJob)
                    {
                        @* Only ever on an organizer's own browser. This is the whole of what the
                           second QR code used to buy, and it is bought better here: a password
                           rather than four characters projected on a wall. *@
                        <optgroup label="Committee">
                            <option value="@HostOption">@HostLabel</option>
                        </optgroup>
                    }
                </select>
            </label>

            <button type="submit" class="btn btn-gold btn-block">That's me</button>
        </form>

        @if (_door == CodeKind.MysteryParty)
        {
            <p class="login-sub tiny">
                Names disappear as people arrive. @SeatsLeft of @TotalSeats parts still going.
            </p>
        }
        else if (_door == CodeKind.BeeParty)
        {
            @* The bee's names stay on the list with a tick rather than vanishing. A phone gets
               handed to somebody halfway through the lobby, and the person who lent it needs to be
               able to take it back.

               Only the bee. This was the else of a two-way branch, so Jeopardy's door — which has
               no ticks on it and nothing that vanishes — was telling everybody who scanned it what
               a tick meant. *@
            <p class="login-sub tiny">A tick means they're already in the row.</p>
        }
    }
}
else
{
    <h1 class="login-title">That code isn't live</h1>
    <p class="login-sub">
        Check it against the screen — codes skip the letters that look like numbers, so there's no
        O, I, S or B to mistype.
    </p>
    <p class="row-actions">
        <a class="btn btn-gold btn-sm" href="/join">Try again</a>
        <a class="btn btn-ghost btn-sm" href="/">Back to the trip</a>
    </p>
}

    </div>
</div>

@code {
    private enum State { Unknown, PickName, PickHostName, PickPart }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [Parameter] public string? Code { get; set; }

    /// <summary>Where to land afterwards. Only ever a path on this site — see <see cref="SafeRedirect"/>.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    /// <summary>Set by the antiforgery guard when it sends a stale form back for another go.</summary>
    [SupplyParameterFromQuery(Name = "stale")] private string? StaleFlag { get; set; }

    /// <summary>
    /// Which simulated phone this is, for the testing strip. Development only.
    ///
    /// A frame carrying this signs into <see cref="SimPhones"/> rather than the cookie it would
    /// otherwise share with the twenty-four frames beside it — everything else about the journey,
    /// the code, the picker, the claim, is the same code a real phone runs.
    /// </summary>
    [SupplyParameterFromQuery(Name = "sim")] private int? Sim { get; set; }

    private bool IsSim => Env.IsDevelopment() && Sim is > 0;

    private bool Stale => StaleFlag is { Length: > 0 };

    private State _state = State.Unknown;

    /// <summary>
    /// What the dropdown posted back: a person id, or <see cref="HostOption"/>.
    ///
    /// A plain bound property rather than a model on an EditForm, for the reason written beside
    /// the form itself — the model was the bug. One string is all either picker sends.
    /// </summary>
    [SupplyParameterFromForm] private string? Picked { get; set; }

    /// <summary>
    /// The value the Host entry carries. Not a person id, and it cannot collide with one: roster
    /// ids are minted by <c>Ids.New</c> and none of them is this.
    /// </summary>
    private const string HostOption = "!host";

    /// <summary>Which organizer is choosing, once they have said. Kept across the two steps.</summary>
    [SupplyParameterFromQuery(Name = "who")] private string? WhoQuery { get; set; }

    /// <summary>
    /// <c>?pick=host</c>: an organizer has asked for a house part and is being asked which of them
    /// they are. In the URL for the same reason <c>?who=</c> is — the "which of you" form is a
    /// real POST, and a page that decides its state from scratch on every request has to be able
    /// to tell from the request that this form is the one on it. It used to be set in a field on
    /// the request before, which the next request never saw; the submit then failed with "no form
    /// on the page currently has that name", because the page had rendered the name picker instead.
    /// </summary>
    [SupplyParameterFromQuery(Name = "pick")] private string? PickQuery { get; set; }

    private const string PickHost = "host";

    private string? _organiserId;

    /// <summary>Which door opened the picker. The two ask the same question of different lists.</summary>
    private CodeKind _door = CodeKind.MysteryParty;

    /// <summary>
    /// Who the picker offers. The mystery hands out parts, so a claimed name leaves the list; the
    /// other two hand out nothing scarce, so everybody stays on it and a phone can be handed over.
    /// </summary>
    private IReadOnlyList<RosterPerson> People => _door switch
    {
        CodeKind.MysteryParty => CastingService.Unclaimed(Store.Current),
        CodeKind.BuzzerParty => Store.Current.Roster
            .Where(p => Store.Current.Teams.Any(t => t.Id == p.TeamId))
            .ToList(),
        _ => SpellingBeeService.Joinable(Store.Current)
    };

    private bool AlreadyIn(string personId) =>
        Store.Current.SpellingBee.Game.Ready.Contains(personId);

    /// <summary>
    /// Whether to offer the host job on the far side of this door.
    ///
    /// This is what replaced the second QR code. The job used to be handed to whoever scanned the
    /// other square, which meant the thing protecting the answer sheet was four characters that had
    /// to be kept off a wall they were printed for. Now it is the committee's password: an
    /// organizer's own browser is already signed in, and nobody else's is.
    ///
    /// Never for a simulated phone, whatever the cookie says. A frame in the testing rail stands in
    /// for a guest's device and shares the laptop's cookie — so without this every test phone would
    /// arrive holding the answer sheet, and the one rule worth testing could not be tested at all.
    /// </summary>
    private bool CanTakeTheHostJob => !IsSim && HttpContext.User.IsInRole(TripRoles.Admin);

    /// <summary>What the host job is called at this particular door.</summary>
    private string HostLabel => _door switch
    {
        CodeKind.BeeParty => "Host — the word list",
        CodeKind.BuzzerParty => "Host — the answer sheet",
        _ => "One of the house parts"
    };

    private IReadOnlyList<RosterPerson> Organizers => CastingService.Organizers(Store.Current);

    private IReadOnlyList<MysteryCharacter> StaffParts => CastingService.UnclaimedStaffParts(Store.Current);

    /// <summary>Whoever is already signed in, if anybody.</summary>
    private string? CurrentPersonId =>
        HttpContext.User.FindFirst(TripClaims.PersonId)?.Value is { Length: > 0 } id ? id : null;
    private int SeatsLeft => CastingService.SeatsLeft(Store.Current);
    private int TotalSeats => CastingService.TotalSeats(Store.Current);

    protected override async Task OnInitializedAsync()
    {
        var match = JoinCodes.Resolve(Store.Current, Code);

        if (!match.Found)
        {
            // Never say which of the four kinds it failed to be — that turns a wrong guess into a
            // hint about what sort of code exists.
            Log.LogWarning("Unrecognised join code from {Ip}.", HttpContext.Connection.RemoteIpAddress);
            return;
        }

        if (match.Kind is CodeKind.MysteryParty or CodeKind.BeeParty or CodeKind.BuzzerParty)
        {
            // A party code is a door, not an identity. Ask who walked through it.
            _door = match.Kind;

            // An organizer part way through choosing a house part is mid-conversation, not
            // arriving: they have already said which of them they are, and ?who= is carrying it.
            // Everybody else, organizers included, gets the picker — the host job is an entry in
            // it rather than a redirect past it, which is what having one code costs and is worth.
            if (match.Kind == CodeKind.MysteryParty && WhoQuery is { Length: > 0 })
            {
                _organiserId = Store.Current.Roster
                    .FirstOrDefault(p => p.Id == WhoQuery && p.Role == TripRole.Admin)?.Id;

                if (_organiserId is not null)
                {
                    _state = State.PickPart;
                    return;
                }
            }

            // Step one of the same conversation: they have asked for a house part and not yet said
            // which of them they are. Only on a browser that could take one — the query is public.
            if (match.Kind == CodeKind.MysteryParty && PickQuery == PickHost && CanTakeTheHostJob)
            {
                _state = State.PickHostName;
                return;
            }

            _state = State.PickName;
            return;
        }

        if (match.Kind != CodeKind.Person) return;

        await SignInAndGo(
            TripSignIn.ForPerson(Store.Current.Roster.First(p => p.Id == match.PersonId)),
            SafeRedirect.Home);
    }

    /// <summary>
    /// Take a name, deal a character, and land on the phone.
    ///
    /// The claim happens inside the mutation so that two people tapping their names at the same
    /// moment cannot be dealt the same part. It is idempotent by person, so somebody coming back on
    /// a new phone gets the character they already had rather than a second one.
    /// </summary>
    private async Task ClaimAsync(string personId)
    {
        if (_door == CodeKind.BeeParty)
        {
            await JoinBeeAsync(personId);
            return;
        }

        if (_door == CodeKind.BuzzerParty)
        {
            await JoinBuzzersAsync(personId);
            return;
        }

        var claimed = await Store.MutateAsync(
            t => CastingService.ClaimCharacter(t, personId, Random.Shared), TripArea.Mystery);

        if (claimed is null)
        {
            _state = State.Unknown;
            return;
        }

        // Casting is worth forcing to disk. Reconstructing who is playing whom after a restart
        // means asking twenty-one people, in character, what their own name is.
        await Store.FlushAsync();

        var person = Store.Current.Roster.First(p => p.Id == personId);
        await SignInAndGo(TripSignIn.ForPerson(person), "/m/welcome", person.Id);
    }

    /// <summary>
    /// Take a name and stand in the row.
    ///
    /// Joining the bee and signing in are one act: the tap that says which name you are is the
    /// same tap that puts you in the running order. There is nothing to deal and nothing to race
    /// over — two people tapping at once join twice, which is what should happen — so unlike the
    /// mystery this does not need to read anything back out of the mutation.
    ///
    /// Not flushed to disk. A lobby is cheap to rebuild by asking the room to tap again, where a
    /// dealt character is not.
    /// </summary>
    private async Task JoinBeeAsync(string personId)
    {
        if (Store.Current.Roster.FirstOrDefault(p => p.Id == personId) is not { } person) return;

        await Store.MutateAsync(t => SpellingBeeService.SetReady(t, personId, true), TripArea.SpellingBee);
        await SignInAndGo(TripSignIn.ForPerson(person), "/bee", person.Id);
    }

    /// <summary>
    /// Take a name and pick up that person's team buzzer.
    ///
    /// Nobody chooses a team. A team is a property of the name that was tapped, read off the roster
    /// on the server, and <see cref="TripSignIn.ForPerson"/> puts it in the cookie — so "somebody
    /// took a team that is not theirs" is not a thing that can be expressed, let alone defended
    /// against. What a guest can do is tap somebody else's name, which is exactly what they could
    /// already do by typing that team's four characters off the wall.
    ///
    /// Every teammate ends up holding a buzzer rather than one phone per team. The board is
    /// unchanged by that — <c>JeopardyService.Buzz</c> already ignores a team's second buzz — so
    /// what it buys is four people hammering instead of whoever was handed the phone.
    /// </summary>
    private async Task JoinBuzzersAsync(string personId)
    {
        if (Store.Current.Roster.FirstOrDefault(p => p.Id == personId) is not { } person) return;

        if (string.IsNullOrWhiteSpace(person.TeamId))
        {
            // Nothing to hand them. Says so rather than signing them into a game they cannot play.
            _state = State.Unknown;
            return;
        }

        await Store.MutateAsync(t => JeopardyService.RecordTeamJoin(t, person.TeamId), TripArea.Jeopardy);
        await SignInAndGo(TripSignIn.ForPerson(person), "/buzz", person.Id);
    }

    /// <summary>
    /// Step one of the house parts: remember who, then ask which part.
    ///
    /// Carried in the query rather than a field because this page is static SSR — the submit is a
    /// real post, and a field set on one request is gone by the next.
    /// </summary>
    private void PickOrganiserAsync()
    {
        if (Picked is not { Length: > 0 } personId) return;

        var target = $"/join/{Uri.EscapeDataString(Code ?? "")}?who={Uri.EscapeDataString(personId)}";
        if (IsSim) target += $"&sim={Sim!.Value}";

        Nav.NavigateTo(target);
    }

    /// <summary>
    /// What the one dropdown posted: a name, or the host job.
    ///
    /// Nothing chosen is a no-op rather than an error. On a phone in a dark room, submitting the
    /// placeholder is a slip, and the page you are already looking at is the right answer to it.
    /// </summary>
    private Task PickedAsync() => Picked switch
    {
        null or "" => Task.CompletedTask,
        HostOption => TakeTheHostJobAsync(),
        var personId => ClaimAsync(personId)
    };

    /// <summary>
    /// Sign this browser in as the host of whichever game's door it came through.
    ///
    /// <c>keepAdmin</c> on both, and it matters on exactly one device: the laptop running the wall,
    /// where taking the host job would otherwise hand over the word list and take away the board.
    ///
    /// The mystery does not sign anybody in here. Its house parts are four named characters rather
    /// than one job, so it falls into the same two-step it has always used — which of you, then
    /// which part — and <c>CastingService.ClaimStaffPart</c> re-checks the roster role server-side
    /// on the far side of it.
    /// </summary>
    private async Task TakeTheHostJobAsync()
    {
        if (!CanTakeTheHostJob) return;

        switch (_door)
        {
            case CodeKind.BuzzerParty:
                // The board refuses to start until the host's sheet is in somebody's hand, so
                // taking it here is what has to record that. It was the host code's job before.
                await Store.MutateAsync(JeopardyService.RecordHostJoin, TripArea.Jeopardy);
                await SignInAndGo(TripSignIn.ForBuzzerHost(keepAdmin: true), "/buzz");
                return;

            case CodeKind.BeeParty:
                await SignInAndGo(TripSignIn.ForBeeHost(keepAdmin: true), "/bee");
                return;

            default:
                _organiserId = Store.Current.Roster
                    .FirstOrDefault(p => p.Id == CurrentPersonId && p.Role == TripRole.Admin)?.Id;

                if (_organiserId is null)
                {
                    // Into the URL, not only into _state: the "which of you" form is a POST, and
                    // the page has to know to render it when that POST arrives.
                    var ask = $"/join/{Uri.EscapeDataString(Code ?? "")}?pick={PickHost}";
                    if (IsSim) ask += $"&sim={Sim!.Value}";

                    Nav.NavigateTo(ask);
                    return;
                }

                // Into the URL rather than only into _state, because the next thing this organizer
                // does is submit one of the npc-{id} forms — and that is another POST, on a page
                // with no circuit, to a component that will be constructed from scratch. A field
                // does not survive that: the rebuilt component would render the name picker again,
                // the form being submitted would no longer exist, and Blazor would answer "Cannot
                // submit the form 'npc-braun' because no form on the page currently has that name."
                //
                // ?who= is what carries it across, which is what ResolveAsync reads on the way back
                // in and what ClaimStaffAsync falls back to. Nothing else ever set it.
                Nav.NavigateTo(WithOrganiser(_organiserId));
                return;
        }
    }

    /// <summary>
    /// Take a house part and sign in as the organizer holding it.
    ///
    /// Forced to disk: this is who is running the evening, and reconstructing it after a restart
    /// means asking four people which of them was meant to be Bertram.
    /// </summary>
    private async Task ClaimStaffAsync(string characterId)
    {
        var personId = _organiserId ?? WhoQuery;
        if (personId is null) { _state = State.Unknown; return; }

        var ok = await Store.MutateAsync(
            t => CastingService.ClaimStaffPart(t, personId, characterId), TripArea.Mystery);

        if (!ok)
        {
            // Somebody else got there between the page rendering and the tap. Show what is left.
            _state = State.PickPart;
            return;
        }

        await Store.FlushAsync();

        var person = Store.Current.Roster.First(p => p.Id == personId);
        await SignInAndGo(TripSignIn.ForPerson(person), "/m/welcome", person.Id);
    }

    /// <param name="personId">
    /// Who this is, when it is somebody in particular. A simulated phone needs the id rather than
    /// the principal, because it is binding a slot instead of writing a cookie.
    /// </param>
    private async Task SignInAndGo(
        System.Security.Claims.ClaimsPrincipal principal, string landing, string? personId = null)
    {
        if (IsSim && personId is { Length: > 0 })
        {
            // A simulated phone keeps its identity beside the others rather than in the one cookie
            // every frame on this page shares.
            Sims.Bind(Sim!.Value, personId);
            Nav.NavigateTo(Append(landing, Sim.Value));
            return;
        }

        // Persistent, so closing the tab does not mean finding the code again halfway through the
        // evening. Signing in replaces whatever session was here before, which is what makes
        // handing a phone to somebody else work.
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties { IsPersistent = true });

        Nav.NavigateTo(ReturnUrl is { Length: > 0 } ? SafeRedirect.Local(ReturnUrl) : landing);
    }

    /// <summary>Carries the sim slot through every hop, since it is standing in for a cookie.</summary>
    private static string Append(string path, int slot) =>
        path + (path.Contains('?') ? "&" : "?") + "sim=" + slot;

    /// <summary>
    /// This same door, carrying which organizer is choosing a house part. The sim slot rides along
    /// so a simulated phone does not lose which frame it is halfway through the two-step.
    /// </summary>
    private string WithOrganiser(string personId)
    {
        var path = $"/join/{Uri.EscapeDataString(Code ?? "")}?who={Uri.EscapeDataString(personId)}";
        return IsSim ? Append(path, Sim!.Value) : path;
    }


}
