@page "/login/{Code}"
@attribute [ExcludeFromInteractiveRouting]
@layout BareLayout
@using CharterTrip.Core.Abstractions
@using CharterTrip.Core.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject ITripStore Store
@inject NavigationManager Nav
@inject ILogger<JoinWithCode> Log

@* The one front door for every code on this trip.

   Static SSR on purpose, for the same reason as the sign-in page: signing somebody in means
   writing a cookie, and a cookie needs an HTTP response to be written to. An interactive circuit
   is a WebSocket long after the response has gone.

   Nothing here is interactive anyway — the page resolves the code, writes the cookie, and
   redirects. The only thing it ever renders is the failure. *@

<PageTitle>Signing in · Charter Trip 2026</PageTitle>

<div class="login-page">
    <div class="login-card">
        <h1 class="login-title">That code isn't live</h1>
        <p class="login-sub">
            Check it against the card or the screen — codes skip the letters that look like
            numbers, so there is no O, I, S or B to mistype.
        </p>
        <p class="row-actions">
            <a class="btn btn-gold btn-sm" href="/login">Try another code</a>
            <a class="btn btn-ghost btn-sm" href="/">Back to the trip</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [Parameter] public string? Code { get; set; }

    /// <summary>Where to land afterwards. Only ever a path on this site — see <see cref="SafeRedirect"/>.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var match = JoinCodes.Resolve(Store.Current, Code);

        if (!match.Found)
        {
            // Never say which of the three kinds it failed to be — that turns a wrong guess into
            // a hint about what sort of code exists. The rendered page above says the same.
            Log.LogWarning("Unrecognised join code from {Ip}.", HttpContext.Connection.RemoteIpAddress);
            return;
        }

        var (principal, landing) = match.Kind switch
        {
            CodeKind.Person => (
                TripSignIn.ForPerson(Store.Current.Roster.First(p => p.Id == match.PersonId)),
                SafeRedirect.Home),

            CodeKind.BuzzerTeam => (
                TripSignIn.ForBuzzerTeam(Store.Current.Teams.First(t => t.Id == match.TeamId)),
                "/buzz"),

            CodeKind.BuzzerHost => (TripSignIn.ForBuzzerHost(), "/buzz"),

            _ => (null, SafeRedirect.Home)
        };

        if (principal is null) return;

        // Persistent, so closing the tab does not mean finding the link again halfway through
        // Saturday. Signing in replaces whatever session was here before, which is what makes
        // handing a phone to somebody else work.
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties { IsPersistent = true });

        // An explicit returnUrl wins, so a link into a page can bounce through here and come back.
        Nav.NavigateTo(ReturnUrl is { Length: > 0 } ? SafeRedirect.Local(ReturnUrl) : landing);
    }
}
