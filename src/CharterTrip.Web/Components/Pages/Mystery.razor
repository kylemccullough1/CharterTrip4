@page "/mystery"

<PageTitle>Murder at West Egg Manor · Charter Trip 2026</PageTitle>

@* The games and the roster are the committee's working area, not part of what a
   guest came here for. AdminOnly guards the page itself, so typing the URL lands
   on the same polite refusal as following a link that is not in their menu. *@
<AdminOnly>
<ComingSoon Title="Murder at West Egg Manor"
            Subtitle="Saturday, 8:00 PM — Gatsby dress code."
            Phase="3"
            Description="All 26 roles, the 5 conspirators and the mastermind are already seeded. Phase 3 turns it into a live game."
            Bullets="_bullets" />
</AdminOnly>

@code {
    private readonly string[] _bullets =
    [
        "Cast 26 people into 26 roles, by hand or randomised",
        "Deal private character cards to everyone's phone at once",
        "Host-driven rounds that update every screen live",
        "Release clues publicly, or slip one to a single character",
        "Final ballot with a live tally and a reveal screen",
    ];
}
