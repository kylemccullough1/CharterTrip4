@page "/games/mystery"
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@using CharterTrip.Core.Mystery.Script
@using CharterTrip.Core.Mystery.Text
@inherits TripAwareComponent
@inject MysteryScript Script
@inject IClock Clock
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>Murder at Braun Manor · Charter Trip 2026</PageTitle>

@* The host console. Braun's player runs the evening from here.

   Its real job is to be the safety net for everything else: any feature that does not exist, or
   that misbehaves on the night, is something a person does by hand from this page. That is why
   every control has a force next to it, and why the guilty list is on screen rather than hidden
   behind a reveal. *@
<AdminOnly>
<div class="page">

    <SectionCard Title="Murder at Braun Manor"
                 Subtitle="@HeaderLine">
        <Actions>
            <a class="btn btn-sm" href="/games/mystery/screen" target="_blank">Main screen ↗</a>
            <a class="btn btn-sm" href="/games/mystery/print" target="_blank">Print sheets ↗</a>
        </Actions>
        <ChildContent>

        @if (Warnings.Count > 0)
        {
            @* Content problems the compiler found. Better here, now, than on the wall later. *@
            <div class="card mys-warn">
                <h4>Content gaps</h4>
                <ul class="mys-list">
                    @foreach (var warning in Warnings)
                    {
                        <li class="tiny">@warning</li>
                    }
                </ul>
                <p class="muted tiny">
                    Each of these is a fragment nobody has written. The affected line is left out
                    rather than shown with a hole in it.
                </p>
            </div>
        }

        @if (Deal is null)
        {
            <div class="card">
                <h3>No game dealt</h3>
                <p class="muted">
                    Dealing places all @Script.Characters.Count characters, draws three killers and
                    three red herrings, assigns every faction, and lays out nine clue cards. The
                    same seed always deals the same game.
                </p>
                <div class="row gap wrap center mys-deal">
                    <label class="tiny">
                        Seed
                        <input class="mys-seed" type="number" @bind="_seed" />
                    </label>
                    <button class="btn btn-xs" @onclick="() => _seed = Random.Shared.Next(1, 999999)">Random</button>
                    <span class="grow"></span>
                    <button class="btn btn-gold" @onclick="DealAsync">Deal a game</button>
                </div>
                @if (_error is not null)
                {
                    <p class="mys-error" role="alert">@_error</p>
                }
                <p class="muted tiny">
                    Nobody is cast at deal time. Guests take a part at the door with the party
                    code; the four of you pick Braun or a facilitator with the host code.
                </p>
            </div>
        }
        else
        {
            <div class="card">
                <div class="row between center wrap gap">
                    <div>
                        <h3>Seed @Deal.Seed</h3>
                        <p class="muted tiny">
                            @Claimed of @Deal.Cast.Count parts taken · access by the @RouteLabel
                        </p>
                    </div>
                    <div class="row gap wrap">
                        @if (!Trip.Mystery.Active)
                        {
                            <button class="btn btn-gold btn-sm" @onclick="StartAsync">Start the evening</button>
                        }
                        <button class="btn btn-danger-ghost btn-sm" @onclick="AskToDiscard">Discard</button>
                    </div>
                </div>
            </div>

            @* Both doors, side by side, because this whole page is AdminOnly and there is nothing
               to hide from whoever is reading it. Getting everybody into the game is one job. *@
            <div class="card mys-party">
                <h4>Getting everybody in</h4>

                <div class="mys-doors">
                    <div class="mys-door">
                        <QrImage Content="@JoinUrl" Size="150" Alt="Join the mystery" />
                        <p class="mys-code">@Trip.Mystery.PartyCode</p>
                        <p class="mys-door-who">The 21 guests</p>
                        <p class="muted tiny">
                            Put this on the wall. They go to <b>@JoinHost/join</b>, type it, tap
                            their own name, and are dealt a part on the spot.
                        </p>
                    </div>

                    <div class="mys-door mys-door-host">
                        <QrImage Content="@HostUrl" Size="150" Alt="Take a house part" />
                        <p class="mys-code">@Trip.Mystery.HostCode</p>
                        <p class="mys-door-who">The four of you</p>
                        <p class="muted tiny">
                            Pick Braun, Leo, Chloe or Bertram. Don't project this one — it hands out
                            parts that come with the guilty list.
                        </p>
                    </div>
                </div>

                <p class="tiny">
                    @foreach (var role in Script.Ghosts.Npcs.Roles)
                    {
                        var who = Trip.Mystery.NpcClaims.FirstOrDefault(c => c.NpcId == role.Id);
                        <span class="mys-tag @(who is null ? "" : "herring")">
                            @role.Name@(who is null ? "" : $" — {PersonName(who.PersonId)}")
                        </span>
                    }
                </p>

                @if (Waiting.Count > 0)
                {
                    <p class="tiny">
                        Still to arrive: <b>@string.Join(", ", Waiting.Select(p => p.Name))</b>
                    </p>
                }
                else
                {
                    <p class="tiny">Everybody's here.</p>
                }
            </div>

        }

        @* One dialog for the page, driven by Show() — the component's actual contract. It was
           being handed Title/Message parameters it does not have, which threw the moment it
           rendered and took the whole circuit down with it. *@
        <ConfirmDialog @ref="_confirm" />

        </ChildContent>
    </SectionCard>

    @if (Deal is not null)
    {
        <SectionCard Title="The evening" Subtitle="@RoundLine">
            <Actions>
                <button class="btn btn-sm" @onclick="() => GoToRoundAsync(Trip.Mystery.CurrentRoundIndex - 1)">← Back</button>
                <button class="btn btn-gold btn-sm" @onclick="() => GoToRoundAsync(Trip.Mystery.CurrentRoundIndex + 1)">Next →</button>
            </Actions>
            <ChildContent>

            <div class="mys-rounds">
                @for (var i = 0; i < Script.Rounds.Rounds.Count; i++)
                {
                    var index = i;
                    var round = Script.Rounds.Rounds[i];
                    var state = index == Trip.Mystery.CurrentRoundIndex ? "now"
                        : index < Trip.Mystery.CurrentRoundIndex ? "done" : "";

                    <button class="mys-round @state" @onclick="() => GoToRoundAsync(index)">
                        <span class="mys-round-name">@round.Name</span>
                        <span class="muted tiny">@round.Minutes min@(round.IsTrial ? " · trial" : "")</span>
                    </button>
                }
            </div>

            @if (CurrentRound is { } current)
            {
                <div class="card">
                    <h4>@current.Name</h4>
                    @if (!string.IsNullOrWhiteSpace(current.Screen))
                    {
                        <p>@current.Screen</p>
                    }
                    @if (current.Mechanics.Count > 0)
                    {
                        <ul class="mys-list">
                            @foreach (var line in current.Mechanics)
                            {
                                <li class="tiny muted">@line</li>
                            }
                        </ul>
                    }
                </div>
            }

            </ChildContent>
        </SectionCard>

        @* --- trials ------------------------------------------------------------------- *@
        <SectionCard Title="Trials" Subtitle="@TrialLine">
            @if (CurrentRound is { IsTrial: true } trialRound)
            {
                var trial = Trip.Mystery.Trials.FirstOrDefault(t => t.RoundId == trialRound.Id);

                <div class="card">
                    @if (trial is null)
                    {
                        <p class="muted">Not open yet. Opening it puts the vote on every phone.</p>
                        <button class="btn btn-gold btn-sm" @onclick="() => OpenTrialAsync(trialRound.Id)">
                            Open @trialRound.Name
                        </button>
                    }
                    else
                    {
                        <p class="row between center">
                            <span><b>@trial.Phase</b></span>
                            <span class="muted tiny">
                                @trial.OpenVotes.Count open · @trial.FinalVotes.Count final
                            </span>
                        </p>

                        @switch (trial.Phase)
                        {
                            case MysteryTrialPhase.OpenVote:
                                <p class="muted tiny">@Script.Rounds.TrialProcedure.Phase1</p>
                                <button class="btn btn-gold btn-sm" @onclick="() => CloseOpenAsync(trial)">
                                    Close the vote and nominate
                                </button>
                                break;

                            case MysteryTrialPhase.Defence:
                                <p class="muted tiny">@Script.Rounds.TrialProcedure.Phase3</p>
                                <p>Nominated: <b>@Names(trial.NomineeCharacterIds)</b></p>
                                <button class="btn btn-gold btn-sm" @onclick="() => OpenFinalAsync(trial)">
                                    Open the final vote
                                </button>
                                break;

                            case MysteryTrialPhase.FinalVote:
                                <p class="muted tiny">@Script.Rounds.TrialProcedure.Phase4</p>
                                <button class="btn btn-gold btn-sm" @onclick="() => CloseFinalAsync(trial)">
                                    Close and convict
                                </button>
                                break;

                            case MysteryTrialPhase.Revealed:
                                <p>Convicted: <b>@Names(trial.ConvictedCharacterIds)</b></p>
                                break;
                        }

                        @if (_tied.Count > 0)
                        {
                            @* The one place a trial can genuinely stop. Both routes out are here. *@
                            <div class="mys-tie">
                                <h4>Tied at the cut</h4>
                                <p class="tiny">@Names(_tied) — @Script.Rounds.TrialProcedure.Phase5</p>
                                <div class="row gap wrap">
                                    <button class="btn btn-sm" @onclick="() => ResolveTieAsync(trial)">
                                        Use the earlier tally
                                    </button>
                                    @foreach (var id in _tied)
                                    {
                                        var pick = id;
                                        <button class="btn btn-xs" @onclick="() => ForceConvictAsync(trial, pick)">
                                            Convict @Name(pick)
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <details class="mys-force">
                            <summary class="tiny muted">Force a conviction</summary>
                            <p class="tiny muted">
                                For the case nobody predicted. Picks two and closes the trial.
                            </p>
                            <div class="mys-chips">
                                @foreach (var member in Living)
                                {
                                    var id = member.CharacterId;
                                    var picked = _forced.Contains(id);
                                    <button class="mys-chip @(picked ? "on" : "")" @onclick="() => Toggle(id)">
                                        @Name(id)
                                    </button>
                                }
                            </div>
                            <button class="btn btn-danger-ghost btn-sm" disabled="@(_forced.Count == 0)"
                                    @onclick="() => ForceConvictManyAsync(trial)">
                                Convict @_forced.Count and close
                            </button>
                        </details>
                    }
                </div>
            }
            else
            {
                <p class="muted">
                    The current round is not a trial. @(Trip.Mystery.Trials.Count(t => t.ClosedAt is not null))
                    of @Script.Rounds.Trials.Count() done.
                </p>
            }

            @if (Trip.Mystery.Trials.Any(t => t.ClosedAt is not null))
            {
                <div class="card">
                    <h4>Convicted so far</h4>
                    <ul class="mys-list">
                        @foreach (var trial in Trip.Mystery.Trials.Where(t => t.ClosedAt is not null))
                        {
                            <li>
                                <span class="muted tiny">@RoundName(trial.RoundId)</span>
                                @foreach (var id in trial.ConvictedCharacterIds)
                                {
                                    <span class="mys-tag @(IsKiller(id) ? "killer" : "")">@Name(id)</span>
                                }
                            </li>
                        }
                    </ul>
                    <p class="tiny">
                        Killers caught: <b>@KillersConvicted of 3</b> —
                        @(KillersConvicted >= 2 ? "town has won on the tally" : "killers ahead")@(EndsEarly ? ", and that is a clean sweep" : "")
                    </p>
                    @if (EndsEarly || AllTrialsDone)
                    {
                        <button class="btn btn-gold btn-sm" @onclick="EndAsync">Go to the reveal</button>
                    }
                </div>
            }
        </SectionCard>

        @* --- the guilty list -------------------------------------------------------- *@
        <SectionCard Title="Who did it"
                     Subtitle="The whole solution. This page is the fallback for anything the app cannot do.">
            <div class="mys-guilty">
                @foreach (var slot in new[] { "access", "means", "signature" })
                {
                    var killer = Deal.Cast.FirstOrDefault(c => c.GuiltSlot == slot);
                    if (killer is null) continue;

                    <div class="card mys-killer">
                        <h4>@slot</h4>
                        <p class="mys-name">@Name(killer.CharacterId)</p>
                        <p class="muted tiny">
                            @ZoneName(killer.ZoneId) · played by @PersonName(killer.PersonId)
                        </p>
                        <p class="tiny">Points at <b>@Name(Compiler.HerringFor(Deal, slot)?.CharacterId)</b></p>
                    </div>
                }
            </div>

            <div class="card">
                <h4>Red herrings</h4>
                <p>@Names([.. Deal.Herrings.Select(h => h.CharacterId)])</p>
                <p class="muted tiny">
                    Innocent, showing their guilty reading. Cleared by name at the reveal.
                </p>
            </div>

            <div class="mys-factions">
                @foreach (var faction in Script.Factions.Factions.Where(f => f.Id != "killer"))
                {
                    <div class="card">
                        <h4>@faction.Name</h4>
                        <p class="tiny">@Names([.. Deal.InFaction(faction.Id).Select(m => m.CharacterId)])</p>
                    </div>
                }
            </div>

            <details>
                <summary class="tiny muted">The whole cast, by room</summary>
                <div class="mys-zones">
                    @foreach (var zone in Script.Zones.Playable)
                    {
                        <div class="card">
                            <h4>@zone.Name</h4>
                            <ul class="mys-list">
                                @foreach (var member in Deal.InZone(zone.Id))
                                {
                                    <li class="tiny">
                                        <span class="mys-tag @TagFor(member)">@Name(member.CharacterId)</span>
                                        <span class="muted">@PersonName(member.PersonId)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </details>
        </SectionCard>

        @* --- clues ------------------------------------------------------------------- *@
        <SectionCard Title="Clue cards" Subtitle="@ClueLine">
            <div class="mys-clues">
                @foreach (var clue in Trip.Mystery.Clues)
                {
                    <div class="card">
                        <div class="row between center">
                            <h4>@ZoneName(clue.ZoneId)</h4>
                            @if (clue.Found)
                            {
                                <span class="mys-tag">found</span>
                            }
                        </div>
                        <p class="tiny">@Compiler.ClueText(Script, clue, Deal)</p>
                        @if (clue.TraceCharacterId is { } owner)
                        {
                            <p class="muted tiny">@Name(owner)'s trace</p>
                        }
                        @if (clue.Tamper is { } tamper)
                        {
                            <p class="mys-tampered tiny">
                                tampered — @tamper.Mode by @Name(tamper.ByCharacterId)
                            </p>
                        }
                        <p class="muted tiny mys-token">@clue.Token</p>
                    </div>
                }
            </div>
        </SectionCard>

        @if (IsDev)
        {
            @* Local-only testing aid, the same shape as the Jeopardy board's. Never reaches
               Azure — IsDev is IWebHostEnvironment.IsDevelopment(). *@
            <section class="jeo-testing">
                <button class="btn btn-ghost btn-sm" @onclick="() => _testingOpen = !_testingOpen">
                    🧪 Testing tools @(_testingOpen ? "▲" : "▼")
                </button>

                @if (_testingOpen)
                {
                    <div class="jeo-testing-panel">
                        @* The tedium of twenty-one people, skipped. Each button does exactly what
                           the room would do, through the same service calls, so nothing here can
                           put the game in a state real play could not. *@
                        <div class="row gap wrap">
                            @if (MysteryService.SeatsLeft(Trip) > 0)
                            {
                                <button class="btn btn-ghost btn-xs" @onclick="FillRoomAsync">⚡ Fill the room</button>
                            }
                            @if (MysteryService.CurrentTrial(Trip) is { } openTrial
                                 && openTrial.Phase is MysteryTrialPhase.OpenVote or MysteryTrialPhase.FinalVote)
                            {
                                <button class="btn btn-ghost btn-xs" @onclick="EverybodyVotesAsync">⚡ Everybody votes</button>
                            }
                            @if (Trip.Mystery.Clues.Any(c => !c.Found))
                            {
                                <button class="btn btn-ghost btn-xs" @onclick="FindAllCluesAsync">⚡ Find the remaining clues</button>
                            }
                        </div>

                        @* Real /m pages, embedded — not a hand-rolled stand-in — so what you're
                           testing against is exactly what a phone in the room would show: votes,
                           abilities, the ghost state, all of it live against this game.

                           They go through ?as= rather than a sign-in: identity lives in a cookie,
                           and same-origin iframes share this page's, so frames signing in would
                           fight over one session — the same reason the buzzer strip works this way. *@
                        <div class="row gap wrap mys-sim-picks">
                            <button class="btn btn-xs" @onclick="() => ShowSim(GuiltyIds)">The guilty six</button>
                            <button class="btn btn-xs" @onclick='() => ShowSim(Deal!.InFaction("detective").Select(m => m.CharacterId))'>Detectives</button>
                            <button class="btn btn-xs" @onclick="() => ShowSim(Deal!.Cast.Select(c => c.CharacterId))">Everyone</button>
                            <button class="btn btn-ghost btn-xs" @onclick="() => _simShown.Clear()">None</button>
                        </div>
                        <div class="mys-chips">
                            @foreach (var member in Deal!.Cast)
                            {
                                var id = member.CharacterId;
                                <button class="mys-chip @(_simShown.Contains(id) ? "on" : "")" @onclick="() => ToggleSim(id)">
                                    @Name(id)
                                </button>
                            }
                        </div>

                        <div class="jeo-simstrip-row">
                            @foreach (var id in _simShown)
                            {
                                <div class="jeo-simcard mys-simcard" @key="id">
                                    <span class="jeo-simcard-label">@Name(id)@(IsKiller(id) ? " 🔪" : "")</span>
                                    <iframe class="jeo-simframe mys-simframe" src="@SimUrl(id)"
                                            title="@($"Test phone — {Name(id)}")"></iframe>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        }
    }

</div>
</AdminOnly>

@code {
    protected override TripArea Watching => TripArea.Mystery;

    private int _seed = Random.Shared.Next(1, 999999);
    private string? _error;
    private ConfirmDialog? _confirm;

    // ---- dev testing harness --------------------------------------------------------------

    private bool IsDev => Env.IsDevelopment();
    private bool _testingOpen;

    /// <summary>Which phones the sim strip shows. Empty by default — every frame is a whole
    /// Blazor circuit, and twenty-one of them is a choice, not a landing page.</summary>
    private readonly HashSet<string> _simShown = [];

    private IEnumerable<string> GuiltyIds =>
        Deal?.Cast.Where(c => c.ShowsGuilty).Select(c => c.CharacterId) ?? [];

    private void ShowSim(IEnumerable<string> ids)
    {
        _simShown.Clear();
        foreach (var id in ids) _simShown.Add(id);
    }

    private void ToggleSim(string characterId)
    {
        if (!_simShown.Remove(characterId)) _simShown.Add(characterId);
    }

    /// <summary>A phone acting as one character. Honoured by /m only in Development.</summary>
    private string SimUrl(string characterId) =>
        Nav.ToAbsoluteUri($"/m?as={characterId}").ToString();

    /// <summary>Everybody left outside picks up a part, exactly as they would at the door.</summary>
    private Task FillRoomAsync() => Flush(t =>
    {
        foreach (var person in MysteryService.Unclaimed(t).ToList())
            MysteryService.ClaimCharacter(t, person.Id, Random.Shared);
    });

    /// <summary>
    /// Every living player who has not voted yet does, through the same rule checks a phone goes
    /// through — nominees still cannot vote in the final, ghosts still cannot vote at all. Spread
    /// over a few targets so the cuts have something to bite on.
    /// </summary>
    private Task EverybodyVotesAsync() => Flush(t =>
    {
        if (MysteryService.CurrentTrial(t) is not { } trial) return;

        var living = MysteryService.Living(t).Select(c => c.CharacterId).ToList();

        var targets = trial.Phase == MysteryTrialPhase.FinalVote
            ? trial.NomineeCharacterIds.ToList()
            : [.. living.OrderBy(_ => Random.Shared.Next()).Take(5)];

        if (targets.Count == 0) return;

        var ballots = trial.Phase == MysteryTrialPhase.FinalVote ? trial.FinalVotes : trial.OpenVotes;
        var voted = ballots.Select(v => v.VoterCharacterId).ToHashSet(StringComparer.Ordinal);

        foreach (var voter in living.Where(id => !voted.Contains(id)))
        {
            var pool = targets.Where(x => x != voter).ToList();
            if (pool.Count == 0) continue;

            MysteryService.CastVote(t, trial, voter, pool[Random.Shared.Next(pool.Count)], Clock.UtcNow);
        }
    });

    /// <summary>Walk the house in one click: every unfound card found, each by somebody living.</summary>
    private Task FindAllCluesAsync() => Flush(t =>
    {
        var living = MysteryService.Living(t).Select(c => c.CharacterId).ToList();
        if (living.Count == 0) return;

        foreach (var clue in t.Mystery.Clues.Where(c => !c.Found))
            MysteryService.RecordClueFound(t, clue, living[Random.Shared.Next(living.Count)], Clock.UtcNow);
    });
    private List<string> _tied = [];
    private readonly HashSet<string> _forced = [];

    private MysteryDeal? Deal => Trip.Mystery.Deal;
    private ScriptRound? CurrentRound => MysteryService.CurrentRound(Trip, Script);
    private IReadOnlyList<MysteryCastMember> Living => [.. MysteryService.Living(Trip)];

    /// <summary>The 21 guests. The four organizers run the evening and are not cast.</summary>
    private List<RosterPerson> Players => [.. Trip.Roster.Where(p => p.Role != TripRole.Admin)];

    /// <summary>Guests who have not picked up a part yet — the arrivals list.</summary>
    private IReadOnlyList<RosterPerson> Waiting => MysteryService.Unclaimed(Trip);

    private int Claimed => Deal?.Cast.Count(c => c.PersonId is not null) ?? 0;

    private string JoinHost => new Uri(Nav.BaseUri).Authority;

    /// <summary>The QR for the wall: scanning it lands on the name picker, code already filled in.</summary>
    private string JoinUrl => Nav.ToAbsoluteUri($"/join/{Trip.Mystery.PartyCode}").ToString();

    /// <summary>The organizers' QR. Only ever rendered on this page, which is AdminOnly.</summary>
    private string HostUrl => Nav.ToAbsoluteUri($"/join/{Trip.Mystery.HostCode}").ToString();

    private int KillersConvicted =>
        Deal is null ? 0 : Deal.Killers.Count(k => MysteryService.IsGhost(Trip, k.CharacterId));

    private bool EndsEarly => MysteryService.ShouldEndEarly(Trip);
    private bool AllTrialsDone => MysteryService.AllTrialsComplete(Trip, Script);

    private string HeaderLine => Deal is null
        ? $"{Script.Characters.Count} characters, {Script.Zones.Playable.Count()} rooms, {Script.Rounds.ScheduledMinutes} minutes."
        : Trip.Mystery.Active ? "Running." : "Dealt, not started.";

    private string RoundLine => CurrentRound is { } round
        ? $"{round.Name} — {round.Minutes} minutes"
        : "Not started.";

    private string TrialLine =>
        $"Top four nominated, top two convicted. Town wins at two killers caught, evaluated after the third trial.";

    private string ClueLine =>
        $"{Trip.Mystery.Clues.Count(c => c.Found)} of {Trip.Mystery.Clues.Count} found · " +
        $"{Trip.Mystery.Clues.Count(c => c.Tamper is not null)} tampered";

    private string RouteLabel => Deal is not null
        && Script.Zones.AccessRoutes.TryGetValue(Deal.AccessRoute, out var route)
            ? route.Label
            : "—";

    /// <summary>
    /// Content the compiler cannot fill, and abilities that could never unlock. Both are failures
    /// that otherwise stay invisible until the moment they matter.
    /// </summary>
    private List<string> Warnings
    {
        get
        {
            var warnings = new List<string>();
            warnings.AddRange(MysteryService.UnreachableUnlocks(Script).Select(u => $"Ability never unlocks: {u}"));
            warnings.AddRange(Compiler.MissingFragments(Script).Select(m => $"Missing text: {m}"));
            return warnings;
        }
    }

    private string Name(string? characterId) =>
        characterId is null ? "—" : Script.CharacterById(characterId)?.Name ?? characterId;

    private string Names(IReadOnlyList<string> ids) =>
        ids.Count == 0 ? "—" : string.Join(", ", ids.Select(Name));

    private string ZoneName(string zoneId) => Script.Zones.ById(zoneId)?.Name ?? zoneId;

    private string RoundName(string roundId) => Script.Rounds.ById(roundId)?.Name ?? roundId;

    private string PersonName(string? personId) =>
        personId is null ? "uncast" : Trip.Roster.FirstOrDefault(p => p.Id == personId)?.Name ?? personId;

    private bool IsKiller(string characterId) =>
        Deal?.Cast.Any(c => c.CharacterId == characterId && c.IsKiller) == true;

    private string TagFor(MysteryCastMember member) => member switch
    {
        { IsKiller: true } => "killer",
        { IsHerring: true } => "herring",
        _ => ""
    };

    private void Toggle(string characterId)
    {
        if (!_forced.Remove(characterId)) _forced.Add(characterId);
    }

    // ---- actions ---------------------------------------------------------------------------

    private async Task DealAsync()
    {
        _error = null;

        // Nobody is cast here. The deal decides what the 21 characters are; guests pick up a part
        // themselves by typing the party code and tapping their name.
        var failure = await Store.MutateAsync(
            t => MysteryService.DealGame(t, Script, _seed), TripArea.Mystery);

        if (failure is not null) _error = failure.Reason;
    }

    private void AskToDiscard() => _confirm?.Show(
        "The cast, the guilty list and every clue card go. Anything already printed stops matching.",
        ClearAsync,
        confirmLabel: "Discard",
        title: "Discard this game?");

    private Task ClearAsync() => MutateAsync(MysteryService.Clear);

    private Task StartAsync() => Flush(MysteryService.Start);

    private Task GoToRoundAsync(int index) =>
        Flush(t => MysteryService.GoToRound(t, Script, index));

    private Task OpenTrialAsync(string roundId) =>
        Flush(t => MysteryService.OpenTrial(t, roundId, Clock.UtcNow));

    private async Task CloseOpenAsync(MysteryTrial trial)
    {
        await Flush(t => MysteryService.CloseOpenVote(t, trial));
        _tied = [];
    }

    private Task OpenFinalAsync(MysteryTrial trial) =>
        Flush(_ => MysteryService.OpenFinalVote(trial));

    private async Task CloseFinalAsync(MysteryTrial trial)
    {
        var close = await Store.MutateAsync(
            t => MysteryService.CloseFinalVote(t, trial, Clock.UtcNow), TripArea.Mystery);

        _tied = close.Kind == VoteCloseKind.RevoteNeeded ? [.. close.CharacterIds] : [];
        await Store.FlushAsync();
    }

    private async Task ResolveTieAsync(MysteryTrial trial)
    {
        var tied = _tied;
        var close = await Store.MutateAsync(
            t => MysteryService.ResolveTieFromOpenVote(t, trial, tied, Clock.UtcNow), TripArea.Mystery);

        _tied = close.Kind == VoteCloseKind.RevoteNeeded ? [.. close.CharacterIds] : [];
        await Store.FlushAsync();
    }

    private async Task ForceConvictAsync(MysteryTrial trial, string characterId)
    {
        await Flush(t => MysteryService.ForceConvict(t, trial, [characterId], Clock.UtcNow));
        _tied = [];
    }

    private async Task ForceConvictManyAsync(MysteryTrial trial)
    {
        var picked = _forced.ToList();
        await Flush(t => MysteryService.ForceConvict(t, trial, picked, Clock.UtcNow));
        _forced.Clear();
        _tied = [];
    }

    private Task EndAsync() => Flush(t => MysteryService.End(t, Clock.UtcNow));

    /// <summary>
    /// Mutate and force the write out immediately.
    ///
    /// Round advances, convictions and abilities are the handful of events that would be miserable
    /// to reconstruct after a restart mid-evening, so they do not ride the debounce. Scans, shares
    /// and votes still do.
    /// </summary>
    private async Task Flush(Action<TripData> mutate)
    {
        await MutateAsync(mutate);
        await Store.FlushAsync();
    }
}
