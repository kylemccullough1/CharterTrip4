@page "/games/mystery"
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@using CharterTrip.Infrastructure.Mystery
@inherits TripAwareComponent
@inject IClock Clock
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject CharterTrip.Web.Services.SimPhones Sims
@implements IAsyncDisposable

<PageTitle>@Story.Title · Charter Trip 2026</PageTitle>

@* The screen in the room, and before that the door.

   One page rather than two, because they are the same surface at different times of night: the
   thing everybody is looking at. It is deliberately public — a television has no session — so
   nothing that would spoil the evening renders here. The guilty list, the tamper log and every
   control that is not a QR code live on the four staff phones. *@

@* Windowed while people are still arriving — the door is a page you use like any other, and
   hiding the nav to show two QR codes only makes it harder to get back to the rest of the site.
   Once the evening starts it takes the whole screen, because at that point it is a television. *@
<div class="page page-murder ms-screen @(Live ? "is-live" : "")" data-phase="@Phase">

@* The weather. The manor, rain, and lightning now and then — pinned to the viewport under
   everything else, so the door and the television get the same night. It is markup rather than
   a pseudo-element because it takes six layers, and an element has two.

   The house is a picture and the rain is a film, both underneath the lightning: the flash is
   drawn over the photograph, which is what a flash does to a photograph. The rain was shot on
   black, and mix-blend-mode: screen in the stylesheet is what makes the black not there. *@
<div class="ms-storm" aria-hidden="true">
    <i class="ms-storm-sky"></i>
    <i class="ms-storm-manor"></i>
    <i class="ms-storm-sheet"></i>
    <i class="ms-storm-flash"></i>
    <i class="ms-storm-bolt"></i>
    <video class="ms-storm-rain" src="/video/rain.mp4" autoplay muted loop playsinline disablepictureinpicture></video>
</div>

@* One button for the whole soundtrack, on the door and on the television alike. The bee's wall
   has the same one; here it floats, because the evening has no toolbar to put it in. *@
<button class="ms-mute" type="button" title="@(_muted ? "Unmute" : "Mute")" @onclick="ToggleMuteAsync">
    @(_muted ? "🔇" : "🔊")
</button>

@* The way out, from any phase. The lobby's Discard only existed before the evening started; a
   rehearsal that has to be run again from the middle needed the same button on the television.
   Committee only, behind a confirm — the one tap on this page that must never be an accident.
   Never in Game Mode: a red button in the corner of a television is a pixel admitting the game
   is a web page, and the ending screen has its own. *@
@if (HasGame && CanHost)
{
    <button class="ms-reset" type="button" title="Reset the game" @onclick="ConfirmResetAsync">↺ Reset</button>
}

<ConfirmDialog @ref="_confirm" />

@* One screen tall, always, and never more than one screen tall. Every phase used to size to its
   own content, so the lobby had a wall of white space under it and the investigation ran off the
   bottom — the two failures look nothing alike and have the same cause. The testing strip is
   deliberately outside it: that one is meant to be scrolled to. *@
<div class="ms-stage">

@switch (Phase)
{
    // ---------------------------------------------------------------------------- the door
    case MysteryPhase.Lobby:
    case MysteryPhase.Assembling:

        @* No kicker above the name: the name is the whole of the top of the screen.

           The name bleeds. The drips are not in this markup — mystery-blood.js measures each
           word's letters and hangs them in the layer behind the heading, from the feet of the
           glyphs, so the top of every drip is inside a letter and none hangs from the gap in
           an M. Words are their own spans so the script can measure one at a time; the space
           between them is a margin in the stylesheet, because Razor swallows the whitespace. *@
        <section class="ms-head">
            <div class="ms-title-wrap">
                <span class="ms-drips ms-drips-layer" aria-hidden="true"></span>
                <h1 class="ms-title-big is-bleeding">
                    @foreach (var word in Story.Title.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="ms-word">@word</span>
                    }
                </h1>
            </div>
        </section>

        @if (!HasGame)
        {
            <div class="ms-idle">
                <p class="ms-line">Nothing is running yet.</p>

                @if (CanEdit)
                {
                    <div class="row gap wrap center">
                        <button class="btn btn-gold btn-lg" @onclick="CreateAsync">Create the game</button>

                        @* The story editor is the website behind the evening, so Game Mode takes it. *@
                        @if (CanHost)
                        {
                            <a class="btn btn-ghost btn-sm" href="/games/mystery/story">Edit the story</a>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">Somebody with the committee's login starts this one.</p>
                }
            </div>
        }
        else
        {
            @* One column: the door, the count, and under them the people who have come
               through — faces and names, filling in as they arrive, the way the bee's wall
               does it. Their own names: who they are playing is for their phone, and a
               character's name and job on the wall is a spoiler for whoever reads it. *@
            <div class="ms-lobby">
              <div class="ms-lobby-doors">
                <div class="mys-doors">
                    <div class="mys-door is-bleeding">
                        <QrImage Content="@JoinUrl(Play.PartyCode)" Size="190" Alt="Join the party" />
                        <p class="mys-code">@Play.PartyCode</p>
                        <p class="mys-door-who">Everybody</p>
                        @* One paragraph, not two. The lobby is exactly one screen tall and the
                           arrivals count sits under this — every line here is a line of that. *@
                        <p class="muted tiny">
                            Point a camera at it, or go to <b>@JoinHost/join</b> and type it.
                        </p>
                        @Drips(DoorDrips)
                    </div>
                </div>

                @* The count, and nothing after it. The host's console carries the "waiting on…"
                   sentence, beside the button it is blocking, which is the one place somebody can
                   act on it. Here it read "0 of 25 here · Waiting on James Braun, Leo Raphael,
                   Chloe Zimmerman and Bertram Ault, and 21 guests are not here yet" — the same
                   fact the count already gave, plus a list of names the hall cannot do anything
                   about, on the screen with the least room for either. Now it is the fraction
                   and nothing else: the wall beside it is who, this is only how many. *@
                <p class="ms-count">
                    <b>@Seated</b>/@Play.Cast.Count
                </p>

                <div class="ms-arrivals">
                    @foreach (var seat in Arrived)
                    {
                        var name = Trip.Roster.FirstOrDefault(p => p.Id == seat.PersonId)?.Name ?? "";
                        <div class="ms-arrival" @key="seat.CharacterId">
                            @if (seat.PhotoUrl is { Length: > 0 })
                            {
                                <img class="ms-portrait" src="@seat.PhotoUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="ms-portrait ms-portrait-monogram" aria-hidden="true">@Monogram(name)</span>
                            }
                            <span class="ms-arrival-name">@name</span>
                        </div>
                    }
                </div>
              </div>
            </div>

            @* Setup, printing and teardown — none of it is the evening itself.

               Game Mode leads, the way it does on the Jeopardy board and the bee's wall. Like both
               of those it is a lobby button and goes when the evening starts — by then the wall has
               put itself into Game Mode anyway, on the phase change. *@
            @if (CanHost)
            {
                <div class="row gap wrap center ms-lobby-actions">
                    <GameModeButton Game="mystery" />

                    @* The other door, which the wall could not point at before.

                       Twenty-one guests come through the code beside this; the four house parts do
                       not, because the guest list is the roster minus the organizers and the parts
                       are refused to anybody who is not one. So the count sticks at 21 of 25 and
                       the screen never said why. The number in the label is the why, and the link
                       is the fix: it lands on the four-part picker with no code to type. *@
                    @if (HousePartsLeft > 0 && MePersonId is { Length: > 0 })
                    {
                        <a class="btn btn-ghost btn-sm" href="@HousePartUrl" target="_blank">
                            Take a house part (@HousePartsLeft left)
                        </a>
                    }

                    <a class="btn btn-ghost btn-sm" href="/games/mystery/story">Edit the story</a>
                    <a class="btn btn-ghost btn-sm" href="/games/mystery/print" target="_blank">Print sheets ↗</a>
                    <a class="btn btn-ghost btn-sm" href="/m">Your phone ↗</a>
                    <button class="btn btn-danger-ghost btn-sm" @onclick="ConfirmResetAsync">Reset the game</button>
                </div>
            }
        }
        break;

    // ------------------------------------------------------------------------- the welcome
    case MysteryPhase.Welcome:
        <section class="ms-welcome">
            <p class="ms-welcome-kicker">You are expected at</p>
            <h1 class="ms-welcome-title">Braun Manor</h1>
            <p class="ms-welcome-sub">@(Written(Beats.Premise) ?? "")</p>
        </section>
        break;

    // -------------------------------------------------------------------------- the briefing
    case MysteryPhase.Presentation:
        @if (Slide is { } slide)
        {
            @* On a card, because a wall of bullets on a storm is a wall of bullets on a storm.
               A slide with a figure — the map — gets two columns, the words beside it. *@
            <section class="ms-slide card @(HasFigure(slide) ? "has-figure" : "")">
                <div class="ms-slide-words">
                    <p class="ms-round">@(Play.SlideIndex + 1) of @Story.Slides.Count</p>
                    <h1 class="ms-slide-title">@slide.Title</h1>

                    <ul class="ms-slide-bullets">
                        @foreach (var line in MysteryText.WrittenOnly(slide.Bullets))
                        {
                            <li>@line</li>
                        }
                    </ul>
                </div>

                @if (slide.Figure is { } fig && fig.StartsWith("role:", StringComparison.Ordinal))
                {
                    @* The phone this role will hold, so the room sees the screen before it is asked
                       to use it. *@
                    <div class="ms-slide-figure">
                        <RoleFigure Trip="Trip" FactionId="@fig["role:".Length..]" />
                    </div>
                }
                else if (slide.Figure == "map")
                {
                    @* The house as the phone will show it, with every card's spot marked. Before
                       the murder the pins are the grey "nobody has found this" kind, which is
                       exactly the "where the cards are" this slide is for. *@
                    <div class="ms-slide-figure">
                        <ManorMap Trip="Trip" ShowPins="true" />
                    </div>
                }
            </section>
        }
        else
        {
            <p class="ms-idle">Nothing to show on this slide yet.</p>
        }
        break;

    // ------------------------------------------------------------------- the introductions
    case MysteryPhase.Introductions:
        @* Everybody in a row under the title, the way the bee's wall does it, and whoever Braun
           has just called on is pulled down out of the row into the middle of the screen and
           blown up. The row never re-sorts — a face you were watching stays where you were
           watching it — so the turn is shown by moving one seat, not by reordering. He steps
           through them from his phone; the phone of whoever is up gets told so. *@
        <section class="ms-head ms-intro-head">
            <p class="ms-round">Introductions · @(Play.IntroIndex + 1) of @IntroOrder.Count</p>
            <h1 class="ms-title-big">Who's in the house</h1>
        </section>

        <div class="ms-intro-row" style="--seats:@IntroOrder.Count">
            @for (var i = 0; i < IntroOrder.Count; i++)
            {
                var character = IntroOrder[i];
                var up = CurrentIntro?.Id == character.Id;
                var done = i < Play.IntroIndex;

                <div class="ms-seat @(up ? "is-up" : "") @(done ? "is-done" : "")" style="--i:@i" @key="character.Id">
                    <Portrait Seat="@Play.ForCharacter(character.Id)" Character="character" />
                    <span class="ms-seat-name">@character.Name</span>
                </div>
            }
        </div>

        <section class="ms-intro-stage">
            @if (CurrentIntro is { } speaking)
            {
                <div class="ms-intro-card" @key="speaking.Id">
                    <h2 class="ms-intro-name">@speaking.Name</h2>
                    <p class="ms-intro-job">@speaking.Job</p>
                </div>
            }
        </section>
        break;

    // --------------------------------------------------------------------------- the murder
    case MysteryPhase.Murder:
        @* White, a clap of thunder, a glass breaking, a body hitting the floor — and then nothing
           but the house and the rain. The flash is the stylesheet's and the sound is the audio
           module's, timed to the same numbers. No words: the butler screams, from wherever he is
           standing, and reads the announcement off his own phone. The screen stays empty until
           the investigation. *@
        <div class="ms-flash" aria-hidden="true"></div>
        break;

    case MysteryPhase.StudyScene:
        @* Still nothing. The study's card has just landed on every guest's phone — that is the
           first clue, and it is theirs to read, not the wall's. *@
        break;

    // -------------------------------------------------------------------- the investigation
    case MysteryPhase.Investigation:
        <section class="ms-head">
            <p class="ms-round">@MysteryPhases.Label(Phase)</p>
            <h1 class="ms-title-big">Nine cards. Nine rooms. Go.</h1>
        </section>

        @* The house, and who is out in it. Nothing about the cards: the television used to
           show every card as it was found and which rooms had been read, which handed twenty-one
           people evidence nine of them had walked to. What somebody has read is on their own
           phone, and only theirs. *@
        <div class="ms-split-map is-wide">
            <ManorMap Trip="Trip" Big="true" />
        </div>

        <div class="ms-grid ms-grid-thumbs">
            @foreach (var seat in Playing)
            {
                var character = Story.Character(seat.CharacterId)!;
                <div class="ms-guest @(TrialService.IsGhost(Trip, character.Id) ? "out" : "")" @key="seat.CharacterId">
                    <Portrait Seat="seat" Character="character" />
                    <span class="ms-guest-name">@character.Name</span>
                </div>
            }
        </div>
        break;

    // ------------------------------------------------------------------- talking it through
    case MysteryPhase.Discussion1:
    case MysteryPhase.Discussion2:
    case MysteryPhase.Discussion3:
        <section class="ms-head">
            <p class="ms-round">@MysteryPhases.Label(Phase)</p>
            <h1 class="ms-title-big">
                @(Phase switch
                {
                    MysteryPhase.Discussion1 => "Who seemed strange?",
                    MysteryPhase.Discussion3 => "Last words",
                    _ => "Talk it through"
                })
            </h1>
        </section>

        @* The floor plan and nothing on it. This used to lay every found card into its room and
           announce that one had been tampered with — but what a card says is only ever on the
           phones of the people who walked to it, and spotting the tampered one is the
           investigators' job, with forensics, on their own phones. The television keeps the
           house, so the room can point at rooms while it argues. *@
        <div class="ms-split-map is-wide">
            <ManorMap Trip="Trip" Big="true" />
        </div>
        break;

    // ---------------------------------------------------------------------------- the trials
    case MysteryPhase.Trial1:
    case MysteryPhase.Trial2:
    case MysteryPhase.Trial3:
        <TrialScreen Trip="Trip" />
        break;

    // ---------------------------------------------------------------------------- the reveal
    case MysteryPhase.Reveal:
        @if (PhaseService.OnRevealOpening(Trip))
        {
            @* How James Braun died, one paragraph to a card so each fits the screen whole. The
               verdict — the gavel falling true or wrong — is the last card of the night, not the
               first: it used to headline this screen at title size, before anybody had been told
               what happened. *@
            <section class="ms-head">
                <p class="ms-round">The whole truth · @(Play.RevealIndex + 1) of @PhaseService.RevealOpening(Trip)</p>
                <h1 class="ms-title-big">How James Braun died</h1>
            </section>

            <div class="ms-reveal card" @key="Play.RevealIndex">
                @if (PhaseService.RevealParagraph(Trip) is { } paragraph)
                {
                    <p class="ms-reveal-para">@paragraph</p>
                }

                @if (Play.RevealIndex == PhaseService.RevealOpening(Trip) - 1
                     && Outcome.RevealDecoy && OutcomeService.ConvictedDecoys(Trip) is { Count: > 0 } decoys)
                {
                    @* Only when it changed the ending: the room thought it had the Syndicate and
                       one of the KILLER cards was an associate. A decoy that made no difference
                       is never named as one. *@
                    <p class="ms-reveal-para is-decoy">
                        One of the KILLER cards was a lie. @Names(decoys) took the blame for the
                        Syndicate, and the room believed it.
                    </p>
                }
            </div>
        }
        else if (PhaseService.RevealSubject(Trip) is { } card)
        {
            @* One winner at a time, keyed on who so every step gets its own entrance rather than
               the browser quietly reusing the previous card's DOM and animating nothing. Who they
               were, why they did it, and what they got away with. *@
            <section class="ms-truth card @(card.Group ? "is-group" : "")" @key="card.Character.Id">
                <p class="ms-round">@(Play.RevealIndex - PhaseService.RevealOpening(Trip) + 1) of @OutcomeService.Reveal(Trip).Count · @(Outcome.TownWon ? "the house wins" : "the Syndicate wins")</p>

                @if (card.Group)
                {
                    <h1 class="ms-truth-name">@(card.Faction?.Name ?? "The guests")</h1>

                    <div class="ms-grid ms-grid-thumbs ms-truth-people">
                        @foreach (var person in card.Characters)
                        {
                            <div class="ms-guest" @key="person.Id">
                                <Portrait Seat="@Play.ForCharacter(person.Id)" Character="person" />
                                <span class="ms-guest-name">@person.Name</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <Portrait Seat="@Play.ForCharacter(card.Character.Id)" Character="card.Character" />

                    <h1 class="ms-truth-name">@card.Character.Name</h1>
                    <p class="ms-truth-job">@card.Character.Job</p>

                    <p class="ms-truth-faction @(card.Character.IsKiller ? "is-killer" : "")">
                        @(card.Faction?.Name ?? "On their own")
                        @if (card.Character.GuiltSlot is { } slot)
                        {
                            <span class="ms-truth-slot">@slot</span>
                        }
                    </p>
                }

                @if (card.Blurb is { } blurb)
                {
                    <p class="ms-truth-blurb">@blurb</p>
                }

                @if (card.Deeds.Count > 0)
                {
                    <ul class="ms-truth-deeds">
                        @foreach (var deed in card.Deeds)
                        {
                            <li>@deed</li>
                        }
                    </ul>
                }

                @if (!card.Group)
                {
                    <p class="ms-truth-verdict">
                        @if (card.Convicted)
                        {
                            <span class="is-win">Taken away — and won anyway.</span>
                        }
                        else
                        {
                            <span class="is-win">Walked out a winner.</span>
                        }
                    </p>
                }
            </section>
        }
        else
        {
            @* The last screen of the night, and the only one that gets confetti. The ending is on a
               card the room can read, with the way out under it: home, or the whole thing again. *@
            <section class="ms-victors">
                <div class="jeo-win-burst" aria-hidden="true">
                    @for (var i = 0; i < 12; i++)
                    {
                        <span style="--i:@i"></span>
                    }
                </div>

                <p class="ms-round">@(Outcome.TownWon ? "The house wins" : "The Syndicate wins")</p>

                <article class="ms-ending card">
                    <p class="ms-ending-text">@RevealHeadline</p>
                </article>

                <div class="row gap wrap center ms-ending-actions">
                    <a class="btn btn-gold btn-lg" href="/">That's the night</a>
                    @if (CanEdit)
                    {
                        <button class="btn btn-danger-ghost btn-lg" @onclick="ConfirmResetAsync">Reset the game</button>
                    }
                </div>
            </section>
        }
        break;
}

</div>

@if (HasGame)
{
    @* Twenty-five phones without twenty-five phones, on the rail every game shares now.

       What stays here is only what is this game's: the shortcuts for the things a laptop genuinely
       cannot do by walking around the house, and the three places a frame can be driven. Both go
       through the same service call the real page does, so nothing here can produce a state the
       evening could not have reached on its own.

       Phones, not characters. Each frame is a real front door at /join?sim=N: type the code, tap a
       name, read the letter, land on the sheet. Choosing who each phone is ahead of time skipped
       the only part worth testing. *@
    <TestPhones Game="mystery" Landing="@(_skipLetter ? "/m" : "/m/welcome")" Seats="@SimPhones.MaxPhones"
                Door="@SeatOne"
                Destinations="@PhoneStops"
                GroupOf="@FactionOf" GroupLabel="faction">
        <Chips>
            @* Straight to the sheet. The photo and the letter are the front door and worth walking
               once; the twentieth time, they are twenty taps between a frame and the thing being
               tested. Signing in with this on marks the letter read, exactly as tapping through
               it would have. *@
            <button class="chip @(_skipLetter ? "on" : "")" @onclick="() => _skipLetter = !_skipLetter">
                ✉ Skip the letter@(_skipLetter ? " · on" : "")
            </button>

            @* Becoming one of the house parts, the way the bee and the board both do it: a real
               second tab rather than a frame in the rail.

               A frame cannot do this and is not meant to. It carries a sim slot rather than a
               person, and CanTakeTheHostJob is deliberately `!IsSim && …` — a frame shares this
               laptop's cookie, so a sim phone that could take a house part would be every test
               phone holding the guilty list. The way through is the same one the bee's "Host
               phone ↗" and the board's "Host sheet ↗" use: open a tab that carries your own
               sign-in. This is that tab, pointed at the four-part picker. *@
            @if (HousePartsLeft > 0 && MePersonId is { Length: > 0 })
            {
                <a class="chip" href="@HousePartUrl" target="_blank" rel="noopener">🎭 Take a house part ↗</a>
            }

            <a class="chip" href="/m" target="_blank" rel="noopener">📱 Your console ↗</a>

            <button class="chip" @onclick="EverybodyVotesAsync">⚡ Everybody votes</button>
            <button class="chip" @onclick="SplitTheVoteAsync">⚡ Split the vote four ways</button>
            <button class="chip" @onclick="SeatTheHousePartsAsync">⚡ Seat the house parts</button>
            <button class="chip" @onclick="MeetEverybodyAsync">⚡ Everybody mingles</button>
            <button class="chip" @onclick="FindEveryClueAsync">⚡ Find every clue</button>
            <button class="chip" @onclick="TamperOneAsync">⚡ Somebody tampers</button>
        </Chips>
    </TestPhones>
}

</div>

@code {
    protected override TripArea Watching => TripArea.Mystery;

    /// <summary>The phase this screen last rendered, for spotting the evening starting. See
    /// <c>OnAfterRenderAsync</c> for why it is not shared with the audio's <c>_heard</c>.</summary>
    private MysteryPhase _seen;

    /// <summary>How many were seated at the last render, so an arrival can be turned into a
    /// chime — the way the bee's wall does it, by comparing this render against the last one,
    /// because the tap that seated them happened on a phone and not here.</summary>
    private int _seenSeated;

    private MysteryState Game => Trip.Mystery;
    private MysteryStory Story => Game.Story;
    private MysteryPlay Play => Game.Play;
    private MysteryBeats Beats => Story.Beats;
    private MysteryPhase Phase => Game.Phase;
    /// <summary>
    /// The ending, computed if nothing has written it down. See <c>OutcomeService.Current</c> — a
    /// game that reached Reveal before the phase machine settled it used to headline the last
    /// screen of the night with an ellipsis.
    /// </summary>
    private MysteryOutcome Outcome => OutcomeService.Current(Trip);

    /// <summary>Doors are open once both codes exist.</summary>
    private bool HasGame => Play.PartyCode is { Length: > 0 };

    /// <summary>The evening is running, so this is a television rather than a page.</summary>
    private bool Live => MysteryPhases.AtOrAfter(Phase, MysteryPhase.Welcome);

    private int Seated => Play.Cast.Count(c => c.PersonId is not null);

    /// <summary>Up to two letters of a person's name, for a face the camera has not taken yet.</summary>
    private static string Monogram(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant()
        };
    }

    private IEnumerable<MysteryCastMember> Arrived =>
        Play.Cast.Where(c => c.PersonId is not null).OrderBy(c => c.JoinedAt);

    /// <summary>Everybody in the game, which is everybody but the four running it.</summary>
    private IEnumerable<MysteryCastMember> Playing =>
        Play.Cast.Where(c => Story.Character(c.CharacterId) is { IsStaff: false });

    private MysterySlide? Slide => PhaseService.CurrentSlide(Trip);

    /// <summary>Whether this slide's figure is one the wall knows how to draw. The others get the width back.</summary>
    private static bool HasFigure(MysterySlide slide) =>
        slide.Figure == "map" || slide.Figure?.StartsWith("role:", StringComparison.Ordinal) == true;

    private IReadOnlyList<MysteryCharacter> IntroOrder => PhaseService.IntroOrder(Trip);
    private MysteryCharacter? CurrentIntro => PhaseService.CurrentIntro(Trip);

    /// <summary>"Giuliana Andolpho" or "Giuliana Andolpho and Sutton Brady".</summary>
    private static string Names(IReadOnlyList<MysteryCharacter> people) => people.Count switch
    {
        0 => "Somebody",
        1 => people[0].Name,
        _ => string.Join(", ", people.Take(people.Count - 1).Select(p => p.Name)) + " and " + people[^1].Name
    };
    private string RevealHeadline => Outcome.TownWon
        ? Written(Beats.TownWin) ?? "They caught them."
        : Written(Beats.KillerWin) ?? "They got away with it.";

