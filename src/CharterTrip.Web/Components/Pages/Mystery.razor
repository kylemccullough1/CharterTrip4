    private IJSObjectReference? _audio;
    private IJSObjectReference? _blood;
    private MysteryPhase? _heard;
    private bool _muted;

    private async Task ToggleMuteAsync()
    {
        _muted = !_muted;

        try
        {
            _audio ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mystery-audio.js");
            await _audio.InvokeVoidAsync("setMuted", _muted);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* no audio on this device; the button still records the wish */ }
    }

    /// <summary>
    /// The bed for a phase, or null for the phases that want silence.
    ///
    /// Named per phase rather than started and stopped at each transition, so a forgotten stop
    /// cannot leave two pieces of music running for the rest of the night.
    ///
    /// The theme (MurderMysteryMain.mp3) runs from the moment the door opens through the party,
    /// and comes back for the reveal. The murder is the one silence — the scream needs it. The
    /// study has thunder rolling through it (the third clap, looped); the investigation and the
    /// deliberations have the sneaking piece; the trials and the votes inside them have their own.
    /// </summary>
    private static string? BedFor(MysteryPhase phase) => phase switch
    {
        MysteryPhase.Lobby or MysteryPhase.Assembling => "main",
        MysteryPhase.Welcome or MysteryPhase.Presentation or MysteryPhase.Introductions => "main",
        MysteryPhase.Reveal => "main",
        MysteryPhase.StudyScene => "study",
        MysteryPhase.Investigation => "sneak",
        MysteryPhase.Discussion1 or MysteryPhase.Discussion2 or MysteryPhase.Discussion3 => "sneak",
        MysteryPhase.Trial1 or MysteryPhase.Trial2 or MysteryPhase.Trial3 => "trial",
        _ => null
    };

    /// <summary>
    /// Which verdict card was last turned, as "phase/index", so a turn can be heard. Compared
    /// render to render like the arrivals are, because the tap that turned it was on Braun's phone.
    /// </summary>
    private string? _seenVerdict;

    private string? VerdictMark =>
        TrialService.Current(Trip) is { Stage: MysteryTrialStage.Verdict } trial
            ? $"{trial.Phase}/{trial.VerdictIndex}"
            : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Snapshotted and written back before anything below can block. A refused or suspended
        // AudioContext does not fail, it waits — and bookkeeping left on the far side of that wait
        // would leave the wall comparing against a phase it rendered ten minutes ago. The bee's
        // wall keeps its own phase field for the same reason, and this is why it is not _heard:
        // that one only moves when the audio module loaded.
        var wasPhase = _seen;
        _seen = Phase;

        var wasSeated = _seenSeated;
        _seenSeated = Seated;

        var wasVerdict = _seenVerdict;
        _seenVerdict = VerdictMark;

        // The name's blood, whenever the name is on screen. Keyed inside the script on the title
        // and its size, so the render that follows somebody walking in costs nothing.
        if (!Live && _blood is not null)
        {
            try { await _blood.InvokeVoidAsync("bleed", ".ms-title-wrap"); } catch (JSDisconnectedException) { }
        }

        if (firstRender)
        {
            try
            {
                _blood = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mystery-blood.js");
                if (!Live) await _blood.InvokeVoidAsync("bleed", ".ms-title-wrap");

                _audio = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mystery-audio.js");

                // Adopt the phase we are already in rather than treating it as a transition, so a
                // screen opened at ten o'clock joins the soundtrack instead of replaying the murder
                // at whoever just walked in.
                _heard = Phase;
                await _audio.InvokeVoidAsync("setBed", BedFor(Phase));

                // The weather: rain under everything for as long as the page is open, and
                // lightning on its own irregular clock with the thunder that goes with it.
                await _audio.InvokeVoidAsync("setAmbience", true);
                await _audio.InvokeVoidAsync("startStorm");
            }
            catch (JSDisconnectedException) { }

            return;
        }

        // The evening just started, and it can only have started somewhere else — the button is on
        // Braun's phone. This is the moment the page stops being something somebody opened and
        // becomes the television, which is what the note at the top of this file has always said it
        // should do. GameModeScope handles the chrome and the browser's opinion about full screen;
        // nothing here waits on either.
        //
        // On the transition only, never on load: a committee laptop opened mid-evening to check
        // something is not a television, and taking its display would be a nasty surprise.
        if (!MysteryPhases.AtOrAfter(wasPhase, MysteryPhase.Welcome) && Live) GameMode.Enter("mystery");

        if (_audio is null) return;

        // Somebody walked in. Only while the door is open: the count also moves when the house
        // parts are seated mid-evening, and that is not an arrival anybody is watching for.
        if (!Live && Seated > wasSeated)
        {
            try { await _audio.InvokeVoidAsync("joined"); } catch (JSDisconnectedException) { }
        }

        // A card turned face up: the cell door. Only on a turn, never on the verdict opening or on
        // a screen that arrived mid-verdict — the mark has to have moved within the same trial.
        if (VerdictMark is { } mark && wasVerdict is { } before && mark != before
            && mark.Split('/')[0] == before.Split('/')[0]
            && int.Parse(mark.Split('/')[1]) > int.Parse(before.Split('/')[1]))
        {
            try { await _audio.InvokeVoidAsync("cellDoor"); } catch (JSDisconnectedException) { }
        }

        if (_heard == Phase) return;

        var entered = Phase;
        _heard = entered;

        try
        {
            // Cues follow the phase change, not the button, so every open screen hears the same
            // thing at the same moment however the phase was advanced.
            if (entered == MysteryPhase.Murder) await _audio.InvokeVoidAsync("murder");

            await _audio.InvokeVoidAsync("setBed", BedFor(entered));
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_blood is not null)
        {
            try { await _blood.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _blood.DisposeAsync(); } catch (JSDisconnectedException) { }
        }

        if (_audio is null) return;

        try { await _audio.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
        try { await _audio.DisposeAsync(); } catch (JSDisconnectedException) { }
    }

