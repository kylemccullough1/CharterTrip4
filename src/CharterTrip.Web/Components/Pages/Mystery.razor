    /// <summary>
    /// A drip: where along the edge (percent), how long it runs (px), how wide (px), how long a
    /// cycle takes (s) and how far into it it starts (s, negative so they are never in step).
    /// </summary>
    private readonly record struct Drip(int X, int Length, int Width, int Period, int Offset);

    /// <summary>Off the door's bottom edge. Shorter — the count sits underneath.</summary>
    private static readonly Drip[] DoorDrips =
    [
        new(6, 24, 6, 8, -2), new(21, 14, 4, 11, -6), new(38, 30, 7, 7, -4),
        new(57, 18, 5, 9, -1), new(74, 26, 6, 8, -5), new(90, 12, 4, 10, -3)
    ];

    /// <summary>
    /// The drips, as markup: one element each, told where and how by custom properties, with the
    /// running and the letting-go done by the stylesheet. Deliberately a fixed set rather than
    /// random ones — a render is not an event, and a lobby that re-drew its blood every time
    /// somebody walked in would look like a bug.
    /// </summary>
    private static RenderFragment Drips(Drip[] drips) => @<span class="ms-drips" aria-hidden="true">
        @foreach (var d in drips)
        {
            <i style="--x:@(d.X)%;--l:@(d.Length)px;--w:@(d.Width)px;--t:@(d.Period)s;--d:@(d.Offset)s"></i>
        }
    </span>;

