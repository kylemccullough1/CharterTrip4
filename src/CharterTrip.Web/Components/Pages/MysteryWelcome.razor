@page "/m/welcome"
@layout BareLayout
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@using Microsoft.AspNetCore.Components.Forms
@inherits TripAwareComponent
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject CharterTrip.Web.Services.SimPhones Sims
@inject CharterTrip.Web.Services.MediaAttachments Attachments
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(Me?.Name ?? "Your invitation")</PageTitle>

@* What happens between scanning the code and holding a character.

   A separate page from /join/{code} and it has to be: that one is static SSR, because writing an
   auth cookie needs an HTTP response, and a file upload needs an interactive circuit. So the door
   signs you in and sends you here, where there is a connection to upload over. *@

@if (Me is null)
{
    <div class="mp-empty">
        <h1 class="mp-title">You're not in this one yet</h1>
        <a class="btn btn-gold btn-sm" href="/join">Join in</a>
    </div>
}
else if (_step == Step.Photo)
{
    <div class="mw">
        <h1 class="mw-title">You are @Me.Name</h1>
        <p class="mw-sub">@Me.Job</p>

        <div class="mw-photo">
            @* The preview is always in the DOM: starting the camera needs an element to attach the
               stream to, and creating one in the same breath is a race the video usually loses. *@
            <video id="mw-cam" class="mw-shot mw-cam @(_camera == Camera.Live ? "" : "is-hidden")"
                   autoplay muted playsinline></video>

            @if (_camera != Camera.Live)
            {
                @if (Seat?.PhotoUrl is { Length: > 0 } photo)
                {
                    <img class="mw-shot" src="@photo" alt="Your photograph" />
                }
                else
                {
                    <span class="mw-shot mw-shot-empty" aria-hidden="true">?</span>
                }
            }
        </div>

        @if (_camera == Camera.Live)
        {
            <button class="btn btn-gold btn-lg mw-shutter @(_busy ? "is-busy" : null)"
                    disabled="@_busy" @onclick="CaptureAsync">Take it</button>
            <button class="btn btn-ghost btn-sm" @onclick="StopCameraAsync">Not now</button>
        }
        else
        {
            <button class="btn btn-gold @(_busy ? "is-busy" : null)" disabled="@_busy"
                    @onclick="StartCameraAsync">
                @(Seat?.PhotoUrl is { Length: > 0 } ? "Take another" : "Take a photograph")
            </button>

            @* Kept behind the camera rather than instead of it. A camera can be refused, missing,
               or blocked by an insecure origin, and none of those should be the end of the road. *@
            <label class="btn btn-ghost btn-sm @(_busy ? "is-busy" : null)">
                Choose a picture instead
                <InputFile OnChange="OnPickedAsync" accept="image/*"
                           disabled="@_busy" class="mediafield-input" />
            </label>
        }

        @if (_error is not null)
        {
            <p class="mw-error" role="alert">@_error</p>
        }

        @* Never required. Twenty-five people uploading at once over venue wifi is the slowest
           minute of the night, and it is the minute the host is waiting to start — so the board
           draws a monogram and nobody is held up by a camera. *@
        <button class="btn btn-ghost btn-sm" @onclick="OpenLetter">
            @(Seat?.PhotoUrl is { Length: > 0 } ? "That's me" : "Skip for now")
        </button>
    </div>
}
else
{
    <div class="mw mw-letter @(_opened ? "is-open" : "")">
        <div class="mw-envelope" @onclick="Unfold">
            @if (!_opened)
            {
                <span class="mw-seal" aria-hidden="true">B</span>
                <p class="mw-tap">An invitation. Tap to open.</p>
            }
            else
            {
                <article class="mw-paper">
                    @if (Written(Beats.InvitationLetter) is { } letter)
                    {
                        @foreach (var paragraph in letter.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p>@paragraph</p>
                        }
                    }
                    else
                    {
                        <p>You are expected at Braun Manor.</p>
                    }

                    <p class="mw-signed">— James Braun</p>
                </article>

                @* Pinned to the bottom rather than run on after the last paragraph: on a phone the
                   letter is longer than the screen, and a button below the fold reads as the page
                   having nothing more to offer. *@
                <div class="mw-actions">
                    <button class="btn btn-gold btn-block" @onclick="EnterAsync">Continue</button>
                </div>
            }
        </div>
    </div>
}

@code {
    protected override TripArea Watching => TripArea.Mystery;

    private enum Step { Photo, Letter }

    /// <summary>Off, live in the preview, or unavailable because the browser said no.</summary>
    private enum Camera { Off, Live, Refused }

    private Step _step = Step.Photo;
    private Camera _camera = Camera.Off;
    private IJSObjectReference? _cam;
    private bool _opened;
    private bool _busy;
    private string? _error;

    private MysteryStory Story => Trip.Mystery.Story;
    private MysteryBeats Beats => Story.Beats;

    /// <summary>Which simulated phone this is, for the testing strip. Development only.</summary>
    [SupplyParameterFromQuery(Name = "sim")] private int? Sim { get; set; }

    /// <summary>
    /// Identity, from the sim strip if this frame is one, otherwise from the cookie.
    ///
    /// A simulated phone went through the same front door as a real one; it just kept the result
    /// somewhere twenty-five frames can each have their own.
    /// </summary>
    private string? PersonId =>
        Env.IsDevelopment() && Sim is > 0 ? Sims.PersonFor(Sim.Value) : Permissions.PersonId;

    private MysteryCharacter? Me => CastingService.CharacterFor(Trip, PersonId);
    private MysteryCastMember? Seat => Me is null ? null : Trip.Mystery.Play.ForCharacter(Me.Id);

    private static string? Written(string? value) => MysteryText.Written(value);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Somebody coming back on a second phone, or reloading, should not be made to do the
        // introduction again.
        if (Seat?.LetterOpened == true) Nav.NavigateTo(Sim is > 0 ? $"/m?sim={Sim}" : "/m");
    }

    /// <summary>
    /// Resized in the browser to 1600px before it is sent, which is why there is no server-side
    /// image library to keep patched.
    /// </summary>
    private async Task OnPickedAsync(InputFileChangeEventArgs e)
    {
        _busy = true;
        _error = null;

        try
        {
            var url = await Attachments.SaveAsync(e.File);
            await MutateAsync(t => CastingService.SetPhoto(t, PersonId!, url));

            // Worth forcing to disk. Re-taking twenty-one photographs after a restart is a real
            // cost, and it happens at the worst moment.
            await Store.FlushAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Ask the browser for the lens, which is what produces the permission prompt.
    ///
    /// Deliberately on a tap rather than on load: a page that reaches for the camera the moment it
    /// opens gets refused by people who would have said yes if asked at the point they wanted it.
    /// </summary>
    private async Task StartCameraAsync()
    {
        _error = null;

        try
        {
            _cam ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/camera.js");
            var result = await _cam.InvokeAsync<string>("start", "mw-cam");

            _camera = result == "ready" ? Camera.Live : Camera.Refused;

            _error = result switch
            {
                "ready" => null,
                "denied" => "Your phone said no to the camera. Choose a picture instead, or allow it in the address bar.",
                "unsupported" => "This browser will not open a camera here. Choose a picture instead.",
                _ => "No camera answered. Choose a picture instead."
            };
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            _camera = Camera.Refused;
            _error = ex.Message;
        }
    }

    private async Task CaptureAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var dataUrl = await _cam!.InvokeAsync<string?>("capture", "mw-cam", 900);
            if (dataUrl is null) { _error = "That did not come out. Try again."; return; }

            var url = await Attachments.SaveDataUrlAsync(dataUrl);
            await MutateAsync(t => CastingService.SetPhoto(t, PersonId!, url));

            // Worth forcing to disk. Re-taking twenty-five photographs after a restart is a real
            // cost, and it lands at the worst moment.
            await Store.FlushAsync();
            await StopCameraAsync();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopCameraAsync()
    {
        _camera = Camera.Off;

        if (_cam is null) return;
        try { await _cam.InvokeVoidAsync("stop"); } catch (JSDisconnectedException) { }
    }

    private async Task OpenLetter()
    {
        await StopCameraAsync();
        _step = Step.Letter;
    }

    /// <summary>The lens is switched off when this page goes away, not left running in a pocket.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_cam is null) return;

        try { await _cam.InvokeVoidAsync("stop"); } catch (JSDisconnectedException) { }
        try { await _cam.DisposeAsync(); } catch (JSDisconnectedException) { }
    }

    private void Unfold() => _opened = true;

    private async Task EnterAsync()
    {
        await MutateAsync(t => CastingService.MarkLetterOpened(t, PersonId!));
        Nav.NavigateTo(Sim is > 0 ? $"/m?sim={Sim}" : "/m");
    }
}
