@page "/m"
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@using CharterTrip.Core.Mystery.Script
@using CharterTrip.Core.Mystery.Text
@inherits TripAwareComponent
@inject MysteryScript Script
@inject IClock Clock
@layout CharterTrip.Web.Components.Layout.BareLayout

<PageTitle>Braun Manor</PageTitle>

@* One player's whole game, on their own phone.

   No nav and no chrome: for two hours this is a character card, not a page on a website. Identity
   comes from the cookie, so a phone left on a table still belongs to whoever signed in — which is
   the point, because everything here is secret. *@
<div class="mp">

@if (Me is null)
{
    <div class="mp-empty">
        <h1>Braun Manor</h1>
        @if (!Permissions.IsPlayer)
        {
            <p class="muted">Scan your own link, or type your code, to pick up your character.</p>
            <a class="btn btn-gold btn-lg btn-block" href="/login?returnUrl=%2Fm">Enter a code</a>
        }
        else if (Deal is null)
        {
            <p class="muted">The evening hasn't been dealt yet. This page will fill itself in.</p>
        }
        else
        {
            <p class="muted">
                You're signed in as @Permissions.DisplayName, but no role is assigned to you.
                Find Bertram.
            </p>
        }
    </div>
}
else
{
    var character = Script.CharacterById(Me.CharacterId)!;
    var briefing = Compiler.BriefingFor(Script, Deal!, Me.CharacterId)!;

    <header class="mp-head">
        <div>
            <p class="mp-title">@character.Title</p>
            <h1 class="mp-name">@character.Name</h1>
        </div>
        @if (AmGhost)
        {
            <span class="mp-ghost-badge">ghost</span>
        }
    </header>

    @if (AmGhost)
    {
        <div class="mp-note mp-note-ghost">
            You were convicted. You keep your phone, you may not vote, and you may not say what you
            knew in life — not your faction, not anybody else's. Canned whispers only.
        </div>
    }

    <nav class="mp-tabs">
        @foreach (var tab in Tabs)
        {
            <button class="mp-tab @(_tab == tab ? "on" : "")" @onclick="() => _tab = tab">@tab</button>
        }
    </nav>

    @switch (_tab)
    {
        case "You":
            <div class="mp-card">
                <h2>Where you were</h2>
                <p class="mp-zone">@briefing.ZoneName</p>
                <p class="muted tiny">@Script.Zones.ById(Me.ZoneId)?.ClueSpot</p>
            </div>

            <div class="mp-card">
                <h2>Why you came</h2>
                <p>@character.Motive</p>
            </div>

            <div class="mp-card">
                <h2>What you're afraid of</h2>
                <p>@character.Fear</p>
            </div>

            <div class="mp-card">
                <h2>What you were doing</h2>
                <p>@character.Acts.For(Me.ShowsGuilty)</p>
                <p class="muted tiny">
                    This is what people around you saw. It is what they will repeat about you.
                </p>
            </div>

            @if (briefing.KillerBriefing is { } killerBriefing)
            {
                <div class="mp-card mp-card-guilty">
                    <h2>You did this</h2>
                    <p>@killerBriefing</p>
                    @if (briefing.CoverStory is { } cover)
                    {
                        <h3>If you're pressed</h3>
                        <p>@cover</p>
                    }
                    <p class="muted tiny">The other two hands know you. Nobody else does.</p>
                </div>
            }

            <div class="mp-card">
                <h2>@briefing.FactionName</h2>
                <p>@FactionWin</p>
                @if (briefing.RivalName is { } rival)
                {
                    <p class="mp-rival">Your rival is <b>@rival</b>. Only one claim survives probate.</p>
                }
                @if (Allies.Count > 0)
                {
                    <p class="tiny">You know: <b>@string.Join(", ", Allies)</b></p>
                }
            </div>
            break;

        case "Saw":
            <div class="mp-card">
                <h2>What you saw</h2>
                <p class="muted tiny">
                    Your own account of the evening. Nobody can take it from you, and nobody has to
                    believe it.
                </p>
            </div>

            @foreach (var statement in briefing.Witnessed)
            {
                <div class="mp-card mp-seen">
                    <h3>@statement.AboutName</h3>
                    <p>@statement.Text</p>
                    @if (statement.FromNextRoom)
                    {
                        <p class="muted tiny">Seen from the doorway — you were in the next room.</p>
                    }
                </div>
            }
            break;

        case "Clues":
            <div class="mp-card">
                <h2>The board</h2>
                <p class="muted tiny">
                    Point your camera at a clue card to add it here. Nine cards, one per room, and
                    you have to walk there.
                </p>
            </div>

            @if (FoundClues.Count == 0)
            {
                <div class="mp-card"><p class="muted">Nothing found yet.</p></div>
            }
            @foreach (var clue in FoundClues)
            {
                <div class="mp-card mp-clue">
                    <div class="row between center">
                        <h3>@Compiler.ClueName(Script, clue)</h3>
                        <span class="muted tiny">@ZoneName(clue.ZoneId)</span>
                    </div>
                    <p>@Compiler.ClueText(Script, clue)</p>
                    @if (clue.FoundByCharacterId is { } finder && Script.CharacterById(finder) is { } who)
                    {
                        <p class="muted tiny">Found by @who.Name</p>
                    }
                </div>
            }
            break;

        case "Vote":
            @if (OpenTrial is not { } trial)
            {
                <div class="mp-card"><p class="muted">No trial open.</p></div>
            }
            else if (AmGhost)
            {
                <div class="mp-card"><p class="muted">Ghosts do not vote.</p></div>
            }
            else
            {
                <div class="mp-card">
                    <h2>@(trial.Phase == MysteryTrialPhase.FinalVote ? "Final vote" : "Open vote")</h2>
                    <p class="muted tiny">
                        @(trial.Phase == MysteryTrialPhase.FinalVote
                            ? "Among the nominees only."
                            : "Everybody votes. The screen shows the tally without names.")
                    </p>
                    @if (MyVote is { } mine)
                    {
                        <p class="mp-voted">You voted for <b>@Name(mine)</b>. Tap another to change it.</p>
                    }
                </div>

                @if (CanVote(trial))
                {
                    <div class="mp-votes">
                        @foreach (var member in Candidates(trial))
                        {
                            var id = member.CharacterId;
                            <button class="mp-vote @(MyVote == id ? "on" : "")" @onclick="() => VoteAsync(trial, id)">
                                <span class="mp-vote-name">@Name(id)</span>
                                <span class="muted tiny">@ZoneName(member.ZoneId)</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="mp-card">
                        <p class="muted">
                            @(trial.NomineeCharacterIds.Contains(Me.CharacterId)
                                ? "You're nominated. You don't vote in this round — say your piece instead."
                                : "Waiting on the room.")
                        </p>
                    </div>
                }
            }
            break;

        case "Do":
            @if (MyAbilities.Count == 0)
            {
                <div class="mp-card">
                    <p class="muted">
                        You have no abilities. What you have is what you saw, and who believes you.
                    </p>
                </div>
            }
            @foreach (var ability in MyAbilities)
            {
                var unlocked = MysteryService.IsUnlocked(Trip, Script, ability);
                var left = MysteryService.ChargesRemaining(Trip, MyFaction!, ability, Me.CharacterId);

                <div class="mp-card @(unlocked && left > 0 ? "" : "mp-dim")">
                    <div class="row between center">
                        <h3>@ability.Name</h3>
                        <span class="muted tiny">@left left</span>
                    </div>
                    @if (ability.Text is { Length: > 0 } text)
                    {
                        <p class="tiny">@text</p>
                    }
                    @if (ability.HasModes)
                    {
                        @foreach (var (mode, description) in ability.Modes!)
                        {
                            <p class="tiny mp-mode"><b>@mode</b> — @description</p>
                        }
                    }
                    @if (!unlocked)
                    {
                        <p class="muted tiny">Not yet.</p>
                    }
                    else if (left == 0)
                    {
                        <p class="muted tiny">Spent.</p>
                    }
                    else if (ability.Shared)
                    {
                        <p class="muted tiny">
                            Shared with the rest of yours. Whoever spends it, it is gone.
                        </p>
                    }
                    <p class="muted tiny">
                        Most of these need you to physically scan a card. Find the room.
                    </p>
                </div>
            }

            @if (AmGhost)
            {
                <div class="mp-card">
                    <h3>Whispers</h3>
                    @foreach (var line in Script.Ghosts.Ghosts.CannedMessages.Take(6))
                    {
                        <p class="tiny mp-whisper">@line</p>
                    }
                    <p class="muted tiny">Canned only. That is the rule that keeps you in the room.</p>
                </div>
            }
            break;
    }

    <footer class="mp-foot">
        <span class="muted tiny">@RoundName</span>
        <a class="muted tiny" href="/logout">not you?</a>
    </footer>
}

</div>

@code {
    protected override TripArea Watching => TripArea.Mystery;

    private string _tab = "You";

    private MysteryDeal? Deal => Trip.Mystery.Deal;

    /// <summary>Which character this phone is holding, from the signed-in person.</summary>
    private MysteryCastMember? Me =>
        Permissions.PersonId is { } personId ? Trip.Mystery.ForPerson(personId) : null;

    private bool AmGhost => Me is not null && MysteryService.IsGhost(Trip, Me.CharacterId);

    private ScriptFaction? MyFaction => Me is null ? null : Script.Factions.ById(Me.FactionId);

    private IReadOnlyList<ScriptAbility> MyAbilities => MyFaction?.Abilities ?? [];

    private string FactionWin => MyFaction?.Win ?? "";

    private string[] Tabs => ["You", "Saw", "Clues", "Vote", "Do"];

    private MysteryTrial? OpenTrial => MysteryService.CurrentTrial(Trip);

    private List<MysteryClue> FoundClues =>
        [.. Trip.Mystery.Clues.Where(c => c.Found).OrderByDescending(c => c.FoundAt)];

    private string? MyVote
    {
        get
        {
            if (OpenTrial is not { } trial || Me is null) return null;

            var ballots = trial.Phase == MysteryTrialPhase.FinalVote ? trial.FinalVotes : trial.OpenVotes;
            return ballots.FirstOrDefault(v => v.VoterCharacterId == Me.CharacterId)?.TargetCharacterId;
        }
    }

    /// <summary>
    /// Who this player is told about. The knowledge webs from <c>factions.json</c>: killers know
    /// each other and their minions, minions know the killers, detectives know each other. Jesters
    /// are alone on purpose — they are competing for the same conviction slots.
    /// </summary>
    private List<string> Allies
    {
        get
        {
            if (Me is null || Deal is null) return [];

            var ids = Me.FactionId switch
            {
                "killer" => Deal.InFaction("killer").Concat(Deal.InFaction("minion")),
                "minion" => Deal.InFaction("killer"),
                "detective" => Deal.InFaction("detective"),
                _ => []
            };

            return [.. ids.Where(m => m.CharacterId != Me.CharacterId).Select(m => Name(m.CharacterId))];
        }
    }

    private string RoundName => MysteryService.CurrentRound(Trip, Script)?.Name ?? "Braun Manor";

    private string Name(string characterId) => Script.CharacterById(characterId)?.Name ?? characterId;

    private string ZoneName(string zoneId) => Script.Zones.ById(zoneId)?.Name ?? zoneId;

    private bool CanVote(MysteryTrial trial) =>
        Me is not null
        && !AmGhost
        && trial.Phase is MysteryTrialPhase.OpenVote or MysteryTrialPhase.FinalVote
        && (trial.Phase != MysteryTrialPhase.FinalVote || !trial.NomineeCharacterIds.Contains(Me.CharacterId));

    private IEnumerable<MysteryCastMember> Candidates(MysteryTrial trial)
    {
        var living = MysteryService.Living(Trip).Where(c => c.CharacterId != Me!.CharacterId);

        return trial.Phase == MysteryTrialPhase.FinalVote
            ? living.Where(c => trial.NomineeCharacterIds.Contains(c.CharacterId))
            : living.OrderBy(c => Name(c.CharacterId), StringComparer.Ordinal);
    }

    /// <summary>
    /// Votes ride the debounce like everything else that is cheap to reconstruct — the tally is
    /// re-derivable from the ballots, and twenty-one people voting at once should not each force a
    /// disk write.
    /// </summary>
    private Task VoteAsync(MysteryTrial trial, string targetCharacterId) =>
        MutateAsync(t => MysteryService.CastVote(t, trial, Me!.CharacterId, targetCharacterId, Clock.UtcNow));
}
