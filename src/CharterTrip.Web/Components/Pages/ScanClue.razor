@page "/m/clue/{Token}"
@layout BareLayout
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@inherits TripAwareComponent
@inject IClock Clock
@inject IWebHostEnvironment Env
@inject CharterTrip.Web.Services.SimPhones Sims

<PageTitle>@(Clue is null ? "A card" : Zone?.Name)</PageTitle>

@* One of the nine cards, read where it lies.

   The token in the URL is unguessable on purpose: nine sequential ids would let somebody read every
   clue from the sofa, and walking to the room is the entire mechanic. *@

@if (Me is null)
{
    <div class="mp-empty">
        <h1 class="mp-title">Sign in first</h1>
        <a class="btn btn-gold btn-sm" href="/join">Join in</a>
    </div>
}
else if (Clue is null)
{
    <div class="mp-empty">
        <h1 class="mp-title">That card isn't from this game</h1>
        <a class="btn btn-ghost btn-sm" href="/m">Back to your phone</a>
    </div>
}
else if (!RolesRevealed)
{
    @* Somebody found a card early. Nothing has happened yet, so there is nothing on it. *@
    <div class="mp-empty">
        <h1 class="mp-title">Nothing here yet</h1>
        <p class="muted">It's a party. Put the phone down.</p>
        <a class="btn btn-ghost btn-sm" href="/m">Back to your phone</a>
    </div>
}
else
{
    <div class="mp-clue-page">
        <p class="mp-clue-zone">@Zone?.Name</p>
        <h1 class="mp-title">@(MysteryText.Written(Clue.Name) ?? "Something is here")</h1>

        @* As this person holds it: a tamper only shows to somebody who scanned after it happened.
           Getting here first means holding the original, which is the whole reason to walk fast. *@
        <p class="mp-clue-text">@ScanShareService.ReadingFor(Trip, Clue.Id, Me.Id)</p>

        @if (Tampering.Count > 0 && !AlreadyTampered)
        {
            <section class="mp-card">
                <h3 class="mp-card-title">You could work on this</h3>

                @if (NeedsTarget)
                {
                    @* The Syndicate's touch points at somebody: their effects go on the card, and
                       from this moment all three hands' answers put them near the study. Chosen
                       here, in front of the card, because it is one decision and not two. *@
                    <label class="sc-field">
                        <span class="tiny">Who does your story point at?</span>
                        <select class="se-select" @bind="_target">
                            <option value="">choose a guest…</option>
                            @foreach (var guest in Trip.Mystery.Story.Guests.Where(g => g.Id != Me.Id))
                            {
                                <option value="@guest.Id">@guest.Name</option>
                            }
                        </select>
                    </label>
                }

                @* Each way of working on it, with the card as it would then read. One touch is all
                   anybody gets, so both versions are on the screen before the choice is made. *@
                <div class="mp-tamper-options">
                    @foreach (var option in Tampering)
                    {
                        var ready = !NeedsTarget || !string.IsNullOrEmpty(_target);
                        var preview = ready
                            ? ScanShareService.Preview(Trip, Clue.Id, option.Mode.Id, PreviewTarget)
                            : null;

                        <section class="mp-tamper-option" @key="option.Key">
                            <h4 class="mp-tamper-name">@option.Mode.Name</h4>
                            @if (MysteryText.Written(option.Mode.Text) is { } how)
                            {
                                <p class="muted tiny">@how</p>
                            }

                            @if (preview is not null)
                            {
                                <p class="mp-tamper-kicker">The card would read</p>
                                <p class="mp-tamper-preview">@preview</p>
                            }
                            else
                            {
                                <p class="muted tiny">Choose who your story points at to see how the card would read.</p>
                            }

                            <button class="btn btn-sm btn-danger-ghost"
                                    disabled="@(!ready)"
                                    @onclick="() => TamperAsync(option.Ability.Id, option.Mode.Id)">
                                @option.Mode.Name this card
                            </button>
                        </section>
                    }
                </div>
                <p class="muted tiny">Once. Somebody else may have got here first.</p>
            </section>
        }

        <a class="btn btn-gold btn-sm" href="/m">Back to your phone</a>
    </div>
}

@code {
    protected override TripArea Watching => TripArea.Mystery;

    [Parameter] public string? Token { get; set; }

    private MysteryCharacter? Me => CastingService.CharacterFor(Trip, MePersonId);

    private MysteryClueCard? Clue => Token is null ? null : ScanShareService.ClueForToken(Trip, Token);

    private MysteryZone? Zone => Clue is null ? null : Trip.Mystery.Story.Zone(Clue.ZoneId);

    private bool RolesRevealed => PhaseService.RolesRevealed(Trip);

    private bool AlreadyTampered => Clue is not null && Trip.Mystery.Play.StateFor(Clue.Id)?.Tamper is not null;

    /// <summary>Who a killer's plant or scrub points at. Jesters point at themselves.</summary>
    private string _target = "";

    /// <summary>The Syndicate's modes need a name; the jester's do not.</summary>
    private bool NeedsTarget => Tampering.Any(o => o.Mode.Id is "plant" or "scrub");

    /// <summary>Whose belongings the preview works in: the chosen guest, or the jester themselves.</summary>
    private string? PreviewTarget => NeedsTarget
        ? (string.IsNullOrEmpty(_target) ? null : _target)
        : Me?.Id;

    /// <summary>Every mode of every ability this person holds that works on a card.</summary>
    private sealed record TamperOption(MysteryAbility Ability, MysteryAbilityMode Mode)
    {
        public string Key => Ability.Id + "-" + Mode.Id;
    }

    private IReadOnlyList<TamperOption> Tampering
    {
        get
        {
            if (Me is null) return [];

            return AbilityService.AbilitiesFor(Trip, Me.Id)
                .Where(a => a.HasModes && AbilityService.CanFire(Trip, Me.Id, a))
                .SelectMany(a => a.Modes.Select(m => new TamperOption(a, m)))
                .Where(x => x.Mode.Id is "subtle" or "blatant" or "plant" or "scrub")
                .ToList();
        }
    }

    /// <summary>Recorded on arrival. Standing in the room with a phone out is the confirmation.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Me is null || Clue is null || !RolesRevealed) return;

        await MutateAsync(t => ScanShareService.RecordClueScan(t, Me.Id, Clue.Id, Clock.UtcNow));
    }

    /// <summary>
    /// Spend the charge and mark the card in one mutation, so a refused tamper never costs a charge
    /// and a spent charge never fails to land.
    /// </summary>
    private Task TamperAsync(string abilityId, string mode)
    {
        // A plant or a scrub frames the guest chosen above; a self-frame frames the jester.
        var framed = mode is "plant" or "scrub"
            ? (string.IsNullOrEmpty(_target) ? null : _target)
            : Me!.Id;

        if (framed is null) return Task.CompletedTask;

        return MutateAsync(t =>
        {
            if (t.Mystery.Play.StateFor(Clue!.Id)?.Tamper is not null) return;

            if (AbilityService.TryFire(t, Me!.Id, abilityId, Clock.UtcNow, mode,
                    targetCharacterId: framed, targetClueId: Clue.Id) is null)
                return;

            ScanShareService.Tamper(t, Clue.Id, mode, Me.Id, framed, Clock.UtcNow);
        });
    }
}
