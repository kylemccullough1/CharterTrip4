@page "/m/clue/{Token}"
@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery
@using CharterTrip.Core.Mystery.Script
@using CharterTrip.Core.Mystery.Text
@inherits TripAwareComponent
@inject MysteryScript Script
@inject IClock Clock
@layout CharterTrip.Web.Components.Layout.BareLayout

<PageTitle>A clue · Braun Manor</PageTitle>

@* Somebody pointed their phone's camera at a printed card.

   Not an in-app scanner: QRCoder writes codes and cannot read them, and the BarcodeDetector API
   does not exist on iOS Safari — which is half the party. So a QR is just a URL, the phone's own
   camera opens it, and this is an ordinary page. No permission prompt, no library, no problem.

   The token is unguessable on purpose. Nine sequential ids would let somebody read every clue from
   the sofa, and walking to the room is the entire mechanic. *@
<div class="mp">

@if (Clue is null)
{
    <div class="mp-empty">
        <h1>Nothing here</h1>
        <p class="muted">
            That card isn't part of this game. It may be from an earlier deal — the cards are
            reprinted whenever a game is dealt again.
        </p>
        <a class="btn btn-gold btn-lg btn-block" href="/m">Back to your character</a>
    </div>
}
else if (Me is null)
{
    <div class="mp-empty">
        <h1>@Compiler.ClueName(Script, Clue)</h1>
        <p class="muted">Sign in first and the board will remember you found this.</p>
        <a class="btn btn-gold btn-lg btn-block" href="@($"/join?returnUrl=%2Fm%2Fclue%2F{Token}")">Enter a code</a>
    </div>
}
else
{
    <header class="mp-head">
        <div>
            <p class="mp-title">@ZoneName</p>
            <h1 class="mp-name">@Compiler.ClueName(Script, Clue)</h1>
        </div>
    </header>

    <div class="mp-card mp-clue">
        <p class="mp-clue-text">@Compiler.ClueText(Script, Clue, Trip.Mystery.Deal)</p>
    </div>

    @if (_first)
    {
        <div class="mp-note">
            You found this one. It's on the board now, with your name on it.
        </div>
    }
    else if (Clue.FoundByCharacterId is { } finder && Script.CharacterById(finder) is { } who)
    {
        <div class="mp-note mp-note-quiet">
            @(finder == Me.CharacterId ? "You found this one." : $"{who.Name} got here first.")
        </div>
    }

    @if (Tampers.Count > 0)
    {
        <div class="mp-card">
            <h3>You could get to this first</h3>
            @foreach (var (ability, mode) in Tampers)
            {
                var chosen = mode;
                var chosenAbility = ability;
                <button class="btn btn-sm btn-block mp-tamper"
                        @onclick="() => TamperAsync(chosenAbility.Id, chosen)">
                    @chosen
                </button>
            }
            <p class="muted tiny">
                One tamper per card, and it cannot be taken back. Forensics can still read what was
                originally here.
            </p>
        </div>
    }

    @if (_message is not null)
    {
        <div class="mp-note @(_ok ? "" : "mp-note-no")">@_message</div>
    }

    <a class="btn btn-gold btn-lg btn-block" href="/m">Back to your character</a>
}

</div>

@code {
    protected override TripArea Watching => TripArea.Mystery;

    [Parameter] public string? Token { get; set; }

    private bool _first;
    private string? _message;
    private bool _ok;

    private MysteryClue? Clue => MysteryService.ClueByToken(Trip, Token);

    private MysteryCastMember? Me =>
        Permissions.PersonId is { } personId ? Trip.Mystery.ForPerson(personId) : null;

    private string ZoneName => Clue is null ? "" : Script.Zones.ById(Clue.ZoneId)?.Name ?? Clue.ZoneId;

    /// <summary>
    /// The tamper modes this player could spend here, if any.
    ///
    /// A jester frames themselves; a killer plants somebody else's belongings or scrubs the scene.
    /// Only offered when the ability is unlocked, has a charge, and the card is untouched — the
    /// rules are checked again inside the mutation, but there is no reason to show a button that
    /// cannot work.
    /// </summary>
    private List<(ScriptAbility Ability, string Mode)> Tampers
    {
        get
        {
            if (Me is null || Clue is null || Clue.Tamper is not null) return [];
            if (MysteryService.IsGhost(Trip, Me.CharacterId)) return [];

            var faction = Script.Factions.ById(Me.FactionId);
            if (faction is null) return [];

            var offers = new List<(ScriptAbility, string)>();

            foreach (var ability in faction.Abilities.Where(a => a.HasModes))
            {
                if (!MysteryService.IsUnlocked(Trip, Script, ability)) continue;
                if (MysteryService.ChargesRemaining(Trip, faction, ability, Me.CharacterId) <= 0) continue;

                foreach (var mode in ability.Modes!.Keys.Where(IsTamperMode))
                    offers.Add((ability, mode));
            }

            return offers;
        }
    }

    private static bool IsTamperMode(string mode) =>
        mode is "subtle" or "blatant" or "plant" or "scrub";

    protected override void OnParametersSet()
    {
        // Record the find on arrival: walking to the room is the act, and making somebody press a
        // button to confirm they are standing there adds nothing.
        if (Clue is null || Me is null || Clue.Found) return;

        _first = true;
        _ = MutateAsync(t =>
        {
            var clue = MysteryService.ClueByToken(t, Token);
            if (clue is not null) MysteryService.RecordClueFound(t, clue, Me.CharacterId, Clock.UtcNow);
        });
    }

    private async Task TamperAsync(string abilityId, string mode)
    {
        var me = Me!;
        var token = Token;

        // A plant frames somebody else. Choosing who is a separate step the phone does not have
        // yet, so for now a plant works the same way a jester's self-frame does — it inserts the
        // acting player's own belongings. Deliberately not guessed at.
        var target = mode == "scrub" ? null : me.CharacterId;

        var result = await Store.MutateAsync(t =>
        {
            var clue = MysteryService.ClueByToken(t, token);
            if (clue is null) return AbilityResult.No("That card is gone.");

            // Spending the charge and marking the card are one decision, made inside the lock —
            // two jesters reaching the same card at the same moment must not both succeed.
            return MysteryService.TryTamperWithAbility(
                t, Script, me.CharacterId, abilityId, mode, target, clue.Id, Clock.UtcNow);
        }, TripArea.Mystery);

        // An ability firing is one of the few things worth forcing to disk immediately: it is
        // gone once spent, and losing it to a restart would be unrecoverable mid-evening.
        await Store.FlushAsync();

        _ok = result.Fired;
        _message = result.Message;
    }
}
