@page "/games/sketch"
@inherits TripAwareComponent

@* Police Sketch. Nobody playing ever looks at this screen — the drawing happens on paper and
   the describing happens out loud. All this has to do is remember which character is up, whose
   turn it was to guess first, and keep the points straight. *@

<PageTitle>Police Sketch · Charter Trip 2026</PageTitle>

<AdminOnly>
<div class="page">
    @if (Game is null)
    {
        <SectionCard Title="Police Sketch" Subtitle="This game is not in the trip data.">
            <a class="btn btn-gold btn-sm" href="/games">See all games</a>
        </SectionCard>
    }
    else if (State.Phase == PartyGamePhase.NotStarted)
    {
        <GameSetup Game="Game" OnStart="StartAsync"
                   CanStart="@(State.Prompts.Count > 0)"
                   StartBlockedReason="Add at least one character before starting.">
            <Structure>
                <p><b>@State.PointValue points</b> to the first team to name the character.</p>
                <p><b>@State.RoundCount rounds</b>, from a list of @State.Prompts.Count characters.</p>
            </Structure>
            <Settings>
                <div class="settings-row">
                    <label class="field">
                        <span>Points per round</span>
                        <input class="numfield" type="number" min="0" value="@State.PointValue"
                               @onchange="e => SetPointValueAsync(e.Value?.ToString())" />
                    </label>
                    <label class="field">
                        <span>Rounds</span>
                        <input class="numfield" type="number" min="1" value="@State.RoundCount"
                               @onchange="e => SetRoundCountAsync(e.Value?.ToString())" />
                    </label>
                </div>

                <p class="hb-label mt">Characters</p>
                <ul class="plain prompt-list">
                    @for (var i = 0; i < State.Prompts.Count; i++)
                    {
                        var index = i;
                        <li class="prompt-line" @key="index">
                            <EditableText Value="@State.Prompts[index]"
                                          ValueChanged="@(v => EditPromptAsync(index, v))"
                                          Placeholder="—" />
                            <button type="button" class="pack-del" title="Remove"
                                    @onclick="() => RemovePromptAsync(index)">✕</button>
                        </li>
                    }
                </ul>
                <button class="btn btn-ghost btn-sm" @onclick="AddPromptAsync">Add a character</button>
            </Settings>
        </GameSetup>
    }
    else if (State.Phase == PartyGamePhase.Playing)
    {
        <div class="game-head">
            <div class="grow">
                <h1 class="game-title">Police Sketch</h1>
                <p class="game-meta">Round <b>@State.Round</b> of <b>@State.RoundCount</b> · @State.PointValue points a round</p>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="ConfirmReset">Reset</button>
        </div>

        <SectionCard Title="@(State.CurrentPrompt is null ? "Pick a character" : "Drawing now")">
            <div class="card sketch-now">
                @if (State.CurrentPrompt is { Length: > 0 } current)
                {
                    <p class="sketch-current">@current</p>
                    <button class="btn btn-ghost btn-sm" @onclick="ClearPromptAsync">Pick a different one</button>
                }
                else
                {
                    <div class="chip-row">
                        @foreach (var prompt in RoundGameService.RemainingPrompts(State))
                        {
                            var pick = prompt;
                            <button type="button" class="chip tap" @onclick="() => PickAsync(pick)" @key="pick">@pick</button>
                        }
                    </div>
                    @if (RoundGameService.RemainingPrompts(State).Count == 0)
                    {
                        <p class="muted">Every character has been drawn. Add more, or end the game.</p>
                    }
                }
            </div>
        </SectionCard>

        <SectionCard Title="Who guessed it first?"
                     Subtitle="@($"Awards {State.PointValue} points and moves to the next round.")">
            <div class="team-picks">
                @foreach (var team in Trip.Teams)
                {
                    var pick = team;
                    <button type="button" class="team-pick" style="--team:@team.Color"
                            @onclick="() => AwardAsync(pick.Id)" @key="team.Id">
                        <span class="team-pick-name">@team.Name</span>
                        <span class="team-pick-pts">+@State.PointValue</span>
                    </button>
                }
            </div>
            <div class="row gap mt">
                <button class="btn btn-ghost btn-sm" @onclick="SkipAsync">Nobody got it — skip the round</button>
            </div>
        </SectionCard>

        <GameScoreStrip Trip="Trip" GameId="@RoundGameService.SketchId" Label="Police Sketch" />
    }
    else
    {
        <GameVictory Rows="ScoreService.Scoreboard(Trip, RoundGameService.SketchId)"
                     Winner="ScoreService.Leader(Trip, RoundGameService.SketchId)"
                     Kicker="Police Sketch">
            <Actions>
                <button class="btn btn-ghost btn-lg" @onclick="ConfirmReset">Play again</button>
            </Actions>
        </GameVictory>
    }
</div>

<ConfirmDialog @ref="_confirm" />
</AdminOnly>

@code {
    protected override TripArea Watching => TripArea.Games;

    private ConfirmDialog? _confirm;

    private Game? Game => Trip.Games.FirstOrDefault(g => g.Id == RoundGameService.SketchId);
    private RoundGame State => Trip.Party.Sketch;

    private Task StartAsync() => MutateAsync(t => RoundGameService.Begin(t.Party.Sketch));

    private Task PickAsync(string prompt) =>
        MutateAsync(t => RoundGameService.PickPrompt(t.Party.Sketch, prompt));

    /// <summary>Puts the character back in the hat as well as off the screen — it was never drawn.</summary>
    private Task ClearPromptAsync() => MutateAsync(t =>
    {
        var game = t.Party.Sketch;
        if (game.CurrentPrompt is { } prompt)
            game.UsedPrompts.RemoveAll(p => string.Equals(p, prompt, StringComparison.OrdinalIgnoreCase));
        game.CurrentPrompt = null;
    });

    private Task AwardAsync(string teamId) => MutateAsync(t =>
        RoundGameService.AwardRoundWinner(t, t.Party.Sketch, RoundGameService.SketchId, teamId, DateTimeOffset.UtcNow));

    private Task SkipAsync() => MutateAsync(t => RoundGameService.NextRound(t.Party.Sketch));

    private void ConfirmReset() => _confirm?.Show(
        "This clears Police Sketch's points and puts the game back to the rules card. Nothing else is touched.",
        () => MutateAsync(t => RoundGameService.Reset(t, t.Party.Sketch, RoundGameService.SketchId)),
        "Reset the game",
        "Reset Police Sketch");

    // ------------------------------------------------------------------ settings

    private Task SetPointValueAsync(string? raw) =>
        int.TryParse(raw, out var value) && value >= 0
            ? MutateAsync(t => t.Party.Sketch.PointValue = value)
            : Task.CompletedTask;

    private Task SetRoundCountAsync(string? raw) =>
        int.TryParse(raw, out var value) && value >= 1
            ? MutateAsync(t => t.Party.Sketch.RoundCount = value)
            : Task.CompletedTask;

    private Task AddPromptAsync() => MutateAsync(t => t.Party.Sketch.Prompts.Add("New character"));

    private Task EditPromptAsync(int index, string value) => MutateAsync(t =>
    {
        var prompts = t.Party.Sketch.Prompts;
        if (index >= 0 && index < prompts.Count && value.Trim().Length > 0) prompts[index] = value.Trim();
    });

    private Task RemovePromptAsync(int index) => MutateAsync(t =>
    {
        var prompts = t.Party.Sketch.Prompts;
        if (index >= 0 && index < prompts.Count) prompts.RemoveAt(index);
    });
}
