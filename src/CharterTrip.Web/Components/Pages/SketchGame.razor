@page "/games/sketch"
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Police Sketch. Nobody playing ever looks at this screen — the drawing happens on paper and the
   describing happens out loud.

   The round runs one way only: the round opens, you pick who is being drawn, you say who got it,
   and that is the round over. There is no way to score without a character up, because "who
   guessed it" is not a question that means anything until somebody is being drawn. *@

<PageTitle>Police Sketch · Charter Trip 2026</PageTitle>

<AdminOnly>
<div class="page page-game">
    @if (Game is null)
    {
        <SectionCard Title="Police Sketch" Subtitle="This game is not in the trip data.">
            <a class="btn btn-gold btn-sm" href="/games">See all games</a>
        </SectionCard>
    }
    else if (State.Phase == PartyGamePhase.NotStarted)
    {
        <GameSetup Game="Game" OnStart="StartAsync"
                   CanStart="@(State.Characters.Count > 0)"
                   StartBlockedReason="Add at least one character before starting.">
            <Structure>
                <p><b>@State.PointValue points</b> to the first team to name the character.</p>
                <p><b>@State.RoundCount rounds</b>, from a cast of @State.Characters.Count.</p>
                <p class="muted tiny">Level at the end goes to sudden death, so this cannot finish in a tie.</p>
            </Structure>
            <Settings>
                <div class="settings-row">
                    <label class="field">
                        <span>Points per round</span>
                        <input class="numfield" type="number" min="0" value="@State.PointValue"
                               @onchange="e => SetPointValueAsync(e.Value?.ToString())" />
                    </label>
                    <label class="field">
                        <span>Rounds</span>
                        <input class="numfield" type="number" min="1" value="@State.RoundCount"
                               @onchange="e => SetRoundCountAsync(e.Value?.ToString())" />
                    </label>
                </div>

                <div class="row between center mt">
                    <span class="hb-label">The cast · @State.Characters.Count</span>
                    <button class="btn btn-gold btn-sm" @onclick="AddAsync">Add a character</button>
                </div>
                <p class="muted tiny">
                    Give each one a picture so whoever is describing them has something to look at.
                </p>

                <div class="cast-list">
                    @for (var i = 0; i < State.Characters.Count; i++)
                    {
                        var index = i;
                        var character = State.Characters[index];
                        <div class="cast-line" @key="index">
                            <EditableText Value="@character.Name"
                                          CssClass="cast-name"
                                          ValueChanged="@(v => EditNameAsync(index, v))"
                                          Placeholder="Name them" />
                            <MediaField Value="@character.ImageUrl"
                                        Label="@character.Name"
                                        ShowUrl="false"
                                        ValueChanged="@(v => EditImageAsync(index, v))" />
                            <button type="button" class="btn btn-danger-ghost btn-xs cast-delete"
                                    @onclick="() => RemoveAsync(index)">Delete</button>
                        </div>
                    }
                </div>
            </Settings>
        </GameSetup>
    }
    else if (State.Phase == PartyGamePhase.Playing)
    {
        <div class="game-head">
            <div class="grow">
                <h1 class="game-title">Police Sketch</h1>
                <p class="game-meta">@State.PointValue points a round · a cast of @State.Characters.Count</p>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="ConfirmReset">Reset</button>
        </div>

        @* Keyed on the round, so it is a fresh element every round and the animation runs again. *@
        <div class="round-splash" @key="RoundKey">
            @if (State.IsSuddenDeath)
            {
                <span class="round-splash-kicker is-sudden">Sudden death</span>
                <span class="round-splash-sub">@string.Join(" v ", Active.Select(t => t.Name))</span>
            }
            else
            {
                <span class="round-splash-kicker">Round @State.Round</span>
                <span class="round-splash-sub">of @State.RoundCount</span>
            }
        </div>

        @if (_scored is { } scored)
        {
            @* The round is over and this is who took it. It clears itself. *@
            <section class="sketch-result" style="--team:@scored.Team.Color">
                <span class="star-burst" aria-hidden="true">
                    @for (var s = 0; s < 12; s++)
                    {
                        <span class="star" style="--i:@s"></span>
                    }
                </span>
                <p class="sketch-result-who">@scored.Team.Name</p>
                <p class="sketch-result-pts">+@scored.Points</p>
                <p class="muted">@scored.Character</p>
            </section>
        }
        else if (Current is { } current)
        {
            <SectionCard Title="Describing now">
                <div class="card sketch-now">
                    @if (current.ImageUrl is { Length: > 0 })
                    {
                        <MediaView Src="@current.ImageUrl" CssClass="sketch-image" Alt="@current.Name" />
                    }
                    <p class="sketch-current">@current.Name</p>
                    <button class="btn btn-ghost btn-sm" @onclick="ClearAsync">Pick a different one</button>
                </div>
            </SectionCard>

            <SectionCard Title="Who guessed it first?"
                         Subtitle="@($"Awards {State.PointValue} points and closes the round.")">
                <div class="team-picks">
                    @foreach (var team in Active)
                    {
                        var pick = team;
                        <button type="button" class="team-pick" style="--team:@team.Color"
                                @onclick="() => AwardAsync(pick.Id)" @key="team.Id">
                            <span class="team-pick-name">@team.Name</span>
                            <span class="team-pick-pts">+@State.PointValue</span>
                        </button>
                    }
                </div>
                <div class="row gap mt">
                    <button class="btn btn-ghost btn-sm" @onclick="SkipAsync">Nobody got it — skip the round</button>
                </div>
            </SectionCard>
        }
        else
        {
            <SectionCard Title="Who are they drawing?"
                         Subtitle="Pick one and the round is on. Nobody can score until you do.">
                <div class="card sketch-pick">
                    @if (Remaining.Count > 0)
                    {
                        <div class="cast-picks">
                            @foreach (var character in Remaining)
                            {
                                var pick = character.Name;
                                <button type="button" class="cast-pick" @onclick="() => PickAsync(pick)" @key="pick">
                                    @if (character.ImageUrl is { Length: > 0 })
                                    {
                                        <img class="cast-pick-face" src="@character.ImageUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="cast-pick-face is-empty" aria-hidden="true">?</span>
                                    }
                                    <span class="cast-pick-name">@character.Name</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">Everyone has been drawn. Reset to use the cast again.</p>
                    }
                </div>
            </SectionCard>
        }

        <GameScoreSidebar Trip="Trip" GameId="@RoundGameService.SketchId" Label="Police Sketch" />
    }
    else
    {
        <GameVictory Rows="ScoreService.Scoreboard(Trip, RoundGameService.SketchId)"
                     Winner="ScoreService.Leader(Trip, RoundGameService.SketchId)"
                     Kicker="Police Sketch">
            <Actions>
                <button class="btn btn-ghost btn-lg" @onclick="ConfirmReset">Play again</button>
            </Actions>
        </GameVictory>
    }
</div>

<ConfirmDialog @ref="_confirm" />
</AdminOnly>

@code {
    protected override TripArea Watching => TripArea.Games;

    private ConfirmDialog? _confirm;
    private IJSObjectReference? _audio;

    /// <summary>Who just took a round, for as long as the stars are up. Not persisted — it is an animation.</summary>
    private sealed record Scored(Team Team, int Points, string? Character);

    private Scored? _scored;
    private CancellationTokenSource? _stars;

    /// <summary>Which round this page has already announced, so it announces each one once.</summary>
    private string? _announced;

    private static readonly TimeSpan StarsFor = TimeSpan.FromMilliseconds(2200);

    private Game? Game => Trip.Games.FirstOrDefault(g => g.Id == RoundGameService.SketchId);
    private RoundGame State => Trip.Party.Sketch;

    private IReadOnlyList<Team> Active => RoundGameService.ActiveTeams(Trip, State);
    private IReadOnlyList<SketchCharacter> Remaining => RoundGameService.RemainingCharacters(State);
    private SketchCharacter? Current => RoundGameService.Find(State, State.CurrentCharacter);

    /// <summary>Distinguishes round 3 from the first sudden-death round, which is also "3".</summary>
    private string RoundKey => $"{(State.IsSuddenDeath ? "sd" : "r")}-{State.Round}";

    private Task StartAsync() => MutateAsync(t => RoundGameService.Begin(t.Party.Sketch));

    private Task PickAsync(string name) =>
        MutateAsync(t => RoundGameService.PickCharacter(t.Party.Sketch, name));

    /// <summary>Puts the character back in the hat as well as off the screen — they were never drawn.</summary>
    private Task ClearAsync() => MutateAsync(t =>
    {
        var game = t.Party.Sketch;
        if (game.CurrentCharacter is { } name)
            game.UsedCharacters.RemoveAll(u => string.Equals(u, name, StringComparison.OrdinalIgnoreCase));
        game.CurrentCharacter = null;
    });

    private async Task AwardAsync(string teamId)
    {
        var team = TeamService.FindTeam(Trip, teamId);
        var points = State.PointValue;
        var character = State.CurrentCharacter;

        await MutateAsync(t =>
            RoundGameService.AwardRoundWinner(
                t, t.Party.Sketch, RoundGameService.SketchId, teamId, DateTimeOffset.UtcNow));

        if (team is null) return;

        // Not awaited: a circuit handles its events one at a time, so waiting out the animation
        // here would leave the next tap queued behind it.
        _ = CelebrateAsync(new Scored(team, points, character));
    }

    private Task SkipAsync() =>
        MutateAsync(t => RoundGameService.NextRound(t, t.Party.Sketch, RoundGameService.SketchId));

    /// <summary>
    /// Stars, a chime, and then out of the way. Cancelling the previous one matters: two quick
    /// rounds would otherwise leave the first timer to clear the second team's stars early.
    /// </summary>
    private async Task CelebrateAsync(Scored scored)
    {
        _stars?.Cancel();
        _stars?.Dispose();
        var cts = new CancellationTokenSource();
        _stars = cts;

        _scored = scored;
        await InvokeAsync(StateHasChanged);
        await PlayAsync("sparkle");

        try
        {
            await Task.Delay(StarsFor, cts.Token);
            _scored = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { /* another round was scored first */ }
        catch (ObjectDisposedException) { /* the page went away mid-celebration */ }
    }

    private void ConfirmReset() => _confirm?.Show(
        "This clears Police Sketch's points and puts the game back to the rules card. Nothing else is touched.",
        () => MutateAsync(t => RoundGameService.Reset(t, t.Party.Sketch, RoundGameService.SketchId)),
        "Reset the game",
        "Reset Police Sketch");

    // ------------------------------------------------------------------ sound

    /// <summary>
    /// Announce a new round out loud, once. The splash animates itself off its key; this is the
    /// half that cannot be done in CSS.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (State.Phase != PartyGamePhase.Playing)
        {
            _announced = null;
            return;
        }

        // Only while waiting on a character: announcing during the stars would talk over them.
        if (State.CurrentCharacter is not null || _scored is not null) return;

        var key = RoundKey;
        if (_announced == key) return;

        var first = _announced is null;
        _announced = key;

        // Nothing on the very first paint — the round was already open when the page loaded.
        if (!first) _ = PlayAsync("roundStart");
    }

    private async Task PlayAsync(string cue)
    {
        try
        {
            _audio ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/game-audio.js");
            await _audio.InvokeVoidAsync("unlock");
            await _audio.InvokeVoidAsync(cue);
        }
        catch (JSDisconnectedException) { /* the circuit went away */ }
        catch (JSException) { /* no audio on this device; the game is not about the noise */ }
    }

    public async ValueTask DisposeAsync()
    {
        _stars?.Cancel();
        _stars?.Dispose();

        if (_audio is not null)
        {
            try { await _audio.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _audio.DisposeAsync(); } catch (JSDisconnectedException) { }
            _audio = null;
        }

        Dispose();
        GC.SuppressFinalize(this);
    }

    // ------------------------------------------------------------------ settings

    private Task SetPointValueAsync(string? raw) =>
        int.TryParse(raw, out var value) && value >= 0
            ? MutateAsync(t => t.Party.Sketch.PointValue = value)
            : Task.CompletedTask;

    private Task SetRoundCountAsync(string? raw) =>
        int.TryParse(raw, out var value) && value >= 1
            ? MutateAsync(t => t.Party.Sketch.RoundCount = value)
            : Task.CompletedTask;

    private Task AddAsync() =>
        MutateAsync(t => t.Party.Sketch.Characters.Add(new SketchCharacter { Name = "New character" }));

    private Task EditNameAsync(int index, string value) => MutateAsync(t =>
    {
        var cast = t.Party.Sketch.Characters;
        if (index >= 0 && index < cast.Count && value.Trim().Length > 0) cast[index].Name = value.Trim();
    });

    private Task EditImageAsync(int index, string value) => MutateAsync(t =>
    {
        var cast = t.Party.Sketch.Characters;
        if (index >= 0 && index < cast.Count) cast[index].ImageUrl = value.Trim();
    });

    private Task RemoveAsync(int index) => MutateAsync(t =>
    {
        var cast = t.Party.Sketch.Characters;
        if (index >= 0 && index < cast.Count) cast.RemoveAt(index);
    });
}
