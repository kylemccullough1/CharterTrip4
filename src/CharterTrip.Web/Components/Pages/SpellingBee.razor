@page "/games/spelling"
@using System.Text.Json
@using CharterTrip.Core.Services
@using CharterTrip.Core.Words
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>Spelling Bee · Charter Trip 2026</PageTitle>

@* The wall. This is the screen pointed at the room, and the one thing it must never show is
   the word.

   A spelling bee has a problem Jeopardy does not: the word is the answer. Jeopardy can put a
   clue on the wall because reading it is the point. Here anything the room can see, the speller
   can see — so the word lives on the host's phone at /bee/{hostCode} and appears here only once
   the turn is settled and it cannot help anybody.

   AdminOnly guards the page rather than the layout, because a guest who taps "Spelling Bee" in
   the nav should be told this is the host's screen, not handed a 404. *@
<AdminOnly>
<div class="bee-wall @(Started ? "is-playing" : null)">

@if (ShowingRules)
{
    @* One rule at a time, driven from the host's phone while they read it out. Six bullet
       points on a wall are read by everybody at their own pace and listened to by nobody. *@
    <section class="bee-rules-show">
        <p class="bee-eyebrow">How this works</p>
        <p class="bee-rule-text" @key="Game.RuleSlide">@CurrentRule</p>

        <div class="bee-rule-dots">
            @for (var i = 0; i < Rules.Count; i++)
            {
                <span class="@(i == Game.RuleSlide ? "is-on" : null)"></span>
            }
        </div>

        @* The slideshow is driven from the host's phone, and this branch renders instead of the
           title card — so every other control on the wall, Reset included, is behind a screen the
           wall is not showing. Without this, a bee left on rule one by a phone that has since
           gone home reads as a bee that will not start, and the only way out is the weekend's
           own reset button on another page. *@
        @if (CanHost)
        {
            <button class="btn btn-ghost btn-sm bee-rules-out" @onclick="TakeRulesDownAsync">
                Take the rules down
            </button>
        }
    </section>
}
else if (Game.Phase == BeePhase.NotStarted)
{
    <section class="bee-title">
        <h1 class="bee-logo">SPELLING&nbsp;BEE</h1>

        @* One square, where there were two. The second was the host's, and it was the thing
           keeping the word off every phone but one — which is now the committee's password: the
           word list is offered on the far side of this code to a browser already signed in. *@
        <div class="bee-join">
            <div class="bee-join-card">
                <span class="bee-join-role">Everybody</span>
                <QrImage Content="@JoinUrl(Game.GuestCode)" Size="170" Alt="Join the spelling bee" />
                <span class="bee-join-code">@Game.GuestCode</span>
                <span class="bee-join-note">Scan and pick your name</span>
            </div>
        </div>

        @* /join, not /bee. /bee is the host's phone and has no code box on it — it sends you
           here. Typing the code at the wrong address is a dead end nobody would guess their way
           out of. *@
        <p class="bee-hint">Scan it, or go to <b>@JoinHost/join</b> and type it in.</p>

        @* Only the people who have actually joined, and nothing else: no count, no target, no
           grid of grey placeholders. The bee plays with whoever is standing there. *@
        <div class="bee-lobby">
            <div class="bee-lobby-faces">
                @foreach (var person in JoinedPeople)
                {
                    <div class="bee-lobby-person" @key="person.Id">
                        <BeeFace Person="person" Color="@ColourOf(person)" />
                        <span class="bee-seat-name">@person.Name</span>
                    </div>
                }
            </div>
        </div>

        @if (CanHost)
        {
            <div class="bee-title-actions">
                <GameModeButton Game="spelling" />
                <button class="btn btn-ghost btn-sm" @onclick="ToggleSetupAsync">
                    ⚙ Setup @(_setupOpen ? "▲" : "▼")
                </button>
                <button class="btn btn-ghost btn-sm" @onclick="NewCodesAsync">New codes</button>
                <button class="mini-btn" title="@(_muted ? "Unmute" : "Mute")" @onclick="ToggleMuteAsync">
                    @(_muted ? "🔇" : "🔊")
                </button>
            </div>

            @if (_setupOpen)
            {
                <div class="bee-deck">
                    <p class="bee-deck-head">Where the words start</p>
                    <p class="bee-deck-note">
                        One dial, not a deck. Words are drawn as turns come up, so the host can
                        move this up or down from their phone while the bee is running — this is
                        only where it opens.
                    </p>

                    <div class="bee-tier-picker">
                        @foreach (var tier in WordBank.Tiers)
                        {
                            var key = tier.Key;

                            <button class="bee-tier @(key == StartingDifficulty ? "is-on" : null)"
                                    @key="key" @onclick="() => SetDifficultyAsync(key)">
                                <span class="bee-tier-name">@tier.Label</span>
                                <span class="bee-tier-count">@WordBank.Pool(key).Count words</span>
                            </button>
                        }
                    </div>

                    <div class="bee-deck-numbers">
                        <label>
                            Points per word
                            <input type="number" min="0" max="100" step="1" value="@Trip.SpellingBee.PointsPerWord"
                                   @onchange="e => SetPointsAsync(e.Value?.ToString())" />
                        </label>
                    </div>

                    @* The rules live on the game itself, which is what both the host's phone and
                       the slideshow read — so they are edited here, beside the words, rather than
                       being the one part of the bee that can only be changed in the seed file. *@
                    <p class="bee-deck-head">The rules</p>
                    <div class="bee-rules-edit">
                        @for (var i = 0; i < Rules.Count; i++)
                        {
                            var index = i;

                            <div class="bee-rule-row" @key="index">
                                <textarea rows="2" value="@Rules[index]"
                                          @onchange="e => SetRuleAsync(index, e.Value?.ToString())"></textarea>
                                <div class="bee-rule-btns">
                                    <button class="btn btn-xs" disabled="@(index == 0)"
                                            title="Move up" @onclick="() => MoveRuleAsync(index, -1)">↑</button>
                                    <button class="btn btn-xs" disabled="@(index == Rules.Count - 1)"
                                            title="Move down" @onclick="() => MoveRuleAsync(index, 1)">↓</button>
                                    <button class="btn btn-xs" title="Delete"
                                            @onclick="() => RemoveRuleAsync(index)">✕</button>
                                </div>
                            </div>
                        }
                        <button class="btn btn-ghost btn-xs" @onclick="AddRuleAsync">+ Add a rule</button>
                    </div>
                </div>
            }
        }
    </section>
}
else if (Game.Phase == BeePhase.Finished)
{
    @* The win screen, built like Jeopardy's — the bee is one of eight games and the moment it
       ends should look like the others ending. The team wins it, not the person: the last one
       standing takes it for whoever they are playing for. *@
    <section class="bee-win" style="--team:@ColourOf(Winner)">
        <div class="bee-win-burst" aria-hidden="true">
            @for (var i = 0; i < 12; i++)
            {
                <span style="--i:@i"></span>
            }
        </div>

        <p class="bee-eyebrow">Champion speller</p>
        <h1 class="bee-win-team">@(WinningTeam?.Name ?? "Nobody") wins the bee!</h1>

        <div class="bee-win-who">
            <BeeFace Person="Winner" Color="@ColourOf(Winner)" CssClass="bee-face-big" />
            <p class="bee-win-name">@(Winner?.Name ?? "—")</p>
            <p class="bee-sub">Last one standing — and they spelled it!</p>
        </div>

        <div class="bee-final-grid">
            @foreach (var (team, score) in SpellingBeeService.Scoreboard(Trip).OrderByDescending(x => x.Score))
            {
                <div class="bee-final-card @(team.Id == WinningTeam?.Id ? "is-winner" : null)"
                     style="--team:@team.Color" @key="team.Id">
                    <span class="bee-score-name">@team.Name</span>
                    <p class="bee-final-score">@score</p>
                </div>
            }
        </div>

        <div class="bee-title-actions">
            <a class="btn btn-gold btn-lg" href="/">Home</a>
            @if (CanHost)
            {
                <button class="btn btn-ghost" @onclick="ConfirmReset">Reset the bee</button>
            }
        </div>
    </section>
}
else
{
    @* The row, and the turn order, and the same thing twice on purpose. It never re-sorts, so
       a face you were watching stays where you were watching it — and it never wraps, so the
       one face pulled out of it has clear air underneath and covers nobody. *@
    <div class="bee-row" style="--seats:@Field.Count">
        @for (var i = 0; i < Field.Count; i++)
        {
            var person = Field[i];

            // Dropped only while they are actually at the microphone. Leaving it on through
            // Revealed parks a greyed-out face on top of whatever the stage is saying about them.
            var isUp = person.Id == Game.CurrentPersonId && Game.Phase == BeePhase.Spelling;
            var isOut = SpellingBeeService.IsOut(Trip, person.Id);
            var isBack = Game.JustRevived.Contains(person.Id);

            <div class="bee-seat @(isUp ? "is-up" : null) @(isOut ? "is-out" : null) @(isBack ? "is-revived" : null)"
                 style="--team:@ColourOf(person); --i:@i" @key="person.Id">
                <BeeFace Person="person" Color="@ColourOf(person)" />
                <span class="bee-seat-name">@person.Name</span>
            </div>
        }
    </div>

    <section class="bee-stage">
        @if (Game.Phase == BeePhase.Revealed && Game.LastCorrect)
        {
            @* The only moment the spelling is ever visible, which is why the game waits here
               instead of snapping straight to the next speller. *@
            <p class="bee-eyebrow is-good">@Name(Game.CurrentPersonId) got it</p>
            <p class="bee-word">@(CurrentWord?.Word ?? "—")</p>
            <p class="bee-sub">+@Trip.SpellingBee.PointsPerWord for @TeamNameOf(Person(Game.CurrentPersonId))</p>
        }
        else if (Game.Phase == BeePhase.Revealed && Game.JustEliminatedPersonId is not null)
        {
            @* Two beats, in this order: what happened, then the drink. The shot o'clock used to
               open the screen, which meant the word and the name landed underneath a glass
               already sliding across them. Now it waits until the room has read both. *@
            <div class="bee-out" @key="Game.JustEliminatedPersonId">
                <p class="bee-eyebrow is-bad">@Name(Game.CurrentPersonId) is out</p>
                <p class="bee-word is-missed">@(CurrentWord?.Word ?? "—")</p>

                <div class="bee-shot">
                    <div class="bee-shot-bar">
                        <span class="bee-shot-pour"></span>
                        <span class="bee-shot-glass">
                            <span class="bee-shot-fill"></span>
                        </span>
                        <span class="bee-shot-splash"></span>
                    </div>
                    <p class="bee-shot-shout">IT'S SHOT O'CLOCK</p>
                </div>
            </div>
        }
        else if (Game.Phase == BeePhase.Revealed)
        {
            @* A miss where nobody went out. Branching on the two fields rather than on
               LastCorrect is what keeps the shot glass off this screen — running it here would
               be a lie, because the person who missed is still standing. *@
            <div class="bee-revival" @key="RevivedNames">
                <p class="bee-revival-flash">THE FIELD IS BACK</p>
                <p class="bee-revival-why">
                    @Name(Game.CurrentPersonId) missed it — and the last one standing has to earn
                    it, so every other team gets somebody back.
                </p>

                <div class="bee-revival-faces">
                    @foreach (var person in RevivedPeople)
                    {
                        <div class="bee-revival-person" style="--team:@ColourOf(person); --i:@(RevivedPeople.ToList().IndexOf(person))" @key="person.Id">
                            <BeeFace Person="person" Color="@ColourOf(person)" />
                            <span class="bee-seat-name">@person.Name</span>
                        </div>
                    }
                </div>

                <p class="bee-word is-missed">@(CurrentWord?.Word ?? "—")</p>
            </div>
        }
        else if (Speller is not null)
        {
            @* Deliberately empty. The face pulled into the middle is the whole message, and the
               card in the corner says whose it is. *@
            @if (CurrentWord is null)
            {
                <p class="warnfg">No word came back — check the host's phone.</p>
            }
        }
        else
        {
            <p class="bee-eyebrow">Waiting</p>
        }
    </section>

    @* Whose turn it is, parked in the bottom corner — the top left is where the row's own faces
       are, and a card there covers the first two seats. *@
    @if (Speller is { } up)
    {
        <div class="bee-turn" style="--team:@ColourOf(up)">
            <span class="bee-turn-team">@TeamNameOf(up)</span>
            <span class="bee-turn-name">@up.Name</span>
        </div>
    }

    <footer class="bee-scores">
        @foreach (var (team, score) in SpellingBeeService.Scoreboard(Trip))
        {
            <div class="bee-score" style="--team:@team.Color">
                <span class="bee-score-name">@team.Name</span>
                <b class="bee-score-value">@score</b>
                <span class="bee-score-left">@LeftOn(team.Id) in</span>
            </div>
        }

        @if (CanHost)
        {
            <button class="btn btn-ghost btn-xs bee-reset" @onclick="ConfirmReset">Reset</button>
        }
    </footer>
}

</div>

<TestPhones Game="spelling" Landing="/bee" Seats="@Joinable.Count"
            Door="@((t, r) => SpellingBeeService.SeatNextPlayer(t, r))">
    <Chips>
        @* The host's screen is the one you want full size beside the wall, not three hundred
           pixels wide in a rail — so it is a real second tab rather than a frame. *@
        <a class="chip" href="/bee" target="_blank" rel="noopener">📱 Host phone ↗</a>

        @* Filling the room from the laptop, which is not the same job as adding a phone: this is
           how you test a field of a particular size without signing twenty-four sessions in. The
           one name left out is whoever is running it, because they are holding a phone. *@
        <button class="chip chip-do" @onclick="EveryoneButMeAsync">⚡ Everyone but me</button>
        <button class="chip" @onclick="EmptyLobbyAsync">Empty the lobby</button>

        @if (NotYetIn.Count > 0)
        {
            <select class="sim-select" @onchange="SeatOneAsync">
                <option value="">bring one person in…</option>
                @foreach (var person in NotYetIn)
                {
                    <option value="@person.Id">@person.Name</option>
                }
            </select>
        }
    </Chips>
</TestPhones>

</AdminOnly>

<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>
    /// All, not SpellingBee. Every correct word writes a ScoreEntry, which lives in
    /// TripArea.Scores — so a page watching only its own area would render the game correctly
    /// and miss every point it scored. Jeopardy widens for the same reason.
    /// </summary>
    protected override TripArea Watching => TripArea.All;

    private ConfirmDialog? _confirm;
    private IJSObjectReference? _audio;
    private bool _muted;

    // What the last render was looking at, so a change can be turned into a sound. The wall is
    // never told anything — it derives its cues by noticing that the shared state moved.
    private BeePhase _lastPhase = BeePhase.NotStarted;
    private string? _lastSpellerId;
    private int _lastJoinedCount;

    private BeeGame Game => Trip.SpellingBee.Game;
    private bool Started => Game.Phase != BeePhase.NotStarted;

    private BeeWord? CurrentWord => SpellingBeeService.CurrentWord(Trip);
    private RosterPerson? Speller => SpellingBeeService.Speller(Trip);
    private RosterPerson? Winner => SpellingBeeService.Winner(Trip);
    private Team? WinningTeam => SpellingBeeService.WinningTeam(Trip);
    private IReadOnlyList<RosterPerson> Field => SpellingBeeService.Field(Trip);

    /// <summary>
    /// Who has joined, in the order they did. Tapping your name is the whole of joining, so this
    /// is the arrival list and the lobby renders nothing else.
    /// </summary>
    private IReadOnlyList<RosterPerson> JoinedPeople => SpellingBeeService.ReadyPeople(Trip);

    private IReadOnlyList<RosterPerson> RevivedPeople =>
        Game.JustRevived.Select(Person).Where(p => p is not null).Select(p => p!).ToList();

    private IReadOnlyList<string> Rules => SpellingBeeService.Rules(Trip);
    /// <summary>
    /// Phase-guarded as well as range-guarded: the slideshow belongs to the lobby, and a stale
    /// slide index left on a running game would put the rules over the top of the bee.
    /// </summary>
    private bool ShowingRules =>
        Game.Phase == BeePhase.NotStarted && Game.RuleSlide >= 0 && Game.RuleSlide < Rules.Count;
    private string CurrentRule => ShowingRules ? Rules[Game.RuleSlide] : "";

    private string JoinHost => new Uri(Nav.BaseUri).Authority;
    /// <summary>The door, for a camera. Every code on this trip is handed to /join.</summary>
    private string JoinUrl(string code) => Nav.ToAbsoluteUri($"/join/{code}").ToString();

    // ----------------------------------------------------------------- setup

    private bool _setupOpen;
    private bool _restoredSetup;

    /// <summary>
    /// Whether the word-and-rules drawer is open, remembered in this browser.
    ///
    /// Its own key rather than the testing panel's, because it is not a testing control: it is the
    /// host editing what the room is about to be asked. It should not fold away with the rail, and
    /// it should not come back as a default every time somebody navigates away and back.
    /// </summary>
    private const string SetupKey = "bee.wall.setup";

    private string StartingDifficulty => Trip.SpellingBee.DifficultyKey;

    private Task SetDifficultyAsync(string tierKey) =>
        MutateAsync(t => SpellingBeeService.SetStartingDifficulty(t, tierKey));

    private async Task ToggleSetupAsync()
    {
        _setupOpen = !_setupOpen;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SetupKey, _setupOpen ? "1" : "0");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task RestoreSetupAsync()
    {
        if (_restoredSetup) return;
        _restoredSetup = true;

        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", SetupKey) == "1")
            {
                _setupOpen = true;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private Task SetPointsAsync(string? raw) =>
        MutateAsync(t => t.SpellingBee.PointsPerWord = Clamp(raw, 0, 100, t.SpellingBee.PointsPerWord));

    /// <summary>A number input still hands you whatever was typed, so nothing is trusted.</summary>
    private static int Clamp(string? raw, int min, int max, int fallback) =>
        int.TryParse(raw, out var value) ? Math.Clamp(value, min, max) : fallback;

    // ----------------------------------------------------------------- rules

    /// <summary>
    /// The rules are on the game, beside its name and its blurb, which is where /games reads them
    /// from too. Editing them here rather than in a second place keeps one copy of the text the
    /// host is about to read out.
    /// </summary>
    private Task SetRuleAsync(int index, string? text) => EditRules(rules =>
    {
        var trimmed = (text ?? "").Trim();

        // An emptied box is a deletion. Leaving a blank bullet on the wall for the host to walk
        // the room through is worse than taking them at their word.
        if (trimmed.Length == 0) rules.RemoveAt(index);
        else rules[index] = trimmed;
    });

    private Task AddRuleAsync() => EditRules(rules => rules.Add("A new rule."));

    private Task RemoveRuleAsync(int index) => EditRules(rules => rules.RemoveAt(index));

    private Task MoveRuleAsync(int index, int by) => EditRules(rules =>
    {
        var to = index + by;
        if (to < 0 || to >= rules.Count) return;

        (rules[index], rules[to]) = (rules[to], rules[index]);
    });

    private Task EditRules(Action<List<string>> edit) => MutateAsync(t =>
    {
        if (t.Games.FirstOrDefault(g => g.Id == SpellingBeeService.GameId) is not { } game) return;

        edit(game.Rules);

        // The slideshow may have been pointing at a rule that just moved or stopped existing.
        if (t.SpellingBee.Game.RuleSlide >= game.Rules.Count) t.SpellingBee.Game.RuleSlide = -1;
    });

    // ---------------------------------------------------------------- testing

    private IReadOnlyList<RosterPerson> Joinable => SpellingBeeService.Joinable(Trip);

    private IReadOnlyList<RosterPerson> NotYetIn => SpellingBeeService.NotYetIn(Trip);

    /// <summary>
    /// Put the room in the row, except whoever is running it.
    ///
    /// "Me" is the person this laptop is signed in as. When it is signed in as the committee
    /// rather than as anybody in particular there is nobody to leave out, and everybody joins —
    /// which is the right answer, because then nobody is holding a phone.
    /// </summary>
    private Task EveryoneButMeAsync() =>
        MutateAsync(t => SpellingBeeService.SeatEverybody(t, Permissions.PersonId));

    private Task EmptyLobbyAsync() => MutateAsync(t =>
    {
        foreach (var person in SpellingBeeService.Joinable(t))
            SpellingBeeService.SetReady(t, person.Id, false);
    });

    private Task SeatOneAsync(ChangeEventArgs e) =>
        e.Value?.ToString() is { Length: > 0 } id
            ? MutateAsync(t => SpellingBeeService.SetReady(t, id, true))
            : Task.CompletedTask;

    private RosterPerson? Person(string? id) => SpellingBeeService.Person(Trip, id);
    private string Name(string? id) => Person(id)?.Name ?? "—";

    private string RevivedNames => string.Join(", ", Game.JustRevived.Select(Name));

    private Team? TeamOf(RosterPerson? person) =>
        person is null ? null : Trip.Teams.FirstOrDefault(t => t.Id == person.TeamId);

    private string TeamNameOf(RosterPerson? person) => TeamOf(person)?.Name ?? "";
    private string ColourOf(RosterPerson? person) => TeamOf(person)?.Color ?? "#d4af37";

    private int LeftOn(string teamId) =>
        SpellingBeeService.Survivors(Trip).Count(p => p.TeamId == teamId);

    /// <summary>
    /// Mint the codes if there are none, so the join screen works the moment the page opens.
    /// Deliberately not a Reset — loading a page must never clear the scores.
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();

        _lastPhase = Game.Phase;
        _lastSpellerId = Game.CurrentPersonId;
        _lastJoinedCount = JoinedPeople.Count;

        if (SpellingBeeService.EnsureCodes(Trip, Random.Shared))
        {
            _ = MutateAsync(t => SpellingBeeService.EnsureCodes(t, Random.Shared));
        }
    }

    // ------------------------------------------------------------------ cues

    /// <summary>
    /// Sound is decided here rather than in the handlers because the thing that changes the game
    /// is usually the host's phone, not this screen. Comparing what is on the wall now against
    /// what was on it last render is what lets the wall react to a tap that happened somewhere
    /// else entirely.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var phase = Game.Phase;
        var spellerId = Game.CurrentPersonId;
        var joined = JoinedPeople.Count;

        // Written before the cue is started, not after. The cue is fire-and-forget precisely
        // because a blocked AudioContext can hang rather than fail, and bookkeeping left behind
        // such a hang would leave the wall permanently comparing against a stale render.
        var wasPhase = _lastPhase;
        var wasSpeller = _lastSpellerId;
        var wasJoined = _lastJoinedCount;

        _lastPhase = phase;
        _lastSpellerId = spellerId;
        _lastJoinedCount = joined;

        if (firstRender)
        {
            await RestoreSetupAsync();
            return;
        }

        // The bee just started somewhere else — on the host's phone, which is the only place it
        // can start from. That is the moment the wall stops being a web page, so it says so, and
        // GameModeScope deals with the chrome, the class and the browser's opinion about full
        // screen. Nothing here waits on any of it.
        if (wasPhase == BeePhase.NotStarted && phase != BeePhase.NotStarted) GameMode.Enter("spelling");

        if (phase == BeePhase.NotStarted && joined > wasJoined) Cue("joined");
        else if (phase == BeePhase.Finished && wasPhase != BeePhase.Finished) Cue("fanfare");
        else if (phase == BeePhase.Revealed && wasPhase != BeePhase.Revealed)
            Cue(Game.LastCorrect ? "correct" : Game.JustRevived.Count > 0 ? "revival" : "strike");
        else if (phase == BeePhase.Spelling && spellerId != wasSpeller) Cue("up");
    }

    /// <summary>
    /// One sound, started and never awaited.
    ///
    /// The module is imported on the first cue rather than up front, because a browser will not
    /// make noise until the page has been touched. On a wall nobody ever touches, that permission
    /// may simply never arrive — and an unlock that hangs rather than fails must not be sitting in
    /// the render path when it does.
    /// </summary>
    private void Cue(string name) => _ = CueAsync(name);

    private async Task CueAsync(string name)
    {
        try
        {
            _audio ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bee-audio.js");
            await _audio.InvokeVoidAsync("unlock");
            await _audio.InvokeVoidAsync(name);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* no audio on this device; the bee carries on regardless */ }
        catch (ObjectDisposedException) { /* the page went away mid-cue */ }
    }

    private async Task ToggleMuteAsync()
    {
        _muted = !_muted;

        try
        {
            _audio ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bee-audio.js");
            await _audio.InvokeVoidAsync("setMuted", _muted);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    // ------------------------------------------------------------------ flow

    private Task NewCodesAsync() => MutateAsync(t =>
    {
        t.SpellingBee.Game.GuestCode = "";
        SpellingBeeService.EnsureCodes(t, Random.Shared);
    });

    /// <summary>End the slideshow from the wall, for when the phone that started it is not here.</summary>
    private Task TakeRulesDownAsync() => MutateAsync(t => SpellingBeeService.ShowRule(t, -1));

    /// <summary>The only destructive action here, and the only one that asks first.</summary>
    private void ConfirmReset() =>
        _confirm?.Show("Reset the bee? Everyone comes back in and the spelling points leave the standings.",
            () => MutateAsync(t => SpellingBeeService.Reset(t, Random.Shared)), "Reset");

    public async ValueTask DisposeAsync()
    {
        if (_audio is not null)
        {
            try { await _audio.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _audio.DisposeAsync(); } catch (JSDisconnectedException) { }
        }

        Dispose();
    }
}
