@page "/teams"
@using CharterTrip.Core.Services
@inherits TripAwareComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject CharterTrip.Web.Services.ToastService Toasts

<PageTitle>Teams · Charter Trip 2026</PageTitle>

@* The games and the roster are the committee's working area, not part of what a
   guest came here for. AdminOnly guards the page itself, so typing the URL lands
   on the same polite refusal as following a link that is not in their menu. *@
<AdminOnly>
<div class="page">

    <SectionCard Title="Teams" Subtitle="@SubtitleText">
        <ChildContent>
            @if (Unassigned.Count > 0)
            {
                <div class="team-tray" data-team-id="">
                    <div class="tray-head">
                        <strong>Not on a team</strong>
                        <span class="muted tiny">drop someone here to take them off a team</span>
                    </div>
                    <div class="tray-people">
                        @foreach (var person in Unassigned)
                        {
                            <div class="person is-loose" @key="person.Id" data-person-id="@person.Id">
                                <span class="person-name">@person.Name</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="team-board">
                @foreach (var roster in Rosters)
                {
                    var team = roster.Team;

                    <section class="team-col @(_dropTarget == team.Id ? "is-drop" : null) @(_pickerFor == team.Id ? "is-picking" : null)"
                             @key="team.Id"
                             data-team-id="@team.Id"
                             style="--team:@team.Color">

                        <header class="team-col-head">
                            <div class="team-title">
                                @* The dot was always the team's colour; now it is also the way to
                                   change it, because it is the only thing on the page already
                                   saying what the colour is. *@
                                @if (CanEdit)
                                {
                                    <div class="team-colour">
                                        <button type="button" class="team-dot is-pickable"
                                                title="Change the team colour"
                                                aria-label="@($"Change the colour of {team.Name}")"
                                                aria-expanded="@(_pickerFor == team.Id)"
                                                @onclick="() => TogglePicker(team.Id)"></button>

                                        @if (_pickerFor == team.Id)
                                        {
                                            <div class="swatch-grid" role="group"
                                                 aria-label="@($"Pick a colour for {team.Name}")">
                                                @foreach (var swatch in AccentPalette.Swatches)
                                                {
                                                    var pick = swatch;
                                                    var taken = TakenBy(pick, team.Id);

                                                    <button type="button"
                                                            class="swatch @(IsWearing(team, pick) ? "is-on" : null) @(taken is not null ? "is-taken" : null)"
                                                            style="--swatch:@pick"
                                                            title="@(taken is not null ? $"Also {taken}" : pick)"
                                                            aria-label="@(taken is not null ? $"{pick} — also {taken}" : pick)"
                                                            @onclick="() => RecolorAsync(team.Id, pick)"></button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="team-dot" aria-hidden="true"></span>
                                }

                                <h3>
                                    <EditableText Value="@team.Name" ReadOnly="@(!CanEdit)"
                                                  ValueChanged="@(v => RenameAsync(team.Id, v))"
                                                  Placeholder="Team name" />
                                </h3>
                            </div>
                        </header>

                        <div class="team-people">
                            @foreach (var person in roster.Members)
                            {
                                <div class="person @(TeamService.IsLead(team, person) ? "is-lead" : null)"
                                     @key="person.Id"
                                     data-person-id="@person.Id"
                                     data-locked="@(TeamService.IsLead(team, person) ? "true" : null)">

                                    <span class="person-name">@person.Name</span>

                                    @if (TeamService.IsLead(team, person))
                                    {
                                        <span class="lead-tag" title="Team lead — fixed to this team">lead</span>
                                    }
                                </div>
                            }

                            @if (roster.Count == 0)
                            {
                                <p class="muted tiny empty-team">Nobody yet.</p>
                            }
                        </div>
                    </section>
                }
            </div>

            @* Sits under the open palette and over everything else, so the next click anywhere
               closes it rather than doing whatever it would otherwise have done. *@
            @if (_pickerFor is not null)
            {
                <div class="swatch-backdrop" @onclick="() => _pickerFor = null"></div>
            }
        </ChildContent>
    </SectionCard>
</div>
</AdminOnly>

@code {
    protected override TripArea Watching => TripArea.Teams;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Teams>? _self;
    private string? _dropTarget;

    private IReadOnlyList<TeamRoster> Rosters => TeamService.Rosters(Trip);
    private IReadOnlyList<RosterPerson> Unassigned => TeamService.Unassigned(Trip);

    private string SubtitleText => CanEdit
        ? "Drag a name onto another team. Click a team name to rename it, or its dot to recolour it."
        : "Who is on which team.";


    private Task RenameAsync(string teamId, string name) =>
        MutateAsync(t => TeamService.RenameTeam(t, teamId, name));


    // --------------------------------------------------------------- colour

    /// <summary>Which team's palette is open, if any. Only ever one at a time.</summary>
    private string? _pickerFor;

    private void TogglePicker(string teamId) =>
        _pickerFor = _pickerFor == teamId ? null : teamId;

    private Task RecolorAsync(string teamId, string color)
    {
        _pickerFor = null;
        return MutateAsync(t => TeamService.RecolorTeam(t, teamId, color));
    }

    /// <summary>
    /// Whether this is the colour the team is already wearing. Compared through the palette rather
    /// than as text so a team seeded with a differently-spelled hex still lights up its own swatch.
    /// </summary>
    private static bool IsWearing(Team team, string swatch) =>
        AccentPalette.MatchSwatch(team.Color) == swatch;

    /// <summary>
    /// The other team already wearing this colour, or null. Ten colours and four teams means
    /// picking one somebody else has is easy to do by accident and impossible to see afterwards,
    /// so the swatch says so instead of quietly allowing it.
    /// </summary>
    private string? TakenBy(string swatch, string exceptTeamId) =>
        Trip.Teams.FirstOrDefault(t => t.Id != exceptTeamId && IsWearing(t, swatch))?.Name;


    private async Task MoveAsync(string personId, string? teamId)
    {
        var person = TeamService.FindPerson(Trip, personId);
        if (person is null || person.TeamId == (teamId ?? "")) return;

        await MutateAsync(t => TeamService.MovePerson(t, personId, teamId));

        var where = string.IsNullOrWhiteSpace(teamId)
            ? "off a team"
            : $"to {TeamService.FindTeam(Trip, teamId!)?.Name}";
        Toasts.Show($"{person.Name} moved {where}", CharterTrip.Web.Services.ToastKind.Good);
    }

    // ------------------------------------------------------------------ drag

    [JSInvokable]
    public Task PersonDropped(string personId, string? teamId) => MoveAsync(personId, teamId);

    /// <summary>Highlights the column being hovered mid-drag.</summary>
    [JSInvokable]
    public Task DropTargetChanged(string? teamId)
    {
        _dropTarget = teamId;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !CanEdit) return;

        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/teams.js");
        await _module.InvokeVoidAsync("init", _self);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }

        _self?.Dispose();
        Dispose();
    }
}
