@* Pool Noodle Cups and Beer Run: after each round, say how many each team carried off.

   There is no heading here. The round already announces itself above in letters an inch high,
   and saying "Round 1" again immediately underneath it was the sort of thing you stop seeing
   after a day and never stop paying for on a phone.

   The cups in a round are a fixed pool — one player per team, one cup each — so the counters
   share it rather than each offering the full four. Claiming one takes it away from everybody
   else, which is what the round actually does. *@

@inject ITripStore Store

<div class="count-grid">
    @foreach (var team in Active)
    {
        var id = team.Id;
        var mine = Count(id);
        <div class="count-card @(mine > 0 ? "is-scoring" : null)" style="--team:@team.Color" @key="id">
            <span class="count-team">@team.Name</span>
            <div class="count-controls">
                <button type="button" class="btn btn-ghost count-step"
                        disabled="@(mine == 0)"
                        @onclick="() => Nudge(id, -1)">−</button>
                <span class="count-value">@mine</span>
                <button type="button" class="btn btn-ghost count-step"
                        disabled="@(Left == 0)"
                        @onclick="() => Nudge(id, 1)">+</button>
            </div>
            <span class="count-points">@(mine * State.PointValue) pts</span>
        </div>
    }
</div>

<div class="count-go">
    <button class="btn btn-gold btn-lg count-score @(Left == 0 ? "is-ready" : null)" @onclick="ScoreRoundAsync">
        @(Total > 0 ? "Score the round" : "Nobody scored — next round")
    </button>
    <p class="muted tiny">@Hint</p>
</div>

@code {
    [Parameter, EditorRequired] public TripData Trip { get; set; } = default!;
    [Parameter, EditorRequired] public RoundGame State { get; set; } = default!;
    [Parameter, EditorRequired] public string GameId { get; set; } = "";

    /// <summary>What is being counted, plural: "cups", "beers".</summary>
    [Parameter, EditorRequired] public string Unit { get; set; } = "";

    /// <summary>Reaches into the live trip to find this game's state, since the parameter is a snapshot.</summary>
    [Parameter, EditorRequired] public Func<TripData, RoundGame> Select { get; set; } = default!;

    /// <summary>What the round paid out, so the page can put it on screen before moving on.</summary>
    [Parameter] public EventCallback<IReadOnlyList<ScoreRow>> OnScored { get; set; }

    /// <summary>This round's tally, per team. Local until the round is scored.</summary>
    private readonly Dictionary<string, int> _counts = new(StringComparer.Ordinal);

    private IReadOnlyList<Team> Active => RoundGameService.ActiveTeams(Trip, State);

    /// <summary>
    /// How many there are to go round: one player from each team in the round, one each. Two
    /// teams in a sudden-death round means two, which is right for the same reason.
    /// </summary>
    private int Pool => Active.Count;

    private int Count(string teamId) => _counts.GetValueOrDefault(teamId);

    private int Total => Active.Sum(t => Count(t.Id));

    private int Left => Math.Max(0, Pool - Total);

    private string Hint => Left == 0
        ? $"All {Pool} {Unit} accounted for."
        : $"{Left} {(Left == 1 ? Unit.TrimEnd('s') : Unit)} left to place.";

    private void Nudge(string teamId, int by)
    {
        var next = Count(teamId) + by;
        if (next < 0) return;
        if (by > 0 && Left == 0) return;

        _counts[teamId] = next;
    }

    private async Task ScoreRoundAsync()
    {
        // Only the teams actually in play — a stale count left over from before a sudden death
        // must not quietly award points to somebody who is already out.
        var live = Active.Select(t => t.Id).ToHashSet(StringComparer.Ordinal);
        var counts = _counts.Where(kv => live.Contains(kv.Key)).ToDictionary(kv => kv.Key, kv => kv.Value);

        // Captured before the mutation: the round advances as it is scored, and the teams in play
        // can change with it if this was the round that sent two of them to sudden death.
        var scored = Active
            .Where(t => Count(t.Id) > 0)
            .Select(t => new ScoreRow(t, Count(t.Id) * State.PointValue))
            .ToList();

        var unit = Unit;
        var gameId = GameId;

        await Store.MutateAsync(
            t => RoundGameService.AwardRoundCounts(t, Select(t), gameId, counts, unit, DateTimeOffset.UtcNow),
            TripArea.Games);

        _counts.Clear();
        await OnScored.InvokeAsync(scored);
    }
}
