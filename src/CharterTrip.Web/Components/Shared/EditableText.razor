@* Click-to-edit text. Renders as plain text for anyone without edit rights, which is how the
   member view stays read-only without every page writing an @if around each field.

   It is also where two people editing at once is dealt with, because every editable string on
   the site comes through here. Writes are already serialised and every change is broadcast
   live, so the only thing that can be lost is an edit typed against a value that has since
   moved — see OnParametersSet and CommitAsync. Dropdowns need none of this: they commit on
   change, so there is no window to be stale in. *@

@inject CharterTrip.Web.Services.ToastService Toasts

@if (!CanEditThis)
{
    @* A read-only field can be a link — the address on Essentials opens a map. It is only ever
       the plain branch: the same click cannot both open a map and start editing the text. *@
    @if (Href is { Length: > 0 })
    {
        <a class="map-line @CssClass @EmptyClass" href="@Href" target="_blank" rel="noopener">@Display</a>
    }
    else
    {
        <span class="@CssClass @EmptyClass">@Display</span>
    }
}
else if (_editing)
{
    @if (Multiline)
    {
        <textarea @ref="_field"
                  draggable="false"
                  class="inline-edit @CssClass"
                  rows="@Rows"
                  value="@_draft"
                  @oninput="OnInput"
                  @onblur="CommitAsync"
                  @onkeydown="OnKeyDownAsync"
                  placeholder="@Placeholder"></textarea>
    }
    else
    {
        <input @ref="_field"
               draggable="false"
               class="inline-edit @CssClass"
               type="text"
               value="@_draft"
               @oninput="OnInput"
               @onblur="CommitAsync"
               @onkeydown="OnKeyDownAsync"
               placeholder="@Placeholder" />
    }
}
else
{
    <span class="editable @CssClass @EmptyClass"
          role="button"
          tabindex="0"
          title="Click to edit"
          @onclick="BeginEdit"
          @onkeydown="OnDisplayKeyDown">@Display</span>
}

@code {
    [CascadingParameter] private TripPermissions Permissions { get; set; } = new(false, "Guest");

    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "—";

    /// <summary>Opts this field out of the admin-only rule. See <see cref="CanEditThis"/>.</summary>
    [Parameter] public bool AnyoneCanEdit { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public int Rows { get; set; } = 2;

    /// <summary>Lets a caller force read-only even for an admin.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Makes the text itself a link, for a field nobody here can edit. Ignored the moment this
    /// viewer can edit it, because click-to-edit and following a link are the same gesture.
    /// </summary>
    [Parameter] public string? Href { get; set; }

    private bool _editing;
    private string _draft = string.Empty;
    private bool _focusWanted;
    private ElementReference _field;

    /// <summary>What this field said when the box was opened — the baseline a commit is judged against.</summary>
    private string _opened = string.Empty;

    /// <summary>Whether anything has actually been typed since the box opened.</summary>
    private bool _touched;

    /// <summary>
    /// Normally a field is editable only by an admin. <see cref="AnyoneCanEdit"/> is the exception
    /// for a field that belongs to whoever is reading it rather than to the committee — the travel
    /// table, where a guest fills in their own row. ReadOnly still wins over both.
    /// </summary>
    private bool CanEditThis => !ReadOnly && (AnyoneCanEdit || Permissions.CanEdit);
    private string Display => string.IsNullOrWhiteSpace(Value) ? Placeholder : Value;
    private string? EmptyClass => string.IsNullOrWhiteSpace(Value) ? "is-empty" : null;

    private void BeginEdit()
    {
        _draft = Value;
        _opened = Value;
        _touched = false;
        _editing = true;
        _focusWanted = true;
    }

    private void OnInput(ChangeEventArgs e)
    {
        _draft = e.Value?.ToString() ?? string.Empty;
        _touched = true;
    }

    /// <summary>
    /// Someone else changed this field while the box sat open. If nothing has been typed into
    /// it there is nothing to protect, so take their value rather than sitting on a stale one —
    /// otherwise clicking a field, being distracted, and clicking away would quietly put the old
    /// text back.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!_editing || _touched || Value == _opened) return;

        _draft = Value;
        _opened = Value;
    }

    private void OnDisplayKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") BeginEdit();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _editing = false;
            return;
        }

        // Shift+Enter inserts a newline in a multiline field; plain Enter always commits.
        if (e.Key == "Enter" && (!Multiline || !e.ShiftKey))
            await CommitAsync();
    }

    private async Task CommitAsync()
    {
        if (!_editing) return;

        var trimmed = _draft.Trim();

        // Somebody else wrote here while this box was open, and what was typed disagrees with
        // them. Writing would erase their answer with neither of them ever knowing, so the
        // first commit buys nothing but the news: what it now says, and that saying it again
        // will overwrite. What was typed is kept — losing it to a warning would be its own bug.
        if (EditConflict.Decide(_opened, Value, trimmed) == EditOutcome.Warn)
        {
            _opened = Value;      // the next commit is an informed one, so let it through
            _touched = true;      // and it is deliberate, so stop adopting from underneath it
            _focusWanted = true;  // put them back in the box they were told about
            Toasts.Show(
                $"Someone else set this to “{Shorten(Value)}” while you were typing. Save again to replace it.",
                CharterTrip.Web.Services.ToastKind.Bad);
            return;
        }

        _editing = false;
        if (EditConflict.Decide(_opened, Value, trimmed) == EditOutcome.Skip) return;

        await ValueChanged.InvokeAsync(trimmed);
    }

    /// <summary>A toast is gone in under three seconds; a paragraph in one is no use to anybody.</summary>
    private static string Shorten(string value) =>
        value.Length <= 40 ? value : value[..39].TrimEnd() + "…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusWanted) return;
        _focusWanted = false;
        try { await _field.FocusAsync(); } catch { /* element already gone */ }
    }
}
