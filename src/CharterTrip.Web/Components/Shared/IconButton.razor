@* A small square action button: the plus on an Essentials card, the plus and the expand on a
   planner day. They were three different controls that happened to sit in the same corner —
   a drawn plus in one place and a typed glyph in the others, at three sizes.

   The colour comes from the panel's accent by default, so a button in a section takes that
   section's colour without anyone passing anything. The icon is drawn rather than typed: a
   glyph at this size is thin and off-centre whatever the font, and the three of them never
   agreed on a baseline. *@

<button type="button"
        class="act-btn @(Tone is null ? null : $"is-{Tone}") @CssClass"
        style="@(Accent is null ? null : $"--accent:{Accent}")"
        title="@Title"
        aria-label="@(AriaLabel ?? Title)"
        disabled="@Disabled"
        @onclick="OnClick">
    <svg viewBox="0 0 20 20" width="100%" height="100%" aria-hidden="true"
         fill="none" stroke="currentColor" stroke-width="2.2"
         stroke-linecap="round" stroke-linejoin="round">
        @switch (Icon)
        {
            case IconButtonIcon.Plus:
                <path d="M10 4.4 V15.6 M4.4 10 H15.6" />
                break;

            case IconButtonIcon.Expand:
                @* Four corners pointing out. *@
                <path d="M4 7.6 V4 H7.6 M12.4 4 H16 V7.6 M16 12.4 V16 H12.4 M7.6 16 H4 V12.4" />
                break;

            case IconButtonIcon.Collapse:
                @* The same four corners, pointing in. *@
                <path d="M7.6 4 V7.6 H4 M16 7.6 H12.4 V4 M12.4 16 V12.4 H16 M4 12.4 H7.6 V16" />
                break;

            case IconButtonIcon.Close:
                <path d="M5.2 5.2 L14.8 14.8 M14.8 5.2 L5.2 14.8" />
                break;
        }
    </svg>
</button>

@code {
    [Parameter, EditorRequired] public IconButtonIcon Icon { get; set; }

    /// <summary>Shown on hover, and used as the accessible name unless one is given separately.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// An explicit colour, for a button that is not inside an accented panel. Left unset it
    /// takes --accent from whatever section it is in.
    /// </summary>
    [Parameter] public string? Accent { get; set; }

    /// <summary>"danger" for a destructive action. Anything else takes the accent.</summary>
    [Parameter] public string? Tone { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
