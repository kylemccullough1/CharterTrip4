@using CharterTrip.Core.Models

@* Somebody's face, or their initials if the camera was being difficult.

   The photo is never required. Twenty-five people uploading at once over venue wifi is the
   highest-load minute of the night, and it is also the minute the host is waiting to start — so a
   monogram is a first-class outcome here rather than a failure state. *@

@if (HasPhoto)
{
    <img class="ms-portrait" src="@Seat!.PhotoUrl" alt="@Character?.Name" loading="lazy" />
}
else
{
    <span class="ms-portrait ms-portrait-monogram" aria-hidden="true">@Initials</span>
}

@code {
    [Parameter] public MysteryCastMember? Seat { get; set; }
    [Parameter] public MysteryCharacter? Character { get; set; }

    private bool HasPhoto => Seat?.PhotoUrl is { Length: > 0 };

    private string Initials
    {
        get
        {
            var name = Character?.Name;
            if (string.IsNullOrWhiteSpace(name)) return "?";

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 1
                ? parts[0][..1].ToUpperInvariant()
                : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
        }
    }
}
