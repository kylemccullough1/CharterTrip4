@using CharterTrip.Core.Models
@using CharterTrip.Core.Mystery

@* One faction's phone, on the wall, during the briefing.

   A picture of the screens a player with this role will actually see — the Role tab as it will
   look when the power is live, and the clue-card page for the powers that are spent standing in
   front of a card — drawn with the same classes the phone draws them with, so what the room is
   shown is what the phone will show. Static: the buttons are the real buttons, wired to nothing.

   Built from the story rather than written by hand, so an ability renamed in the editor is
   renamed here too. *@

@if (Faction is { } faction)
{
    <div class="pf">
        <div class="pf-phone">
            <div class="pf-notch" aria-hidden="true"></div>

            <div class="mp pf-mp">
                <header class="mp-head">
                    <div class="mp-who">
                        <span class="ms-portrait ms-portrait-monogram" aria-hidden="true">?</span>
                        <div class="mp-who-text">
                            <h1 class="mp-name">You</h1>
                            <p class="mp-zone">@faction.Name</p>
                        </div>
                    </div>
                </header>

                <nav class="mp-tabs">
                    @foreach (var tab in new[] { "You", "Do", "Map", "Role", "Clues" })
                    {
                        <span class="mp-tab @(tab == (OnCards ? "Clues" : "Role") ? "on" : "")">@tab</span>
                    }
                </nav>

                <main class="mp-body">
                    @if (OnCards)
                    {
                        @* The clue-card page, as it looks after scanning a card with the power live. *@
                        <div class="mp-clue-page pf-clue">
                            <p class="mp-clue-zone">Kitchen · a clue card you've just scanned</p>

                            <section class="mp-card">
                                <h3 class="mp-card-title">You could work on this</h3>

                                @if (NeedsTarget)
                                {
                                    <label class="sc-field">
                                        <span class="tiny">Who does your story point at?</span>
                                        <span class="se-select pf-select">choose a guest…</span>
                                    </label>
                                }

                                <div class="mp-tamper-options">
                                    @foreach (var mode in CardAbility!.Modes)
                                    {
                                        <section class="mp-tamper-option" @key="mode.Id">
                                            <h4 class="mp-tamper-name">@mode.Name</h4>
                                            <p class="pf-blurb">@FirstSentence(mode.Text)</p>
                                            <p class="mp-tamper-preview">The card, as it would then read.</p>
                                            <span class="btn btn-sm btn-danger-ghost">@mode.Name this card</span>
                                        </section>
                                    }
                                </div>
                            </section>
                        </div>
                    }
                    else
                    {
                        @if (faction.Abilities.Count == 0)
                        {
                            <section class="mp-card mp-card-faction">
                                <h3 class="mp-card-title">@faction.Name</h3>
                                <p class="pf-blurb">@FirstSentence(faction.WinCondition)</p>
                            </section>
                            <p class="mp-note-quiet">No powers. Scan the cards, scan the people, star what matters, vote.</p>
                        }

                        @foreach (var ability in faction.Abilities)
                        {
                            <section class="mp-card mp-ability" @key="ability.Id">
                                <h3 class="mp-card-title">
                                    @ability.Name
                                    <span class="mp-charges">@ability.Charges left</span>
                                </h3>
                                <p class="pf-blurb">@FirstSentence(ability.Text)</p>

                                @if (ability.Target == "clue")
                                {
                                    <label class="sc-field">
                                        <span class="tiny">Which card</span>
                                        <span class="se-select pf-select">choose a card you've scanned…</span>
                                    </label>
                                }
                                else if (ability.Target != "none")
                                {
                                    <label class="sc-field">
                                        <span class="tiny">On whom</span>
                                        <span class="se-select pf-select">choose a guest…</span>
                                    </label>
                                }

                                <div class="row gap wrap">
                                    <span class="btn btn-gold btn-xs">Use it</span>
                                </div>
                            </section>
                        }
                    }
                </main>
            </div>
        </div>

        <p class="pf-caption">
            @if (OnCards)
            {
                <span>On the card itself — scan any clue card, and this is under it. From @Phase(CardAbility!.Unlock).</span>
            }
            else if (faction.Abilities.Count > 0)
            {
                @foreach (var ability in faction.Abilities)
                {
                    <span class="pf-when" @key="ability.Id"><b>@ability.Name</b> · Role tab · from @Phase(ability.Unlock)</span>
                }
            }
            else
            {
                <span>Your Role tab, from the study.</span>
            }
        </p>
    </div>
}

@code {
    [Parameter, EditorRequired] public TripData Trip { get; set; } = default!;
    [Parameter, EditorRequired] public string FactionId { get; set; } = "";

    private MysteryFaction? Faction => Trip.Mystery.Story.Faction(FactionId);

    /// <summary>The power spent by standing in front of a card, if this faction has one. Drawn on the card's page.</summary>
    private MysteryAbility? CardAbility =>
        Faction?.Abilities.FirstOrDefault(a => a.Modes.Any(m => m.Id is "subtle" or "blatant" or "plant" or "scrub"));

    private bool OnCards => CardAbility is not null;

    private bool NeedsTarget => CardAbility?.Modes.Any(m => m.Id is "plant" or "scrub") == true;

    /// <summary>Enough of the text to recognise it on the phone later; the bullets beside it say the rest.</summary>
    private static string FirstSentence(string? text)
    {
        var written = MysteryText.Written(text) ?? "";
        var end = written.IndexOf(". ", StringComparison.Ordinal);
        return end > 0 ? written[..(end + 1)] : written;
    }

    private static string Phase(MysteryPhase phase) => MysteryPhases.Label(phase).ToLowerInvariant() switch
    {
        "the study" => "the study",
        "investigation" => "the investigation",
        "deliberation" => "the deliberation after the first trial",
        var other => other
    };
}
