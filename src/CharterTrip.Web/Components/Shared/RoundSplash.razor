@* A round announcing itself.

   Keyed on what round it is, so every round is a fresh element and the animation runs again
   without anything having to schedule it or time it. *@

<div class="round-splash" @key="Key">
    <span class="round-splash-kicker">@Kicker</span>
    <span class="round-splash-sub">@Sub</span>
</div>

@code {
    [Parameter, EditorRequired] public RoundGame Game { get; set; } = default!;

    private string Key => KeyFor(Game);

    private string Kicker => $"Round {Game.Round}";

    private string Sub => $"of {Game.RoundCount}";

    /// <summary>
    /// What makes this round a different round from the last one. Shared with the pages, which
    /// use it to work out when a round is new enough to be worth a noise.
    /// </summary>
    public static string KeyFor(RoundGame game) => $"r-{game.Round}";
}
