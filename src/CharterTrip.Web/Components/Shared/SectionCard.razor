@* The standard section wrapper: deco rule, title, optional subtitle, optional action buttons. *@

<section id="@Id" class="section @CssClass">
    <div class="section-head">
        <div>
            <h2 class="section-title">
                @if (TitleContent is not null)
                {
                    @TitleContent
                }
                else
                {
                    @Title
                }
            </h2>

            @if (SubtitleContent is not null)
            {
                <p class="section-sub">@SubtitleContent</p>
            }
            else if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="section-sub">@Subtitle</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="row gap wrap">@Actions</div>
        }
    </div>
    <div class="section-body">@ChildContent</div>
</section>

@code {
    /// <summary>Extra classes on the section itself, for callers that need to size or place it.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>An id, when something needs to link straight to this card — see #packing.</summary>
    [Parameter] public string? Id { get; set; }

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>
    /// A title that is more than a string — an editable one, in practice. Wins over
    /// <see cref="Title"/>; the same for <see cref="SubtitleContent"/> over <see cref="Subtitle"/>.
    /// </summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? SubtitleContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
