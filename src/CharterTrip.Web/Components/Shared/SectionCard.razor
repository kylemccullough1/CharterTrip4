@* The standard section wrapper: deco rule, title, optional subtitle, optional action buttons. *@

<section class="section @CssClass">
    <div class="section-head">
        <div>
            <h2 class="section-title">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="section-sub">@Subtitle</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="row gap wrap">@Actions</div>
        }
    </div>
    <div class="section-body">@ChildContent</div>
</section>

@code {
    /// <summary>Extra classes on the section itself, for callers that need to size or place it.</summary>
    [Parameter] public string? CssClass { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
