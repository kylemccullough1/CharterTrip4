@* One travel table.

   Extracted because there is no longer one table: grouping by carpool or by departure city
   produces a card per group plus one for whoever is unattached, and every one of them needs the
   same sortable header, the same colour picker and the same dropdowns. Rendering that markup
   once and passing the group in is the only way those stay identical.

   All state lives in the parent: the sort direction per table, and the open palette, which is
   shared across all of them because two palettes open at once would be nonsense. *@

@* A carpool card carries its colour; a departure-city card has none. Setting --car to
   "transparent" for those was the bug — the title reads `var(--car, var(--text))`, and a
   variable that is defined-but-transparent never reaches its fallback, so the heading was
   painted in nothing. Leave --car unset and let the fallbacks do their job. *@
<div class="tt-card @(Compact ? "is-compact" : null) @(Color is null ? "is-plain" : null) @(ShowDepart ? null : "no-depart")"
     style="@(Color is null ? null : $"--car:{Color}")">

    @if (Title is not null)
    {
        <header class="tt-head">
            <span class="tt-swatch" aria-hidden="true"></span>

            @if (Car is not null)
            {
                @* A carpool names itself and says when it moves. All three are open to
                   everyone: the people in the car are the ones who know, and routing that
                   through the committee is how it ends up never being written down. *@
                <span class="tt-title">
                    <EditableText Value="@Car.Name" AnyoneCanEdit="true"
                                  ValueChanged="@(v => EditCar(c => c.Name = v))"
                                  Placeholder="@Title" />
                </span>
                <div class="tt-car-eta">
                    <span class="tt-car-eta-label">ETA</span>

                    @* Which day, then what time. Not every car arrives on the same day, and a
                       clock time alone cannot say which one it means. *@
                    <select class="tt-select tt-eta-day" value="@Car.EtaDay"
                            aria-label="Day of arrival"
                            @onchange="e => EditCar(c => c.EtaDay = e.Value?.ToString() ?? string.Empty)">
                        <option value="">—</option>
                        @* A day already on the car that is no longer offered — the trip moved —
                           keeps its own option rather than being silently dropped. *@
                        @if (Car.EtaDay is { Length: > 0 } day && !EtaDays.Contains(day))
                        {
                            <option value="@day">@day</option>
                        }
                        @foreach (var name in EtaDays)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>

                    @* The same control the people in this car use for their own departure, so
                       one row of the card is not a dropdown and the next a text box. Arriving
                       "Anytime" is not an answer, which is the one option it drops. *@
                    <TimePicker Value="@Car.Eta" AllowAnytime="false" Label="Estimated arrival"
                                ValueChanged="@(v => EditCar(c => c.Eta = v))" />
                </div>
            }
            else
            {
                <span class="tt-title">@Title</span>
            }
        </header>
    }

    <div class="tt-scroll">
        <table class="table tt-table">
            @* Fixed layout. Left to size itself the origin column claimed 171px purely because
               "Somewhere else…" is its longest option — while "Can depart" was squeezed into 110px.
               The widths are shares of the card, so the same table works in a narrow group card
               and the full-width one. *@
            <colgroup>
                <col class="tt-c-who" />
                <col class="tt-c-from" />
                @if (ShowDepart)
                {
                    <col class="tt-c-when" />
                }
                <col class="tt-c-diet" />
                <col class="tt-c-notes" />
            </colgroup>
            <thead>
            <tr>
                <th class="tt-sort" role="button" tabindex="0"
                    aria-sort="@(Ascending ? "ascending" : "descending")"
                    title="Sort by name"
                    @onclick="OnToggleSort"
                    @onkeydown="SortKey">
                    Who
                    <span class="tt-arrow" aria-hidden="true">
                        <svg viewBox="0 0 10 6" width="9" height="6">
                            <path d="@(Ascending ? "M1 5 L5 1 L9 5" : "M1 1 L5 5 L9 1")"
                                  fill="none" stroke="currentColor" stroke-width="1.6"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </th>
                <th>Leaving from</th>
                @if (ShowDepart)
                {
                    <th>Can depart</th>
                }
                <th>Dietary</th>
                @* Sorting out carpools asks what you are putting in the car; everywhere else
                   asks for a note. Two questions, two fields — see TravelRow.Bringing. *@
                <th>@(AsksBringing ? "Bringing?" : "Notes")</th>
            </tr>
            </thead>

            <tbody>
            @foreach (var person in People)
            {
                var row = RowFor(person.Id);

                <tr @key="person.Id" style="--car:@ColorOf(row.CarColor)"
                    class="@(row.CarColor == 0 ? null : "has-car")">

                    <td class="travel-who">
                        <div class="car-pick">
                            <button type="button"
                                    class="car-dot @(row.CarColor == 0 ? "is-empty" : null)"
                                    data-car-anchor="@person.Id"
                                    disabled="@(!CanEdit)"
                                    aria-label="@($"Carpool for {person.Name}")"
                                    title="Carpool colour"
                                    @onclick="() => OnTogglePicker.InvokeAsync(person.Id)"></button>
                            @* Anyone may fix a name. It is the roster's name, not this table's,
                               so it changes everywhere the person appears — see OnRename. *@
                            <EditableText Value="@person.Name" AnyoneCanEdit="true"
                                          ValueChanged="@(v => OnRename.InvokeAsync((person.Id, v)))"
                                          Placeholder="@person.Name" />
                        </div>
                    </td>

                    <td>
                        @if (CanEdit)
                        {
                            @* "Somewhere else" is a mode, not an answer. Picking it turns this cell
                               into a text box in the same place the dropdown was — type the city
                               over the placeholder and it saves. The parent then knows about that
                               city, so it comes back as an ordinary option next time. *@
                            @if (IsTypingCity(row, person.Id))
                            {
                                <div class="tt-city-wrap">
                                    <input class="tt-select tt-city" placeholder="Somewhere else…"
                                           value="@row.LeavingFrom"
                                           @onchange="e => CityTypedAsync(person.Id, e.Value?.ToString())" />

                                    @* The way out. "Somewhere else" is a mode, and the only exit
                                       used to be the box reporting a change — which an empty box
                                       nobody typed in never does, so picking it by mistake took
                                       the dropdown away for good. Offered only for the mode; a
                                       row already holding a city that is not on the list has
                                       nothing to go back to. *@
                                    @if (CustomOrigins.Contains(person.Id))
                                    {
                                        <button type="button" class="tt-city-back"
                                                title="Back to the list"
                                                aria-label="@($"Back to the list of cities for {person.Name}")"
                                                @onclick="() => CityAbandoned(person.Id)">✕</button>
                                    }
                                </div>
                            }
                            else
                            {
                                @* The options are keyed by the city they name. Without that,
                                   adding a city rewrites this list in place — every option after
                                   the new one takes the next city's text — while the browser
                                   holds its selected INDEX. The select then quietly displayed
                                   somebody else's city: one person typing "Ada" moved everybody
                                   on Dallas to Ada on screen, while the file still said Dallas.
                                   Keyed, the new option is inserted and the rest keep both their
                                   identity and their selection. *@
                                <select class="tt-select" value="@row.LeavingFrom"
                                        @onchange="e => OriginPicked(person.Id, e.Value?.ToString())">
                                    <option value="" @key="@("origin-none")">—</option>
                                    @foreach (var city in Origins)
                                    {
                                        <option value="@city" @key="city">@city</option>
                                    }
                                    <option value="@OtherOption" @key="@("origin-other")">Somewhere else…</option>
                                </select>
                            }
                        }
                        else
                        {
                            <span>@Display(row.LeavingFrom)</span>
                        }
                    </td>

                    @if (ShowDepart)
                    {
                        <td>
                            @if (CanEdit)
                            {
                                <TimePicker Value="@row.DepartAt"
                                            Label="@($"When {person.Name} can depart")"
                                            ValueChanged="@(v => OnEdit(person.Id, r => r.DepartAt = v))" />
                            }
                            else
                            {
                                <span>@Display(row.DepartAt)</span>
                            }
                        </td>
                    }

                    <td>
                        @* The one thing a guest may write on this site: their own row. *@
                        <EditableText Value="@row.Dietary" ReadOnly="@(!CanEdit)" AnyoneCanEdit="@CanEdit"
                                      ValueChanged="@(v => OnEdit(person.Id, r => r.Dietary = v))"
                                      Placeholder="—" />
                    </td>

                    <td>
                        @if (AsksBringing)
                        {
                            <EditableText Value="@row.Bringing" ReadOnly="@(!CanEdit)" AnyoneCanEdit="@CanEdit"
                                          ValueChanged="@(v => OnEdit(person.Id, r => r.Bringing = v))"
                                          Placeholder="—" />
                        }
                        else
                        {
                            <EditableText Value="@row.Notes" ReadOnly="@(!CanEdit)" AnyoneCanEdit="@CanEdit"
                                          ValueChanged="@(v => OnEdit(person.Id, r => r.Notes = v))"
                                          Placeholder="—" />
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    /// <summary>Sentinel for the "somewhere else" choice, which is a mode rather than a city.</summary>
    public const string OtherOption = "__other";

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Color { get; set; }

    /// <summary>
    /// The carpool this card is, when it is one. Null for a card grouped by departure city,
    /// which has no name of its own and nothing to leave at a time.
    /// </summary>
    [Parameter] public Car? Car { get; set; }

    /// <summary>How to write to <see cref="Car"/>. Required whenever a car is given.</summary>
    [Parameter] public Func<Action<Car>, Task>? OnCarEdit { get; set; }

    /// <summary>
    /// The days a car could arrive on, named. Passed in rather than worked out here, because
    /// they come from the trip's own dates and this component does not know the trip.
    /// </summary>
    [Parameter] public IReadOnlyList<string> EtaDays { get; set; } = [];

    /// <summary>
    /// Whether the last column asks what this person is bringing rather than for a note.
    ///
    /// It follows the view rather than the card: when the page is sorting carpools out, that is
    /// the question every table on it is asking, including the one holding whoever has no car
    /// yet — they are as likely to be carrying the cooler as anybody else. Grouped by departure
    /// city the page is not about cars at all, so the column goes back to being a note.
    /// </summary>
    [Parameter] public bool AsksBringing { get; set; }

    /// <summary>Whether this card is a carpool, as opposed to a city or the unplaced.</summary>
    private bool IsCar => Car is not null;

    /// <summary>
    /// Whether the "Can depart" column is drawn. A car's own table does not draw it: once the
    /// car is a unit with an arrival time of its own, five separate departure times inside it
    /// are noise. Every other table keeps the column, and it is only ever hidden — nothing here
    /// writes to <see cref="TravelRow.DepartAt"/>, so what somebody answered before joining a
    /// car is still theirs, still saved, and back on screen the moment they leave one.
    /// </summary>
    private bool ShowDepart => !IsCar;

    /// <summary>Narrower styling for the side-by-side group cards.</summary>
    [Parameter] public bool Compact { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<RosterPerson> People { get; set; } = [];
    [Parameter, EditorRequired] public Func<string, TravelRow> RowFor { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, Action<TravelRow>, Task> OnEdit { get; set; } = default!;
    [Parameter, EditorRequired] public Func<int, string> ColorOf { get; set; } = default!;

    /// <summary>Known departure cities, already alphabetised by the caller.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Origins { get; set; } = [];

    /// <summary>People who chose "somewhere else" but have not typed a city yet.</summary>
    [Parameter, EditorRequired] public HashSet<string> CustomOrigins { get; set; } = [];

    /// <summary>
    /// A city somebody typed. The parent writes it to the row, and that is all the registering
    /// there is: everyone else's dropdown is built from the cities the rows name.
    /// </summary>
    [Parameter, EditorRequired] public Func<string, string, Task> OnCityAdded { get; set; } = default!;

    /// <summary>
    /// A person renamed: their id and what they should be called. The roster is the one place
    /// a name lives, so the caller writes it there and every page showing that person follows.
    /// </summary>
    [Parameter] public EventCallback<(string PersonId, string Name)> OnRename { get; set; }

    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool Ascending { get; set; } = true;
    [Parameter] public EventCallback OnToggleSort { get; set; }
    [Parameter] public EventCallback<string> OnTogglePicker { get; set; }


    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private Task EditCar(Action<Car> apply) => OnCarEdit?.Invoke(apply) ?? Task.CompletedTask;

    private Task SortKey(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? OnToggleSort.InvokeAsync() : Task.CompletedTask;

    // ---------------------------------------------------------------- origin

    /// <summary>
    /// Whether this cell is a text box rather than a dropdown.
    ///
    /// Two ways in: they just picked "Somewhere else" and have nothing typed yet, or their row
    /// already holds a city nobody has registered — old data, or a city added and then removed
    /// from the drive-times list.
    /// </summary>
    private bool IsTypingCity(TravelRow row, string personId)
    {
        if (CustomOrigins.Contains(personId)) return true;

        var city = row.LeavingFrom.Trim();
        return city.Length > 0 && !Origins.Contains(city, StringComparer.OrdinalIgnoreCase);
    }

    private async Task OriginPicked(string personId, string? choice)
    {
        if (choice == OtherOption)
        {
            // Remember the mode, because with nothing typed yet there is nothing on the row to
            // tell the next render that this cell should still be a text box.
            CustomOrigins.Add(personId);
            await OnEdit(personId, r => r.LeavingFrom = "");
            return;
        }

        CustomOrigins.Remove(personId);
        await OnEdit(personId, r => r.LeavingFrom = choice ?? "");
    }

    /// <summary>
    /// Gave up on typing a city. Nothing was named, so there is nothing to keep — drop the mode
    /// and the cell goes back to being the dropdown it was.
    /// </summary>
    private void CityAbandoned(string personId) => CustomOrigins.Remove(personId);

    /// <summary>
    /// A typed city. Writing it is the parent's job — that alone puts it into everyone else's
    /// dropdown — and emptying the box is one of the two ways back to that dropdown, the ✕
    /// beside it being the other.
    /// </summary>
    private async Task CityTypedAsync(string personId, string? typed)
    {
        var city = (typed ?? "").Trim();
        CustomOrigins.Remove(personId);

        if (city.Length == 0)
        {
            await OnEdit(personId, r => r.LeavingFrom = "");
            return;
        }

        await OnCityAdded(personId, city);
    }
}
